#!/usr/bin/env bash
#
# setup.sh — интерактивная настройка/харденинг сервера (меню по блокам).
#
# Группировка пунктов — по совместимости в одном проходе:
#
# Запуск:  sudo ./setup.sh   (можно вводить несколько номеров: напр. 1 2)
#
set -o pipefail
 
# Откуда брать свежую версию (raw-ссылка на GitHub). Можно переопределить через env.
UPDATE_URL="${UPDATE_URL:-https://raw.githubusercontent.com/Aleshinson/nodeforge/main/setup}"
# Целевая версия nginx для апгрейда (1.30.1 закрывает CVE из 1.28; 1.30.2 — ещё свежее).
NGINX_TARGET="${NGINX_TARGET:-1.30.1}"
# Ветка/тег репозитория node-accelerator (для прода можно зафиксировать тег: NA_REF=v2.1).
NA_REF="${NA_REF:-main}"
# Путь к самому скрипту (для самообновления).
SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
 
# ----------------------------- ЦВЕТА И ВЫВОД -----------------------------
# Цвета автоматически отключаются, если вывод не в терминал или задан NO_COLOR.
setup_colors() {
  if [ -n "${NO_COLOR:-}" ] || [ ! -t 1 ]; then
    BOLD="" DIM="" RST="" RED="" GRN="" YLW="" BLU="" MAG="" CYN="" GRY="" WHT=""
    return
  fi
  BOLD=$'\033[1m'; DIM=$'\033[2m'; RST=$'\033[0m'
  RED=$'\033[38;5;203m'; GRN=$'\033[38;5;78m';  YLW=$'\033[38;5;221m'
  BLU=$'\033[38;5;75m';  MAG=$'\033[38;5;176m'; CYN=$'\033[38;5;81m'
  GRY=$'\033[38;5;245m'; WHT=$'\033[38;5;231m'
}
setup_colors
 
log()  { printf '%s%s•%s %s\n'  "$BOLD" "$GRN" "$RST" "$*"; }
info() { printf '%s%si%s %s\n'  "$BOLD" "$BLU" "$RST" "$*"; }
ok()   { printf '%s%s✓%s %s\n'  "$BOLD" "$GRN" "$RST" "$*"; }
warn() { printf '%s%s▲%s %s\n'  "$BOLD" "$YLW" "$RST" "$*" >&2; }
err()  { printf '%s%s✗%s %s\n'  "$BOLD" "$RED" "$RST" "$*" >&2; }
step() { printf '%s%s▶ %s%s\n'  "$BOLD" "$CYN" "$*" "$RST"; }
hr()   { printf '%s──────────────────────────────────────────────────────────────%s\n' "$GRY" "$RST"; }
 
require_root() {
  if [ "$(id -u)" -ne 0 ]; then
    err "Запустите через sudo или от root."
    exit 1
  fi
}
 
# ----------------------------- ВВОД И ВАЛИДАЦИЯ -----------------------------
is_uint() { [[ "$1" =~ ^[0-9]+$ ]]; }
 
# ask VAR "Текст" "значение_по_умолчанию"
ask() {
  local __var="$1" __prompt="$2" __def="${3:-}" __ans
  if [ -n "$__def" ]; then
    read -rp "${__prompt} [${__def}]: " __ans
    __ans="${__ans:-$__def}"
  else
    read -rp "${__prompt}: " __ans
  fi
  printf -v "$__var" '%s' "$__ans"
}
 
# ask_required VAR "Текст" — не пускает дальше при пустом вводе
ask_required() {
  local __var="$1" __prompt="$2" __ans=""
  while [ -z "$__ans" ]; do
    read -rp "${__prompt}: " __ans
    if [ -z "$__ans" ]; then warn "Значение не может быть пустым."; fi
  done
  printf -v "$__var" '%s' "$__ans"
}
 
# ask_port VAR — обязательный ввод порта (1-65535), без значения по умолчанию
ask_port() {
  local __var="$1" __ans
  while true; do
    read -rp "SSH-порт (1-65535): " __ans
    if is_uint "$__ans" && [ "$__ans" -ge 1 ] && [ "$__ans" -le 65535 ]; then break; fi
    warn "Введите число от 1 до 65535."
  done
  printf -v "$__var" '%s' "$__ans"
}
 
# ask_username VAR
ask_username() {
  local __var="$1" __ans
  while true; do
    read -rp "Имя нового пользователя: " __ans
    if [[ "$__ans" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; then break; fi
    warn "Некорректное имя (строчные буквы/цифры/_/- , начинается с буквы или _)."
  done
  printf -v "$__var" '%s' "$__ans"
}
 
# Минимальная длина пароля пользователя (можно переопределить через env).
PASS_MIN_LEN="${PASS_MIN_LEN:-10}"

# is_weak_password "пароль" -> 0, если пароль слабый (короче лимита или из блоклиста).
# У создаваемого пользователя NOPASSWD-sudo, поэтому слабый пароль недопустим.
is_weak_password() {
  local p="$1" lc
  if [ "${#p}" -lt "$PASS_MIN_LEN" ]; then return 0; fi
  lc="${p,,}"
  case "$lc" in
    password*|passw0rd*|qwerty*|qwerty123*|123456*|12345678*|123456789*|1234567890*|\
    111111*|000000*|admin*|admin123*|root*|toor*|letmein*|welcome*|iloveyou*|\
    changeme*|secret*|superman*|monkey*|dragon*|master*|abc123*|football*)
      return 0 ;;
  esac
  return 1
}

# ask_password VAR — скрытый ввод, дважды, с проверкой длины/блоклиста и совпадения
ask_password() {
  local __var="$1" __p1 __p2
  while true; do
    read -rsp "Пароль для пользователя (ввод скрыт, минимум ${PASS_MIN_LEN} символов): " __p1; echo
    if [ -z "$__p1" ]; then warn "Пароль не может быть пустым."; continue; fi
    if is_weak_password "$__p1"; then
      warn "Слабый пароль (короче ${PASS_MIN_LEN} символов или из списка типовых). У пользователя будет NOPASSWD-sudo — задайте стойкий пароль."
      continue
    fi
    read -rsp "Повторите пароль: " __p2; echo
    if [ "$__p1" != "$__p2" ]; then warn "Пароли не совпадают, попробуйте снова."; continue; fi
    break
  done
  printf -v "$__var" '%s' "$__p1"
}
 
# confirm "Вопрос" -> 0, если да
confirm() {
  local __ans
  read -rp "$1 [y/N]: " __ans
  [[ "$__ans" =~ ^[YyДд] ]]
}
 
# valid_pubkey "строка" -> 0, если похоже на публичный SSH-ключ
valid_pubkey() {
  [[ "$1" =~ ^(ssh-rsa|ssh-ed25519|ecdsa-sha2-[a-z0-9-]+|sk-ssh-ed25519@openssh\.com|sk-ecdsa-sha2-[a-z0-9-]+@openssh\.com)[[:space:]]+ ]]
}
 
# choose_from_list VAR "Заголовок" "значение_по_умолчанию_или_пусто" пункт1 пункт2 ...
# Печатает нумерованное меню, помечает рекомендуемый пункт, читает выбор.
choose_from_list() {
  local __var="$1" __title="$2" __def="$3"; shift 3
  local __items=("$@") __i __sel __defidx=""
  echo "$__title"
  for __i in "${!__items[@]}"; do
    if [ -n "$__def" ] && [ "${__items[$__i]}" = "$__def" ]; then
      printf "  %d) %s   ← рекомендуется\n" "$((__i + 1))" "${__items[$__i]}"
      __defidx="$((__i + 1))"
    else
      printf "  %d) %s\n" "$((__i + 1))" "${__items[$__i]}"
    fi
  done
  local __prompt="Номер"
  if [ -n "$__defidx" ]; then __prompt="Номер [${__defidx}]"; fi
  while true; do
    read -rp "${__prompt}: " __sel
    if [ -z "$__sel" ] && [ -n "$__defidx" ]; then __sel="$__defidx"; fi
    if is_uint "$__sel" && [ "$__sel" -ge 1 ] && [ "$__sel" -le "${#__items[@]}" ]; then break; fi
    warn "Введите число от 1 до ${#__items[@]}."
  done
  printf -v "$__var" '%s' "${__items[$((__sel - 1))]}"
}
 
# ----------------------------- ОБЩИЕ ХЕЛПЕРЫ -----------------------------
ssh_service() {
  if systemctl list-unit-files 2>/dev/null | grep -q '^ssh\.service'; then echo ssh
  elif systemctl list-unit-files 2>/dev/null | grep -q '^sshd\.service'; then echo sshd
  else echo ssh; fi
}
 
# set_sshd_option Key Value — задаёт/раскомментирует директиву в sshd_config
set_sshd_option() {
  local key="$1" val="$2" file="/etc/ssh/sshd_config"
  if grep -qiE "^[[:space:]]*#?[[:space:]]*${key}\b" "$file"; then
    sed -i -E "s|^[[:space:]]*#?[[:space:]]*${key}\b.*|${key} ${val}|I" "$file"
  else
    printf '%s %s\n' "$key" "$val" >> "$file"
  fi
}
 
# Нейтрализуем конфликтующие настройки в /etc/ssh/sshd_config.d/*.conf
disable_conflicting_dropins() {
  shopt -s nullglob
  local f
  for f in /etc/ssh/sshd_config.d/*.conf; do
    sed -i -E 's@^[[:space:]]*(Port|PermitRootLogin|PasswordAuthentication|PubkeyAuthentication)([[:space:]].*)$@# disabled by setup: &@I' "$f"
  done
  shopt -u nullglob
}
 
apply_sshd() {
  if sshd -t; then
    systemctl restart "$(ssh_service)"
    log "SSH перезапущен."
  else
    err "sshd -t нашёл ошибку — SSH НЕ перезапущен. Проверьте /etc/ssh/sshd_config."
    return 1
  fi
}
 
# Определяем активный порт SSH из эффективного конфига
detect_ssh_port() {
  local p
  p="$(sshd -T 2>/dev/null | awk '/^port /{print $2; exit}' || true)"
  if [ -z "$p" ]; then
    p="$(grep -rhiE '^[[:space:]]*Port[[:space:]]+[0-9]+' \
          /etc/ssh/sshd_config /etc/ssh/sshd_config.d/ 2>/dev/null \
          | awk '{print $2; exit}' || true)"
  fi
  echo "${p:-22}"
}
 
# Глобально велим apt ЖДАТЬ блокировку dpkg (до 5 мин), а не падать.
# Действует и на наши apt-команды, и на сторонние установщики (netbird и т.п.).
ensure_apt_lock_timeout() {
  mkdir -p /etc/apt/apt.conf.d
  echo 'DPkg::Lock::Timeout "300";' > /etc/apt/apt.conf.d/99-setup-lock-timeout
}
 
# Ждём, пока фоновые apt/unattended-upgrades отпустят блокировку.
wait_for_apt() {
  local waited=0
  while fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1 \
        || fuser /var/lib/dpkg/lock          >/dev/null 2>&1 \
        || fuser /var/lib/apt/lists/lock     >/dev/null 2>&1 \
        || fuser /var/cache/apt/archives/lock >/dev/null 2>&1; do
    if [ "$waited" -eq 0 ]; then
      log "Жду освобождения apt/dpkg (идёт фоновое обновление unattended-upgrades)..."
    fi
    sleep 5
    waited=$((waited + 5))
    if [ "$waited" -ge 300 ]; then
      warn "Блокировка держится более 5 минут. При желании можно остановить автообновление:"
      warn "  systemctl stop unattended-upgrades   — и повторить пункт."
      return 0
    fi
  done
  if [ "$waited" -gt 0 ]; then log "Блокировка освобождена."; fi
  return 0
}
 
# Проверяем, что нода remnanode запущена и есть её docker-compose.
require_node() {
  if [ -f /opt/remnanode/docker-compose.yml ]; then
    NODE_DIR="/opt/remnanode"
    NODE_CONTAINER="remnanode"
    NODE_SERVICE="remnanode"
  elif [ -f /opt/remnawave/docker-compose.yml ]; then
    NODE_DIR="/opt/remnawave"
    NODE_CONTAINER="remnawave"
    NODE_SERVICE="remnawave"
  else
    err "Не найден docker-compose.yml ни в /opt/remnanode, ни в /opt/remnawave."
    return 1
  fi

  return 0
}
 
# compose_add_volume "host:container" — добавляет том именно в сервис remnanode
# (и убирает этот же том из других сервисов, если он туда попал ошибочно). С бэкапом.
compose_add_volume() {
  require_node || return 1

  local mapping="$1"
  local f="${NODE_DIR}/docker-compose.yml"
  local tmp
  local rc=0

  tmp="$(mktemp)"

  awk -v map="$mapping" -v service="$NODE_SERVICE" '
    BEGIN{
      in_service=0
      in_vol=0
      has=0
      inserted=0
    }

    $0 ~ ("^  " service ":[[:space:]]*$") {
      in_service=1
    }

    in_service && /^[^ ]/ {
      if (!inserted && !has) print "      - " map
      in_service=0
      in_vol=0
      inserted=1
    }

    in_service && /^    volumes:[[:space:]]*$/ {
      in_vol=1
    }

    in_service && in_vol && $0=="      - " map {
      has=1
    }

    in_service && in_vol && /^    [^ ]/ && !/^    volumes:/ {
      if (!has) print "      - " map
      inserted=1
      in_vol=0
    }

    { print }

    END{
      if (in_service && in_vol && !has)
        print "      - " map
    }
  ' "$f" >"$tmp" || rc=$?

  if [ $rc -ne 0 ]; then
    rm -f "$tmp"
    return $rc
  fi

  mv "$tmp" "$f"
}
 
# compose_set_env "KEY" "VALUE" — ставит `- KEY=VALUE` в environment: сервиса ноды:
# существующую строку заменяет, отсутствующую дописывает; без блока environment:
# (нода на env_file) создаёт его в конце сервиса. В файл ложится только то, что
# прошло `docker compose config`; оригинал остаётся в docker-compose.yml.bak.
compose_set_env() {
  require_node || return 1
  local key="$1" value="$2" f="${NODE_DIR}/docker-compose.yml" tmp rc=0
  case "$key" in
    ''|*[!A-Za-z0-9_]*) err "Некорректное имя переменной: ${key}"; return 1 ;;
  esac
  tmp="$(mktemp)"
  awk -v key="$key" -v value="$value" -v service="$NODE_SERVICE" '
    function flush_hold() { printf "%s", hold; hold = "" }
    function emit()       { print "      - " key "=" value; done = 1 }
    function close_env()  { if (in_env && !done) emit(); in_env = 0 }
    function close_service() {
      close_env()
      if (in_service && !have_env) { print "    environment:"; emit() }
      flush_hold(); in_service = 0
    }
    /^[^ ]/ { top = $0 }
    top ~ /^services:/ && $0 ~ ("^  " service ":[[:space:]]*$") { print; in_service = 1; seen = 1; next }
    # Пустые строки и комментарии придерживаем: дописанная переменная встанет к своим.
    in_service && /^[[:space:]]*(#|$)/ { hold = hold $0 "\n"; next }
    in_service && $0 !~ /^   / { close_service() }
    in_service && /^    environment:/ {
      if ($0 !~ /^    environment:[[:space:]]*$/) { bad = 1; exit 3 }
      flush_hold(); print; in_env = 1; have_env = 1; next
    }
    in_env && /^    [^ ]/ { close_env() }
    in_env && $0 ~ ("^      - \"?" key "=") { flush_hold(); if (!done) emit(); next }
    in_service { flush_hold() }
    { print }
    END { if (bad) exit 3; close_service(); if (!seen) exit 4 }
  ' "$f" >"$tmp" || rc=$?
  case "$rc" in
    0) ;;
    3) rm -f "$tmp"; err "В ${f} блок environment: сервиса ${NODE_SERVICE} записан в одну строку — правь вручную."; return 1 ;;
    4) rm -f "$tmp"; err "В ${f} не найден сервис '${NODE_SERVICE}:' под services:."; return 1 ;;
    *) rm -f "$tmp"; err "Не удалось обработать ${f} (awk вернул ${rc})."; return "$rc" ;;
  esac
  if ! docker compose --project-directory "$NODE_DIR" -f "$tmp" config -q; then
    rm -f "$tmp"
    err "После правки compose не проходит 'docker compose config' — файл не тронут."
    return 1
  fi
  cp -a "$f" "${f}.bak"
  cat "$tmp" >"$f"
  rm -f "$tmp"
}
 
# ============================ БЛОКИ ============================
 
# ----- 1) SSH-харденинг: порт + пользователь + sudo + ключи + запрет root -----
block_ssh() {
  local port user pass keyinput pubkey
  ask_port port
  ask_username user
  ask_password pass
 
  echo
  echo "Публичный SSH-ключ (содержимое id_rsa.pub):"
  echo "  • вставьте строку ключа, ИЛИ"
  echo "  • укажите путь к .pub файлу, ИЛИ"
  echo "  • нажмите Enter — тогда парольный вход НЕ отключается."
  read -rp "Ключ/путь: " keyinput
  pubkey=""
  if [ -n "$keyinput" ]; then
    if [ -f "$keyinput" ]; then pubkey="$(cat "$keyinput")"; else pubkey="$keyinput"; fi
    if ! valid_pubkey "$pubkey"; then
      warn "Это не похоже на публичный SSH-ключ (ожидается ssh-ed25519 / ssh-rsa / ...)."
      if confirm "Всё равно использовать это значение?"; then :; else
        pubkey=""; warn "Ключ отброшен — парольный вход останется включённым."
      fi
    fi
  fi
 
  # --- сводка перед применением (пароль НЕ печатается) ---
  echo
  echo "Будет применено:"
  echo "  • SSH-порт:          ${port}"
  echo "  • Пользователь:      ${user}  (sudo NOPASSWD)"
  echo "  • Вход root по SSH:  запрещён"
  if [ -n "$pubkey" ]; then
    echo "  • SSH-ключ:          установлен"
    echo "  • Парольный вход:    будет ОТКЛЮЧЁН"
  else
    echo "  • SSH-ключ:          не задан"
    echo "  • Парольный вход:    останется включённым"
    warn "БЕЗ КЛЮЧА: парольный вход по SSH остаётся ВКЛ, а у ${user} — беспарольный sudo (NOPASSWD)."
    warn "Слабый пароль = прямой путь к root. Настоятельно рекомендую задать SSH-ключ."
  fi
  confirm "Продолжить?" || { warn "Отменено."; return 1; }
 
  # порт
  log "Ставлю SSH-порт ${port}."
  set_sshd_option Port "$port"
  # ЕДИНЫЙ ФАЕРВОЛ: ufw НЕ трогаем. Пишем порт в реестр; na_filter переприменяется
  # в конце, когда sshd уже слушает новый порт (иначе вход на него не проверить).
  fw_set SSH_PORT "$port"
  fw_neutralize_ufw

  # пользователь + sudo
  log "Создаю/настраиваю пользователя ${user}."
  apt-get update -y
  apt-get install -y sudo
  id "$user" >/dev/null 2>&1 || adduser --disabled-password --gecos "" "$user"
  echo "${user}:${pass}" | chpasswd
  usermod -aG sudo "$user"
  printf '%s ALL=(ALL) NOPASSWD: ALL\n' "$user" > "/etc/sudoers.d/90-${user}"
  chmod 440 "/etc/sudoers.d/90-${user}"
  visudo -cf "/etc/sudoers.d/90-${user}" >/dev/null
 
  # запрет root
  set_sshd_option PermitRootLogin no
 
  # ключи
  set_sshd_option PubkeyAuthentication yes
  if [ -n "$pubkey" ]; then
    install -d -m 700 -o "$user" -g "$user" "/home/${user}/.ssh"
    printf '%s\n' "$pubkey" > "/home/${user}/.ssh/authorized_keys"
    chmod 600 "/home/${user}/.ssh/authorized_keys"
    chown "${user}:${user}" "/home/${user}/.ssh/authorized_keys"
    set_sshd_option PasswordAuthentication no
    log "Ключ установлен, парольный вход будет отключён."
  else
    warn "Ключ не задан — парольный вход оставлен включённым."
  fi
 
  disable_conflicting_dropins
  apply_sshd
  if command -v nft >/dev/null 2>&1 && nft list table inet na_filter >/dev/null 2>&1; then
    apply_firewall
  else
    warn "Фаервол ещё не поднят (na_filter нет). Новый порт ${port} сохранён в реестр и откроется в пункте 3 (protect)."
    warn "Сейчас активного фаервола нет — для свежего сервера это нормально, доступ открыт."
  fi
  echo
  warn "В НОВОМ окне проверьте вход (НЕ закрывая текущую сессию!):"
  warn "    ssh -p ${port} ${user}@<IP_СЕРВЕРА>"
}
 
# ----- 2) node-accelerator: optimize (XanMod BBRv3 + sysctl + RPS/RFS + swap) -----
# Единственный владелец ядра и тюнинга (раньше это были отдельные XanMod/BBR — удалены как дубли).
block_optimize() {
  local tmp
  info "node-accelerator: оптимизация — XanMod BBRv3 + sysctl + RPS/RFS/XPS + swap + лимиты."
  warn "Делает ядро XanMod (BBRv3) и весь сетевой тюнинг за один проход."
  warn "После установки XanMod потребуется reboot."
  echo
  tmp="$(mktemp)"
  if ! curl -fsSL "https://raw.githubusercontent.com/jestivald/node-accelerator/${NA_REF}/install.sh" -o "$tmp"; then
    err "Не удалось скачать node-accelerator (install.sh)."
    rm -f "$tmp"
    return 1
  fi
  NA_REF="$NA_REF" bash "$tmp" optimize || warn "optimize завершился с ненулевым кодом — см. вывод выше."
  rm -f "$tmp"
  echo
  warn "Если установился XanMod — выполни reboot, затем проверь: uname -r (должно содержать xanmod)."
  warn "Откатить тюнинг при необходимости: bash <(curl -fsSL .../node-accelerator/${NA_REF}/install.sh) rollback optimize"
}
 
# ----- 3) node-accelerator: protect (nftables na_filter + CrowdSec) -----
# Единственный владелец фаервола/анти-брутфорса (раньше это был fail2ban — удалён как дубль).
block_protect() {
  local node_port tcp_ports udp_ports whitelist ssh_port
  info "Защита: ЕДИНЫЙ фаервол nftables (na_filter) + CrowdSec + блоклисты. Один владелец — без ufw."
  warn "Запускай ПОСЛЕ поднятия ноды. В конце спрошу, работает ли вход в новом окне: без «да» фаервол через 5 мин удалится сам."
  echo
  fw_load
  ssh_port="$(detect_ssh_port 2>/dev/null || echo "${SSH_PORT:-22}")"
  log "SSH-порт: ${ssh_port}"
  ask node_port "Порт ноды (NODE_PORT)"                 "${NODE_PORT:-2222}"
  ask tcp_ports "Сервисные TCP-порты (через запятую)"   "${TCP_PORTS:-443}"
  ask udp_ports "Сервисные UDP-порты (через запятую)"   "${UDP_PORTS:-443}"
  _ask_panel_ips "$node_port" || { warn "Отменено."; return 1; }
  warn "ВАЖНО: впиши свой постоянный IP (домашний/VPN), чтобы лимиты тебя не банили. Панель добавится сама."
  ask whitelist "WHITELIST (IP/CIDR через запятую; пусто — ок)" "${WHITELIST:-}"
  if confirm "Включить статич-блоклисты (Spamhaus DROP + FireHOL L1) — режут сканеры/ботов?"; then
    fw_set ENABLE_BLOCKLISTS 1
  fi
  if confirm "Дополнительно блокировать выходные узлы Tor?"; then fw_set BLOCK_TOR 1; else fw_set BLOCK_TOR 0; fi
  fw_set SSH_PORT  "$ssh_port"
  fw_set NODE_PORT "$node_port"
  fw_set TCP_PORTS "$tcp_ports"
  fw_set UDP_PORTS "$udp_ports"
  fw_set WHITELIST "$whitelist"
  echo
  apply_firewall
}
 
# ----- netbird: обновление демона до последней версии -----
# netbird ставится из apt-репозитория (его добавляет официальный install.sh),
# поэтому штатное обновление — через apt. Если репозитория нет (ставили иначе) —
# предлагаем переустановку официальным установщиком (подтянет последнюю версию).
netbird_update() {
  command -v netbird >/dev/null 2>&1 || { err "netbird не установлен. Сначала установи его (пункт «netbird»)."; return 1; }

  local before after
  before="$(netbird version 2>/dev/null | head -1 || true)"
  info "Текущая версия netbird: ${before:-неизвестна}"

  if grep -rqi 'pkgs\.netbird\.io' /etc/apt/sources.list /etc/apt/sources.list.d/ 2>/dev/null; then
    log "Обновляю netbird через apt."
    wait_for_apt
    apt-get update -y
    apt-get install -y --only-upgrade netbird || { err "apt не смог обновить netbird."; return 1; }
  else
    warn "apt-репозиторий netbird не найден (демон ставили не через install.sh)."
    confirm "Переустановить официальным установщиком (подтянет последнюю версию)?" || { warn "Отменено."; return 1; }
    wait_for_apt
    if ! curl -fsSL https://pkgs.netbird.io/install.sh | sh; then
      err "Переустановка netbird не удалась."
      return 1
    fi
    hash -r 2>/dev/null || true
  fi

  # Применяем новый бинарь: перезапуск службы. Туннель на пару секунд рвётся и
  # переподключается сам по сохранённой конфигурации — setup-key не нужен.
  if systemctl list-unit-files 2>/dev/null | grep -q '^netbird\.service'; then
    log "Перезапускаю службу netbird."
    systemctl restart netbird 2>/dev/null || warn "Не удалось перезапустить — сделай вручную: systemctl restart netbird"
    sleep 1
  fi

  after="$(netbird version 2>/dev/null | head -1 || true)"
  if [ -n "$after" ] && [ "$before" = "$after" ]; then
    ok "netbird уже актуален (${after}). Изменений нет."
  else
    ok "netbird обновлён: ${before:-?} → ${after:-?}"
  fi
  netbird status 2>/dev/null | grep -iE 'NetBird IP|Management|Signal|FQDN' | sed 's/^/   /' || true
}

# ----- 6) netbird -----
block_netbird() {
  local key

  if command -v netbird >/dev/null 2>&1; then
    ok "netbird уже установлен ($(netbird version 2>/dev/null | head -1))."
    if confirm "Обновить netbird до последней версии?"; then
      netbird_update || warn "Обновление netbird завершилось с ошибкой — см. вывод выше."
    fi
  else
    log "netbird не найден — устанавливаю."
    wait_for_apt
    if ! curl -fsSL https://pkgs.netbird.io/install.sh | sh; then
      err "Установка netbird не удалась."
      return 1
    fi
    hash -r 2>/dev/null || true   # обновить кэш путей, чтобы команда netbird нашлась сразу
  fi

  if ! command -v netbird >/dev/null 2>&1; then
    err "Команда netbird всё ещё недоступна — проверь установку вручную."
    return 1
  fi

  # Уже подключён? Покажем и спросим про переподключение.
  if netbird status 2>/dev/null | grep -qiE 'Management:[[:space:]]*Connected|Connected to'; then
    info "netbird сейчас ПОДКЛЮЧЁН:"
    netbird status 2>/dev/null | grep -iE 'NetBird IP|Management|Signal|FQDN' | sed 's/^/   /' || true
    if ! confirm "Переподключить с новым setup-key?"; then
      ok "Оставляю текущее подключение без изменений."
      return 0
    fi
  fi

  echo "setup-key вводится здесь и в файле не хранится."
  ask key "netbird setup-key (Enter — подключить позже)" ""
  if [ -z "$key" ]; then
    warn "Ключ не задан. Позже подключишь командой: netbird up --setup-key <KEY>"
    return 0
  fi

  # Если уже в сети — корректно выходим перед повторным up (иначе netbird ругается).
  if netbird status 2>/dev/null | grep -qiE 'Management:[[:space:]]*Connected|Connected to'; then
    log "Отключаюсь перед переподключением (netbird down)."
    netbird down >/dev/null 2>&1 || true
    sleep 1
  fi

  if netbird up --setup-key "$key"; then
    ok "netbird подключён."
    netbird status 2>/dev/null | grep -iE 'NetBird IP|Management|FQDN' | sed 's/^/   /' || true
  else
    err "netbird up не удался. Проверь setup-key и статус: netbird status"
    return 1
  fi
}
 
# ----- 6) remnanode -----
block_remnanode() {
  log "Запускаю установщик remnanode (интерактивный — следуйте подсказкам)."
  wait_for_apt
  bash <(curl -fLs https://raw.githubusercontent.com/eGamesAPI/remnawave-reverse-proxy/refs/heads/main/install_remnawave.sh)

  # Установщик ноды делает `ufw --force enable` (открыты только 22+443) — это ВТОРОЙ
  # фаервол, который потом «съедает» твои порты. Гасим его и возвращаем единый na_filter.
  fw_neutralize_ufw
  if command -v nft >/dev/null 2>&1 && nft list table inet na_filter >/dev/null 2>&1; then
    log "Возвращаю полный набор портов в единый фаервол (na_filter)."
    apply_firewall
  else
    warn "ufw от установщика ноды выключен. Подними фаервол пунктом 3 (protect) — он откроет все порты разом."
  fi
 
  mkdir -p /var/log/remnanode
  if [ ! -f /opt/remnanode/docker-compose.yml ]; then
    warn "/opt/remnanode/docker-compose.yml не найден — пропускаю правку volumes."
    return
  fi
  compose_add_volume "/var/log/remnanode:/var/log/remnanode" || true
  if confirm "Перезапустить remnanode (docker compose down && up -d)?"; then
    ( cd /opt/remnanode && docker compose down && docker compose up -d )
  fi
}
 
# ----- 7) RU-блокировка (RU geoip/geosite + bind-mount + cron) -----
block_rublock() {
  require_node || return 1
 
  log "Готовлю папку ассетов и копирую штатные geoip/geosite из контейнера."
  mkdir -p /opt/remnanode/xray-assets
  docker cp remnanode:/usr/local/share/xray/. /opt/remnanode/xray-assets/
 
  log "Скачиваю RU-списки (runetfreedom)."
  wget -qO /opt/remnanode/xray-assets/geosite-ru.dat \
    https://github.com/runetfreedom/russia-v2ray-rules-dat/releases/latest/download/geosite.dat
  wget -qO /opt/remnanode/xray-assets/geoip-ru.dat \
    https://github.com/runetfreedom/russia-v2ray-rules-dat/releases/latest/download/geoip.dat
  if [ "$(stat -c%s /opt/remnanode/xray-assets/geosite-ru.dat 2>/dev/null || echo 0)" -lt 1000000 ] \
     || [ "$(stat -c%s /opt/remnanode/xray-assets/geoip-ru.dat 2>/dev/null || echo 0)" -lt 1000000 ]; then
    err "RU-списки скачались подозрительно маленькими — прерываю."
    return 1
  fi
  chmod 644 /opt/remnanode/xray-assets/*.dat
 
  log "Прописываю bind-mount ассетов в docker-compose."
  compose_add_volume "/opt/remnanode/xray-assets:/usr/local/share/xray"
 
  log "Пересоздаю контейнер."
  ( cd /opt/remnanode && docker compose up -d )
  sleep 3
  local cnt
  cnt="$(docker exec remnanode sh -c 'ls /usr/local/share/xray/*.dat 2>/dev/null | wc -l' 2>/dev/null || echo 0)"
  log "В контейнере .dat-файлов: ${cnt} (ожидаем 4)."
  if [ "${cnt:-0}" -lt 4 ]; then
    warn "Похоже, bind-mount не применился — проверь отступы в docker-compose.yml."
  fi
 
  log "Ставлю авто-обновление списков (cron, воскресенье 04:00)."
  cat > /opt/remnanode/update-geo.sh <<'EOS'
#!/bin/bash
set -e
ASSETS=/opt/remnanode/xray-assets
TMP=$(mktemp -d)
wget -q -O "$TMP/geosite-ru.dat" https://github.com/runetfreedom/russia-v2ray-rules-dat/releases/latest/download/geosite.dat
wget -q -O "$TMP/geoip-ru.dat"   https://github.com/runetfreedom/russia-v2ray-rules-dat/releases/latest/download/geoip.dat
[ "$(stat -c%s "$TMP/geosite-ru.dat")" -gt 1000000 ] || { echo "geosite-ru.dat suspiciously small"; exit 1; }
[ "$(stat -c%s "$TMP/geoip-ru.dat")"   -gt 1000000 ] || { echo "geoip-ru.dat suspiciously small"; exit 1; }
mv "$TMP/geosite-ru.dat" "$ASSETS/geosite-ru.dat"
mv "$TMP/geoip-ru.dat"   "$ASSETS/geoip-ru.dat"
chmod 644 "$ASSETS"/*.dat
rmdir "$TMP"
docker restart remnanode >/dev/null
echo "geo update done: $(date)"
EOS
  chmod +x /opt/remnanode/update-geo.sh
  if crontab -l 2>/dev/null | grep -qF '/opt/remnanode/update-geo.sh'; then
    log "Cron уже настроен."
  else
    ( crontab -l 2>/dev/null || true; echo '0 4 * * 0 /opt/remnanode/update-geo.sh >> /var/log/geo-update.log 2>&1' ) | crontab -
    log "Cron добавлен."
  fi
 
  echo
  warn "ОСТАЛОСЬ СДЕЛАТЬ В ПАНЕЛИ Remnawave (один раз на все ноды):"
  warn "Xray Config → заменить блоки outbounds и routing на это и сохранить:"
  cat <<'EOJSON'
 
"outbounds": [
  { "tag": "DIRECT",  "protocol": "freedom" },
  { "tag": "BLOCK",   "protocol": "blackhole" },
  { "tag": "TORRENT", "protocol": "blackhole" }
],
"routing": {
  "domainStrategy": "IPIfNonMatch",
  "rules": [
    { "type": "field", "protocol": ["bittorrent"], "outboundTag": "TORRENT" },
    { "type": "field",
      "domain": [
        "ext:geosite-ru.dat:category-ru",
        "ext:geosite-ru.dat:ru-available-only-inside",
        "ext:geosite-ru.dat:category-ads-all"
      ],
      "outboundTag": "BLOCK" },
    { "type": "field",
      "ip": [ "geoip:private", "ext:geoip-ru.dat:ru" ],
      "outboundTag": "BLOCK" }
  ]
}
EOJSON
}
 
# Забрать каталог $1 у чужих станз logrotate (кроме нашей $2). node-accelerator
# (пункт optimize) по умолчанию сам ротирует /var/log/remnanode в na-node-logs;
# две станзы на один файл = logrotate падает на каждом прогоне и одну пропускает.
# При повторном optimize na сам уступает маску, занятую чужой станзой.
_logrotate_release_dir() {
  local dir="$1" own="$2" f bak
  for f in /etc/logrotate.d/*; do
    [ -f "$f" ] && [ "$f" != "$own" ] || continue
    grep -qF "$dir" "$f" || continue
    bak="/root/logrotate.$(basename "$f").bak-$(date +%F-%H%M)"
    cp -a "$f" "$bak"
    sed -i -E "/\{/ s#[[:space:]]*${dir}[^[:space:]{]*##g" "$f"
    if grep -qE '^[[:space:]]*\{' "$f"; then
      rm -f "$f"
      log "Станза ${f} ротировала только ${dir} — убрал (бэкап: ${bak})."
    else
      log "Забрал ${dir} у ${f} (бэкап: ${bak})."
    fi
  done
}

# ----- 8) Логи ноды (logrotate + zstd) -----
block_logs() {
  local lr_errs keep
  require_node || return 1

  log "Гарантирую папку логов и том логов в compose."
  mkdir -p /var/log/remnanode

  compose_add_volume "/var/log/remnanode:/var/log/remnanode" || true

  (
    cd "$NODE_DIR"
    docker compose up -d
  )

  log "Ставлю logrotate + zstd."
  wait_for_apt
  apt-get install -y logrotate zstd

  log "Пишу /etc/logrotate.d/remnanode."
  _logrotate_release_dir /var/log/remnanode/ /etc/logrotate.d/remnanode
  # Срок хранения, заданный раньше (например, аудитом), не сбрасываем.
  # compressoptions — без кавычек: logrotate передаёт их в zstd буквально,
  # и тот отвечает «Incorrect parameters» — сжатие падает, несжатые логи копятся.
  keep="$(awk '$1 == "rotate" {print $2; exit}' /etc/logrotate.d/remnanode 2>/dev/null || true)"

  cat >/etc/logrotate.d/remnanode <<EOF
  /var/log/remnanode/*.log {
    daily
    rotate ${keep:-9999}
    compress
    compresscmd /usr/bin/zstd
    compressoptions -19 --quiet
    compressext .zst
    uncompresscmd /usr/bin/unzstd
    missingok
    notifempty
    copytruncate
    dateext
    dateformat -%Y-%m-%d
  }
EOF

  # Проверяем весь конфиг, а не один файл: дубль станз виден только целиком.
  lr_errs="$(logrotate -d /etc/logrotate.conf 2>&1 | grep -E '^error' || true)"
  if [ -z "$lr_errs" ]; then
    log "logrotate без ошибок."
    systemctl reset-failed logrotate.service na-logrotate.service 2>/dev/null || true
  else
    warn "logrotate сообщает об ошибках:"
    printf '%s\n' "$lr_errs" | sed 's/^/   /' >&2
  fi

  echo
  warn "ОСТАЛОСЬ В ПАНЕЛИ:"
  warn "Добавь пути:"
  warn "  /var/log/remnanode/access.log"
  warn "  /var/log/remnanode/error.log"
  warn ""
  warn "Проверить можно так:"
  warn "  docker exec ${NODE_CONTAINER} ls -la /var/log/remnanode/"
}
 
# Печатает файл $2 без блока location /$1/ { ... } (в т.ч. с кривыми отступами).
_nginx_strip_location() {
  awk -v path="$1" '
    function cnt(s, ch,   n,i){ n=0; for(i=1;i<=length(s);i++) if(substr(s,i,1)==ch) n++; return n }
    {
      if (skip==0 && index($0,"location /" path "/")>0 && index($0,"{")>0) { skip=1; depth=cnt($0,"{")-cnt($0,"}"); if(depth<=0) skip=0; next }
      if (skip==1) { depth += cnt($0,"{")-cnt($0,"}"); if(depth<=0) skip=0; next }
      print
    }' "$2"
}

# Имя nginx-контейнера ноды (приоритет — remnawave-nginx).
_nginx_container() {
  local ngx
  ngx="$(docker ps --format '{{.Names}}' 2>/dev/null | grep -iE 'remnawave.*nginx|nginx.*remnawave' | head -n1 || true)"
  if [ -z "$ngx" ]; then
    ngx="$(docker ps --format '{{.Names}}' 2>/dev/null | grep -i nginx | head -n1 || true)"
  fi
  printf '%s' "$ngx"
}

# ----- 9) location в nginx ноды (общий upsert для XHTTP/gRPC) -----
# Удаляет старый location /<path>/ и вставляет свежий блок в первый
# server { } (валидация nginx -t + рестарт nginx/remnanode, откат при ошибке).
nginx_upsert_location() {
  local path="$1" block="$2"
  local f=/opt/remnanode/nginx.conf ngx tmp existed=0 rc=0
 
  if [ ! -f "$f" ]; then
    warn "${f} не найден. Вставь этот блок в server { } нужного nginx.conf вручную:"
    printf '%s\n' "$block"
    return 1
  fi
 
  if grep -qF "location /${path}/" "$f"; then existed=1; fi
  cp -a "$f" "${f}.bak"
  tmp="$(mktemp)"
 
  # 1) удалить существующий блок location /path/ { ... }
  _nginx_strip_location "$path" "${f}.bak" > "$tmp"
 
  # 2) вставить свежий блок в первый server { } (перед его закрывающей скобкой)
  awk -v ins="$block" '
    function cnt(s, ch,   n,i){ n=0; for(i=1;i<=length(s);i++) if(substr(s,i,1)==ch) n++; return n }
    { buf[NR]=$0 }
    END {
      start=0
      for (i=1;i<=NR;i++) if (buf[i] ~ /server[[:space:]]*\{/) { start=i; break }
      end=0
      if (start>0){ d=0; for (i=start;i<=NR;i++){ d += cnt(buf[i],"{")-cnt(buf[i],"}"); if (d<=0){ end=i; break } } }
      for (i=1;i<=NR;i++){ if (end>0 && i==end) print ins; print buf[i] }
      if (end==0) exit 3
    }' "$tmp" > "$f" || rc=$?
  rm -f "$tmp"
 
  if [ "$rc" -ne 0 ]; then
    err "Не нашёл server-блок в ${f} — откатываю. Вставь блок вручную:"
    cp -a "${f}.bak" "$f"
    printf '%s\n' "$block"
    return 1
  fi
  if [ "$existed" -eq 1 ]; then
    log "Пересобрал location /${path}/ с правильными отступами (бэкап: ${f}.bak)."
  else
    log "Вставил location /${path}/ (бэкап: ${f}.bak)."
  fi
 
  ngx="$(_nginx_container)"
  if [ -z "$ngx" ]; then
    warn "Не нашёл nginx-контейнер. Проверь конфиг и перезапусти nginx вручную."
    return 1
  fi
 
  log "Проверяю конфиг в контейнере ${ngx}."
  if docker exec "$ngx" nginx -t; then
    docker restart "$ngx" >/dev/null
    docker restart remnanode >/dev/null
    log "nginx (${ngx}) и remnanode перезапущены."
  else
    err "nginx -t не прошёл — откатываю ${f}."
    if [ -f "${f}.bak" ]; then cp -a "${f}.bak" "$f"; fi
    return 1
  fi
}
 
# ----- 9a) XHTTP (location в nginx ноды) -----
block_xhttp() {
  local path block
  while true; do
    ask path "XHTTP-путь (без слешей)" "xhttppath"
    if [[ "$path" =~ ^[A-Za-z0-9_-]+$ ]]; then break; fi
    warn "Путь может содержать только латиницу, цифры, дефис и подчёркивание (без слешей, пробелов и спецсимволов)."
  done
 
  # Свежий блок с правильными отступами (пустая строка + location на 4 пробелах,
  # тело на 12, закрывающая скобка на 8 — как в рабочем конфиге).
  block=$(cat <<EOB
 
    location /${path}/ {
            client_max_body_size 0;
            grpc_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
            client_body_timeout 5m;
            grpc_read_timeout 315;
            grpc_send_timeout 5m;
            grpc_pass unix:/dev/shm/xrxh.socket;
        }
EOB
)
  nginx_upsert_location "$path" "$block"
}
 
# ----- 9b) gRPC (location в nginx ноды) -----
block_grpc() {
  local path block
  while true; do
    ask path "gRPC serviceName (без слешей)" "grpc"
    if [[ "$path" =~ ^[A-Za-z0-9_-]+$ ]]; then break; fi
    warn "serviceName может содержать только латиницу, цифры, дефис и подчёркивание (без слешей, пробелов и спецсимволов)."
  done
 
  # Тот же паттерн, что XHTTP, но сокет gRPC-инбаунда + keepalive для длинных стримов.
  block=$(cat <<EOB
 
    location /${path}/ {
            client_max_body_size 0;
            grpc_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
            grpc_socket_keepalive on;
            client_body_timeout 5m;
            grpc_read_timeout 315;
            grpc_send_timeout 5m;
            grpc_pass unix:/dev/shm/xrgrpc.socket;
        }
EOB
)
  nginx_upsert_location "$path" "$block"
}
 
# ----- 10) nginx 1.28 -> NGINX_TARGET (с проверкой версии и вопросом) -----
block_nginx_upgrade() {
  local f cur target rc=0
  require_node || return 1
  f="${NODE_DIR}/docker-compose.yml"
  info "Стек ноды найден: ${f}"
 
  cur="$(grep -oE 'image:[[:space:]]*nginx:[0-9.]+' "$f" | grep -oE '[0-9.]+$' | head -n1 || true)"
  if [ -z "$cur" ]; then
    warn "В ${f} не нашёл строку 'image: nginx:<версия>' — проверь образ вручную."
    return 1
  fi
  log "Текущая версия nginx в compose: ${cur}"
  case "$cur" in
    1.28*) : ;;
    *) log "Версия не 1.28 (сейчас ${cur}) — менять не нужно."; return 0 ;;
  esac
 
  warn "В nginx 1.28 найдены уязвимости (CVE). Рекомендуется обновить."
  ask target "Целевая версия nginx" "$NGINX_TARGET"
  if ! confirm "Поменять nginx ${cur} → ${target} и пересоздать контейнер?"; then
    warn "Отменено — образ не тронут."
    return 0
  fi
 
  cp -a "$f" "${f}.bak"
  sed -i -E "s#nginx:${cur//./\\.}#nginx:${target}#g" "$f"
  log "Образ в compose обновлён на nginx:${target} (бэкап: ${f}.bak). Тяну и пересоздаю."
  ( cd "$NODE_DIR" && docker compose pull && docker compose up -d ) || rc=$?
  if [ "$rc" -ne 0 ]; then
    err "pull/up не удался (возможно, нет такого тега). Откатываю compose."
    cp -a "${f}.bak" "$f"
    ( cd "$NODE_DIR" && docker compose up -d ) || true
    return 1
  fi
  sleep 2
  local now
  now="$(docker inspect -f '{{.Config.Image}}' remnawave-nginx 2>/dev/null || true)"
  log "Готово. Контейнер remnawave-nginx на образе: ${now:-неизвестно}"
}
 
# ----- SNI-проверка mTLS (панель → нода), remnawave/node >= 3.4 -----
# https://f.docs.rw/t/topic/639 — в 3.3.x нода обязательно сверяла SNI входящего
# mTLS-соединения; с 3.4.x проверка выключена и включается SNI_VERIFICATION=true.
node_env_value() {
  docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' "$NODE_CONTAINER" 2>/dev/null \
    | awk -F= -v key="$1" '$1 == key { print substr($0, length(key) + 2); exit }'
}

block_sni_verification() {
  local live want mode
  require_node || return 1
  live="$(node_env_value SNI_VERIFICATION)"
  log "SNI_VERIFICATION в ${NODE_CONTAINER}: ${live:-не задана (по умолчанию false)}"
  info "Нужна нода >= 3.4 и панель, которая шлёт ожидаемый SNI. Если нода уйдёт в offline — выключи обратно."
  choose_from_list mode "Что сделать?" "Включить (SNI_VERIFICATION=true)" \
    "Включить (SNI_VERIFICATION=true)" \
    "Выключить (SNI_VERIFICATION=false)"
  case "$mode" in
    Включить*) want=true ;;
    *)         want=false ;;
  esac
  if [ "$live" = "$want" ]; then
    log "Уже SNI_VERIFICATION=${want} — менять нечего."
    return 0
  fi
  if ! confirm "Записать SNI_VERIFICATION=${want} в compose и пересоздать ${NODE_CONTAINER}?"; then
    warn "Отменено — compose не тронут."
    return 0
  fi
  compose_set_env SNI_VERIFICATION "$want" || return 1
  log "compose обновлён (бэкап: ${NODE_DIR}/docker-compose.yml.bak). Пересоздаю контейнер."
  ( cd "$NODE_DIR" && docker compose up -d ) || { err "docker compose up -d не удался — см. вывод выше."; return 1; }
  sleep 2
  live="$(node_env_value SNI_VERIFICATION)"
  if [ "$live" != "$want" ]; then
    err "В контейнере SNI_VERIFICATION=${live:-<пусто>}, ожидалось ${want} — проверь compose вручную."
    return 1
  fi
  ok "SNI_VERIFICATION=${want} применена. Проверь в панели, что нода online; логи: docker logs --tail 50 ${NODE_CONTAINER}"
}
 
# ----- 11) Перезапуск контейнеров (стек ноды или все на хосте) -----
block_restart() {
  local mode ids
  echo
  log "Текущие контейнеры:"
  if ! docker ps --format 'table {{.Names}}\t{{.Status}}' 2>/dev/null; then
    err "docker недоступен."
    return 1
  fi
  echo

  choose_from_list mode "Что перезапустить?" "Стек ноды: restart" \
    "Стек ноды: restart" \
    "Стек ноды: пересоздать (down + up -d)" \
    "Все контейнеры на хосте"
 
  case "$mode" in
    "Стек ноды: restart")
      require_node || return 1
      info "Стек ноды найден: ${NODE_DIR}/docker-compose.yml"
      log "docker compose restart (в ${NODE_DIR})..."
      ( cd "$NODE_DIR" && docker compose restart )
      ;;
    "Стек ноды: пересоздать (down + up -d)")
      require_node || return 1
      info "Стек ноды найден: ${NODE_DIR}/docker-compose.yml"
      log "docker compose down && up -d (в ${NODE_DIR})..."
      ( cd "$NODE_DIR" && docker compose down && docker compose up -d )
      ;;
    "Все контейнеры на хосте")
      ids="$(docker ps -q 2>/dev/null || true)"
      if [ -z "$ids" ]; then warn "Запущенных контейнеров нет."; return 0; fi
      log "Перезапускаю все контейнеры на хосте..."
      # shellcheck disable=SC2086
      docker restart $ids >/dev/null
      ;;
  esac
 
  log "Готово. Состояние:"
  docker ps --format 'table {{.Names}}\t{{.Status}}' 2>/dev/null || true
}
 
# Поиск бинаря Beszel (агент или хаб) по PATH и штатным путям install-скрипта.
find_beszel_bin() {
  local n="$1" p
  p="$(command -v "$n" 2>/dev/null || true)"
  if [ -n "$p" ]; then echo "$p"; return 0; fi
  for p in "/opt/${n}/${n}" "/usr/local/sbin/${n}" "/usr/local/bin/${n}"; do
    if [ -x "$p" ]; then echo "$p"; return 0; fi
  done
  return 1
}
 
# ----- 12) Beszel: подключить агент к хабу -----
block_beszel_agent() {
  local key port token url tmp
  info "Beszel — мониторинг. Нужен публичный ключ из хаба:"
  info "в веб-интерфейсе хаба нажми Add System и скопируй Public Key."
  echo
  ask_required key "Публичный ключ Beszel (Public Key из хаба)"
  ask port  "Порт агента" "45876"
  warn "Для NAT-сервера (агент сам идёт к хабу по WebSocket) укажи Token и URL хаба."
  warn "Если хаб сам подключается к агенту по SSH — Token/URL можно пропустить (Enter)."
  ask token "Token (Enter — пропустить)" ""
  ask url   "URL хаба, напр. https://beszel.example.com (Enter — пропустить)" ""
  # Хаб стоит у панели и подключается к агенту сам: порт агента нужен только ему.
  fw_load
  if [ -z "${PANEL_IPS:-}" ]; then
    info "Порт агента ${port} откроем только для панели (хаб Beszel стоит у неё)."
    _ask_panel_ips "${NODE_PORT:-2222}" || { warn "Отменено."; return 1; }
  fi

  tmp="$(mktemp)"
  log "Скачиваю install-agent.sh."
  if ! curl -fsSL https://get.beszel.dev -o "$tmp"; then
    err "Не удалось скачать install-agent.sh."
    rm -f "$tmp"
    return 1
  fi
  chmod +x "$tmp"
 
  set -- -k "$key" -p "$port"
  if [ -n "$token" ]; then set -- "$@" -t "$token"; fi
  if [ -n "$url" ];   then set -- "$@" -url "$url"; fi
 
  log "Запускаю установку агента Beszel (скрипт спросит про авто-обновление)."
  "$tmp" "$@" || warn "install-agent.sh завершился с ненулевым кодом — см. вывод выше."
  rm -f "$tmp"
 
  # Порт агента — служебный, как порт ноды: в интернет не открываем, только панели.
  fw_set PANEL_PORTS "$(_merge_ports "${PANEL_PORTS:-}" "$port")"
  panel_only_apply

  echo
  if systemctl is-active --quiet beszel-agent 2>/dev/null; then
    ok "beszel-agent запущен. Проверь, что в хабе нода стала зелёной."
  else
    warn "Агент не активен — проверь: systemctl status beszel-agent"
  fi
}
 
# ----- 13) Beszel: обновить (агент и/или хаб) -----
block_beszel_update() {
  local found=0 bin c dir img
  bin="$(find_beszel_bin beszel-agent || true)"
  if [ -n "$bin" ]; then
    found=1
    log "Агент: ${bin} update"
    "$bin" update || warn "Обновление агента вернуло ошибку."
    systemctl restart beszel-agent 2>/dev/null || true
    ok "Агент Beszel обновлён."
  fi
  bin="$(find_beszel_bin beszel || true)"
  if [ -n "$bin" ]; then
    found=1
    log "Хаб: ${bin} update"
    "$bin" update || warn "Обновление хаба вернуло ошибку."
    systemctl restart beszel-hub 2>/dev/null || true
    ok "Хаб Beszel обновлён."
  fi
  # Docker-установка (хаб beszel и/или агент beszel-agent): обновляем через compose.
  for c in beszel beszel-agent; do
    if docker ps -a --format '{{.Names}}' 2>/dev/null | grep -qx "$c"; then
      found=1
      dir="$(docker inspect "$c" -f '{{ index .Config.Labels "com.docker.compose.project.working_dir"}}' 2>/dev/null || true)"
      img="$(docker inspect "$c" -f '{{.Config.Image}}' 2>/dev/null || true)"
      if [ -n "$dir" ] && [ -d "$dir" ]; then
        log "Docker ${c}: обновляю через compose в ${dir}."
        ( cd "$dir" && docker compose pull && docker compose up -d ) || warn "Не удалось обновить ${c} (compose в ${dir})."
        ok "Docker ${c} обновлён."
      else
        log "Docker ${c}: тяну образ ${img:-henrygd/${c}:latest}."
        docker pull "${img:-henrygd/${c}:latest}" || warn "docker pull не удался для ${c}."
        warn "Контейнер ${c} запущен не через compose — пересоздай его вручную для применения образа."
      fi
    fi
  done
  if [ "$found" -eq 0 ]; then
    warn "Beszel (агент/хаб) на этом сервере не найден."
    warn "Сначала подключи агент (пункт «Beszel: подключить агент»)."
  fi
}
 
# ----- 14) Диагностика ноды (внешний скрипт Case211/node-diagnostic) -----
block_diag() {
  local tmp
  log "Скачиваю и запускаю диагностику ноды (Case211/node-diagnostic)."
  log "Полный прогон ~5 мин; скрипт может предложить применить фиксы — отвечай сам."
  tmp="$(mktemp)"
  if ! curl -fsSL https://raw.githubusercontent.com/Case211/node-diagnostic/main/node-diagnostic.sh -o "$tmp"; then
    err "Не удалось скачать диагностику."
    rm -f "$tmp"
    return 1
  fi
  # сам диагностический скрипт может вернуть ненулевой код при найденных проблемах — это нормально
  bash "$tmp" || true
  rm -f "$tmp"
}
 
# ----- node-accelerator: diagnose (ядро/sysctl/conntrack/NIC/firewall/порты, read-only) -----
block_na_diagnose() {
  local tmp
  info "node-accelerator: диагностика — ядро/BBR/sysctl/conntrack/NIC/RPS/firewall/порты. Только чтение."
  echo
  tmp="$(mktemp)"
  if ! curl -fsSL "https://raw.githubusercontent.com/jestivald/node-accelerator/${NA_REF}/install.sh" -o "$tmp"; then
    err "Не удалось скачать node-accelerator (install.sh)."
    rm -f "$tmp"
    return 1
  fi
  # read-only; ненулевой код = найдены замечания, это нормально
  NA_REF="$NA_REF" bash "$tmp" diagnose || true
  rm -f "$tmp"
}
 
# ----- 13) Подменю «Диагностика»: выбор, что запускать -----
print_diag_menu() {
  cat <<EOF
 
${BOLD}${CYN}══════════════════════════════════════════════════════════════${RST}
                        ${BOLD}${WHT}Диагностика${RST}
${BOLD}${CYN}══════════════════════════════════════════════════════════════${RST}
   ${BOLD}${CYN} 1)${RST} node-diagnostic    ${GRY}— проверка ноды, может предложить фиксы${RST}
   ${BOLD}${CYN} 2)${RST} node-accelerator   ${GRY}— ядро/sysctl/сеть/firewall, только чтение${RST}
   ${BOLD}${GRN} 3)${RST} Аудит ноды         ${GRY}— встроенный: проверка + починка найденного по выбору${RST}
   ${BOLD}${RED} 0)${RST} ${RED}Назад${RST}
${GRY}──────────────────────────────────────────────────────────────${RST}
 ${DIM}Можно оба сразу:  1 2${RST}
EOF
}
 
submenu_diag() {
  local choice c
  while true; do
    print_diag_menu
    read -rp "Выбор: " choice
    [ -z "$choice" ] && continue
    for c in $choice; do
      case "$c" in
        1) run_block "Диагностика ноды (node-diagnostic)" block_diag ;;
        2) run_block "Диагностика (node-accelerator)" block_na_diagnose ;;
        3) run_block "Аудит ноды" block_audit ;;
        0) return 0 ;;
        *) warn "Неизвестный пункт: ${c}" ;;
      esac
    done
    echo
    read -rp "Нажмите Enter для возврата в меню диагностики..." _
  done
}
 
# Зависимости для внешних проверок. Устанавливаем только отсутствующие пакеты.
ensure_check_dependencies() {
  local packages=(ca-certificates curl wget iperf3 sysbench jq bc) missing=() pkg
  for pkg in "${packages[@]}"; do
    dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q 'ok installed' || missing+=("$pkg")
  done
  if [ "${#missing[@]}" -eq 0 ]; then
    return 0
  fi
  log "Ставлю зависимости для проверок: ${missing[*]}"
  wait_for_apt
  apt-get update -y
  apt-get install -y "${missing[@]}"
}

# ----- 14) Подменю «Проверки VPS» (внешние скрипты) -----
print_checks_menu() {
  cat <<EOF
 
${BOLD}${CYN}══════════════════════════════════════════════════════════════${RST}
                         ${BOLD}${WHT}Проверки VPS${RST}
${BOLD}${CYN}══════════════════════════════════════════════════════════════${RST}
 ${BOLD}${MAG}Блокировки / регион${RST}${GRY}:${RST}
   ${BOLD}${CYN} 1)${RST} IP region                ${GRY}— какой регион видят сайты по IP${RST}
   ${BOLD}${CYN} 2)${RST} CensorCheck geoblock     ${GRY}— проверка геоблокировок${RST}
   ${BOLD}${CYN} 3)${RST} CensorCheck DPI          ${GRY}— проверка для серверов РФ${RST}
   ${BOLD}${CYN} 4)${RST} IP.Check.Place           ${GRY}— блокировки IP зарубежными сервисами${RST}
   ${BOLD}${CYN} 5)${RST} IPQuality                ${GRY}— качество и репутация IP${RST}
 
 ${BOLD}${MAG}Бенчмарки / скорость${RST}${GRY}:${RST}
   ${BOLD}${CYN} 6)${RST} Russian iPerf3           ${GRY}— скорость до российских серверов${RST}
   ${BOLD}${CYN} 7)${RST} YABS                     ${GRY}— диск + сеть (iperf3) + GeekBench${RST}
   ${BOLD}${CYN} 8)${RST} bench.sh                 ${GRY}— параметры + зарубежная скорость${RST}
   ${BOLD}${CYN} 9)${RST} sysbench CPU             ${GRY}— оценка выделенного CPU${RST}
   ${BOLD}${RED} 0)${RST} ${RED}Назад${RST}
${GRY}──────────────────────────────────────────────────────────────${RST}
 ${DIM}Несколько номеров через пробел можно, напр.:  1 4${RST}
EOF
}
 
submenu_checks() {
  local choice c
  ensure_check_dependencies || {
    err "Не удалось установить зависимости для проверок."
    return 1
  }
  while true; do
    print_checks_menu
    read -rp "Выбор: " choice
    [ -z "$choice" ] && continue
    for c in $choice; do
      case "$c" in
        1) echo; step "IP region";          bash <(wget -qO- https://ipregion.vrnt.xyz) || true ;;
        2) echo; step "CensorCheck geoblock"; bash <(wget -qO- https://github.com/vernette/censorcheck/raw/master/censorcheck.sh) --mode geoblock || true ;;
        3) echo; step "CensorCheck DPI";    bash <(wget -qO- https://github.com/vernette/censorcheck/raw/master/censorcheck.sh) --mode dpi || true ;;
        4) echo; step "IP.Check.Place";     bash <(curl -fLs IP.Check.Place) -l en || true ;;
        5) echo; step "IPQuality";          bash <(curl -fLs https://Check.Place) -EI || true ;;
        6) echo; step "Russian iPerf3";     bash <(wget -qO- https://github.com/itdoginfo/russian-iperf3-servers/raw/main/speedtest.sh) || true ;;
        7) echo; step "YABS";               curl -fsSL yabs.sh | bash -s -- -4 || true ;;
        8) echo; step "bench.sh";           wget -qO- bench.sh | bash || true ;;
        9) echo; step "sysbench CPU";       sysbench cpu run --threads=1 || true ;;
        0)  return 0 ;;
        *)  warn "Неизвестный пункт: ${c}" ;;
      esac
    done
    echo
    read -rp "Нажмите Enter для возврата в меню проверок..." _
  done
}
 
# ============================================================================
#  ДОБАВЛЕНО: единый фаервол + порты + опциональные модули
# ============================================================================

FW_ENV="/etc/nodeforge/firewall.env"

# Создать реестр с дефолтами для ОТСУТСТВУЮЩИХ ключей (ничего не перетирает).
fw_init() {
  mkdir -p /etc/nodeforge
  [ -f "$FW_ENV" ] || ( umask 077; : > "$FW_ENV" )
  chmod 600 "$FW_ENV"
  local kv k v
  for kv in \
    "SSH_PORT=$(detect_ssh_port)" \
    "NODE_PORT=2222" \
    "TCP_PORTS=443" \
    "UDP_PORTS=443" \
    "EXTRA_TCP=" \
    "EXTRA_UDP=" \
    "WHITELIST=" \
    "PANEL_IPS=" \
    "PANEL_PORTS=" \
    "CONN_LIMIT=" \
    "SYN_RATE=" \
    "SYN_BURST=" \
    "ENABLE_PORTSCAN_BAN=" \
    "ENABLE_BLOCKLISTS=1" \
    "BLOCK_TOR=0"; do
    k="${kv%%=*}"; v="${kv#*=}"
    grep -qE "^${k}=" "$FW_ENV" || printf '%s="%s"\n' "$k" "$v" >> "$FW_ENV"
  done
}

# Обновить ОДИН ключ, сохранив остальные.
fw_set() {
  fw_init; local k="$1" v="$2"
  if grep -qE "^${k}=" "$FW_ENV"; then
    sed -i -E "s|^${k}=.*|${k}=\"${v}\"|" "$FW_ENV"
  else
    printf '%s="%s"\n' "$k" "$v" >> "$FW_ENV"
  fi
}

fw_load() { fw_init; . "$FW_ENV"; }

# Объединить два списка "a,b" + "c" → "a,b,c" (uniq, без пустых).
_merge_ports() { { echo "$1"; echo "$2"; } | tr ',' '\n' | sed '/^[[:space:]]*$/d' | sort -un | paste -sd, ; }

# Убрать порт из списка "a,b,c".
_drop_port() { echo "$1" | tr ',' '\n' | sed '/^[[:space:]]*$/d' | grep -vx "$2" | paste -sd, ; }

# Объединить списки адресов "a,b" + "c" → "a,b,c" (uniq, без пробелов и пустых).
_merge_list() { { echo "$1"; echo "$2"; } | tr ', ' '\n' | sed '/^$/d' | sort -u | paste -sd, ; }

# Выключить ufw, чтобы не было ВТОРОГО фаервола с «запретить всё».
fw_neutralize_ufw() {
  command -v ufw >/dev/null 2>&1 || return 0
  if ufw status 2>/dev/null | grep -qi '^Status: active'; then
    warn "ufw был включён — выключаю. Оставляем ОДИН фаервол (nftables), иначе порты конфликтуют."
  fi
  ufw --force disable >/dev/null 2>&1 || true
  systemctl disable --now ufw >/dev/null 2>&1 || true
  # Жёстко (чтобы сторонние установщики снова не включили) — раскомментируй при желании:
  # wait_for_apt; apt-get purge -y ufw >/dev/null 2>&1 || true
}

# ПРИМЕНИТЬ: убить ufw + открыть ВЕСЬ набор портов из реестра одним фаерволом.
apply_firewall() {
  fw_load
  fw_neutralize_ufw
  local tcp udp wl tmp
  tcp="$(_merge_ports "${TCP_PORTS:-443}" "${EXTRA_TCP:-}")"
  udp="$(_merge_ports "${UDP_PORTS:-443}" "${EXTRA_UDP:-}")"
  # Панель ходит на служебные порты (порт ноды, beszel) — её адреса всегда в whitelist,
  # иначе na_filter отбросит её раньше, чем пакет дойдёт до фильтра panel-only.
  wl="$(_merge_list "${WHITELIST:-}" "${PANEL_IPS:-}")"
  echo
  info "Применяю фаервол: SSH=${SSH_PORT}  NODE=${NODE_PORT}  TCP=${tcp}  UDP=${udp}"
  [ -n "$wl" ] && info "Whitelist (без лимитов): ${wl}"
  tmp="$(mktemp)"
  if ! curl -fsSL "https://raw.githubusercontent.com/jestivald/node-accelerator/${NA_REF}/install.sh" -o "$tmp"; then
    err "Не удалось скачать node-accelerator."; rm -f "$tmp"; return 1
  fi
  # Пустые CONN_LIMIT/SYN_*/ENABLE_PORTSCAN_BAN = «как решил node-accelerator»
  # (его protect.conf подставляет своё значение вместо пустого).
  SSH_PORT="${SSH_PORT:-$(detect_ssh_port)}" NODE_PORT="${NODE_PORT:-2222}" \
  TCP_PORTS="$tcp" UDP_PORTS="$udp" WHITELIST="$wl" \
  CONN_LIMIT="${CONN_LIMIT:-}" SYN_RATE="${SYN_RATE:-}" SYN_BURST="${SYN_BURST:-}" \
  ENABLE_PORTSCAN_BAN="${ENABLE_PORTSCAN_BAN:-}" \
  ENABLE_BLOCKLISTS="${ENABLE_BLOCKLISTS:-1}" BLOCK_TOR="${BLOCK_TOR:-0}" \
  SAFETY_DELAY=300 REMNAWAVE_NONINTERACTIVE=1 NA_REF="$NA_REF" \
    bash "$tmp" protect || warn "protect вернул ненулевой код — см. вывод выше."
  rm -f "$tmp"
  panel_only_apply
  fw_confirm_safety
  warn "Быстрый статус потом: na-fw-status"
}

# Сейфти-таймер node-accelerator: если его не снять, через SAFETY_DELAY секунд
# na_filter удаляется, а автозагрузка правил выключается — молча, одной строкой
# в журнале. В неинтерактивном режиме protect его сам не снимает, и переподключение
# по SSH его тоже НЕ снимает: только явная остановка таймера (или pid-фолбэка).
na_safety_armed() {
  systemctl is-active --quiet na-fw-safety.timer 2>/dev/null \
    || [ -s /var/lib/node-accelerator/na-fw-safety.pid ]
}

na_safety_disarm() {
  local pidf=/var/lib/node-accelerator/na-fw-safety.pid
  systemctl stop na-fw-safety.timer 2>/dev/null || true
  if [ -s "$pidf" ]; then
    kill "$(cat "$pidf")" 2>/dev/null || true
    rm -f "$pidf"
  fi
}

# Спросить, работает ли вход в новом окне, и снять сейфти; затем проверить результат.
fw_confirm_safety() {
  local ip
  if na_safety_armed; then
    ip="$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "src") { print $(i + 1); exit }}' || true)"
    echo
    warn "Сейфти-таймер взведён: через 5 минут фаервол САМ удалится. Переподключение его НЕ снимает."
    warn "Открой НОВОЕ окно и проверь вход:  ssh -p ${SSH_PORT:-$(detect_ssh_port)} <пользователь>@${ip:-<IP_СЕРВЕРА>}"
    if confirm "Вход в новом окне работает — оставить фаервол включённым?"; then
      na_safety_disarm
      ok "Сейфти-таймер снят."
    else
      warn "Сейфти оставлен: через несколько минут na_filter удалится и защиты не будет."
      warn "Проверишь позже — сними сам: systemctl stop na-fw-safety.timer"
    fi
  fi
  fw_verify
}

# Фаервол реально стоит и переживёт ребут? Печатает итог, ничего не меняет.
fw_verify() {
  local bad=0
  if nft list table inet na_filter >/dev/null 2>&1; then ok "na_filter загружен."
  else err "na_filter НЕ загружен — защиты нет."; bad=1; fi
  if systemctl is-enabled --quiet na-firewall.service 2>/dev/null; then ok "na-firewall в автозагрузке."
  else err "na-firewall НЕ в автозагрузке — после ребута защиты не будет."; bad=1; fi
  if na_safety_armed; then warn "Сейфти-таймер всё ещё взведён."; bad=1; fi
  if [ "$bad" -ne 0 ]; then warn "Повтори «f) Починить фаервол»."; fi
}

# Показать, что реально слушает на сервере (порт, протокол, процесс).
_show_listening() {
  echo "${BOLD}Сейчас СЛУШАЮТ на сервере (что реально открыто):${RST}"
  ss -tulpnH 2>/dev/null | while read -r l; do
    pr="$(printf '%s' "$l" | awk '{print $1}')"
    pt="$(printf '%s' "$l" | awk '{print $5}')"; pt="${pt##*:}"
    nm="$(printf '%s' "$l" | grep -oE '"[^"]+"' | head -1 | tr -d '"')"
    [ -n "$pt" ] && printf '   %-6s %-4s %s\n' "$pt" "$pr" "$nm"
  done | sort -u | sort -n
}

# ----- Пункт меню «Порты» -----
block_ports() {
  fw_init
  while true; do
    fw_load
    echo
    step "ПОРТЫ"
    _show_listening
    echo
    echo "${BOLD}Фаервол ДЕРЖИТ ОТКРЫТЫМИ (реестр):${RST}"
    printf '   SSH:  %s\n'  "${SSH_PORT}"
    printf '   NODE: %s   %s\n' "$(_merge_ports "${NODE_PORT}" "${PANEL_PORTS:-}")" \
      "${GRY}(только для панели: ${PANEL_IPS:-НЕ задано — пункт «k»})${RST}"
    printf '   TCP:  %s\n'  "$(_merge_ports "${TCP_PORTS}" "${EXTRA_TCP}")"
    printf '   UDP:  %s\n'  "$(_merge_ports "${UDP_PORTS}" "${EXTRA_UDP}")"
    [ -n "${WHITELIST}" ] && printf '   WL:   %s   %s\n' "${WHITELIST}" "${GRY}(IP без лимитов)${RST}"
    echo
    echo "   ${BOLD}${GRN}1)${RST} Добавить порт"
    echo "   ${BOLD}${GRN}2)${RST} Убрать порт (из доп-портов)"
    echo "   ${BOLD}${GRN}3)${RST} Применить ${GRY}— открыть всё из реестра, остальное закрыть${RST}"
    echo "   ${BOLD}${CYN}4)${RST} Сменить SSH / NODE / 443 / WHITELIST"
    echo "   ${BOLD}${RED}0)${RST} Назад"
    read -rp "Выбор: " a
    case "$a" in
      1)
        read -rp "Какой порт открыть: " pp
        if ! is_uint "$pp" || [ "$pp" -lt 1 ] || [ "$pp" -gt 65535 ]; then warn "Нужно число 1–65535."; continue; fi
        read -rp "Протокол tcp/udp [tcp]: " pr; pr="${pr:-tcp}"
        if [ "$pr" = "udp" ]; then fw_set EXTRA_UDP "$(_merge_ports "${EXTRA_UDP}" "$pp")"
        else                       fw_set EXTRA_TCP "$(_merge_ports "${EXTRA_TCP}" "$pp")"; fi
        log "Добавлен ${pp}/${pr} в реестр. Жми ${BOLD}3 (Применить)${RST}, чтобы открыть."
        ;;
      2)
        read -rp "Какой доп-порт убрать: " pp
        read -rp "Протокол tcp/udp [tcp]: " pr; pr="${pr:-tcp}"
        if [ "$pr" = "udp" ]; then fw_set EXTRA_UDP "$(_drop_port "${EXTRA_UDP}" "$pp")"
        else                       fw_set EXTRA_TCP "$(_drop_port "${EXTRA_TCP}" "$pp")"; fi
        log "Убран ${pp}/${pr} из доп-портов. Жми ${BOLD}3 (Применить)${RST}."
        warn "SSH / NODE / 443 убираются только через пункт 4 — чтобы случайно не отрезать себя."
        ;;
      3) apply_firewall ;;
      4)
        read -rp "SSH-порт [${SSH_PORT}]: " v;  [ -n "$v" ] && fw_set SSH_PORT  "$v"
        read -rp "NODE-порт [${NODE_PORT}]: " v; [ -n "$v" ] && fw_set NODE_PORT "$v"
        read -rp "TCP-порты трафика через запятую [${TCP_PORTS}]: " v; [ -n "$v" ] && fw_set TCP_PORTS "$v"
        read -rp "UDP-порты трафика через запятую [${UDP_PORTS}]: " v; [ -n "$v" ] && fw_set UDP_PORTS "$v"
        read -rp "WHITELIST IP/CIDR через запятую (твой постоянный IP/панель) [${WHITELIST}]: " v; fw_set WHITELIST "${v:-$WHITELIST}"
        log "Сохранено в реестр. Жми ${BOLD}3 (Применить)${RST}."
        ;;
      0) return 0 ;;
      *) warn "Не понял: ${a}" ;;
    esac
  done
}


SHAPER_CONF="/etc/nodeforge/shaper.conf"
SHAPER_BIN="/usr/local/sbin/nodeforge-shaper"

_default_iface() {
  ip route show default 2>/dev/null | awk '/default/{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}'
}

# Скрипт применения (читает conf, идемпотентен) + systemd-юнит для автозапуска.
_shaper_write_runtime() {
  cat > "$SHAPER_BIN" <<'EOS'
#!/bin/bash
# nodeforge shaper runtime — применяет режим из /etc/nodeforge/shaper.conf
CONF=/etc/nodeforge/shaper.conf
[ -f "$CONF" ] || exit 0
. "$CONF"
IFACE="${IFACE:-}"
[ -n "$IFACE" ] || IFACE="$(ip route show default 2>/dev/null | awk '/default/{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}')"
[ -n "$IFACE" ] || { echo "shaper: интерфейс не найден"; exit 1; }
MODE="${MODE:-off}"
RATE="${RATE:-200mbit}"
PERIP_RATE="${PERIP_RATE:-6250}"   # kbytes/sec
VPN_PORT="${VPN_PORT:-443}"
PROTO="${PROTO:-tcp}"

# сброс прошлого состояния
tc qdisc del dev "$IFACE" root 2>/dev/null
command -v nft >/dev/null 2>&1 && nft delete table inet nodeforge_shape 2>/dev/null

case "$MODE" in
  off) exit 0 ;;

  fair)
    tc qdisc replace dev "$IFACE" root fq_codel
    ;;

  total)
    tc qdisc add dev "$IFACE" root handle 1: htb default 10
    tc class add dev "$IFACE" parent 1:  classid 1:1  htb rate "$RATE" ceil "$RATE"
    tc class add dev "$IFACE" parent 1:1 classid 1:10 htb rate "$RATE" ceil "$RATE"
    tc qdisc add dev "$IFACE" parent 1:10 fq_codel
    ;;

  perip)
    command -v nft >/dev/null 2>&1 || { echo "shaper: nft нет — режим perip недоступен"; exit 1; }
    R="${PERIP_RATE} kbytes/second"
    nft -f - <<NFT
table inet nodeforge_shape {
  chain out {
    type filter hook postrouting priority 0; policy accept;
    ${PROTO} sport ${VPN_PORT} meter sh_d4 { ip  daddr limit rate over ${R} } drop
    ${PROTO} sport ${VPN_PORT} meter sh_d6 { ip6 daddr limit rate over ${R} } drop
  }
  chain in {
    type filter hook prerouting priority 0; policy accept;
    ${PROTO} dport ${VPN_PORT} meter sh_u4 { ip  saddr limit rate over ${R} } drop
    ${PROTO} dport ${VPN_PORT} meter sh_u6 { ip6 saddr limit rate over ${R} } drop
  }
}
NFT
    ;;
esac
EOS
  chmod 755 "$SHAPER_BIN"
  cat > /etc/systemd/system/nodeforge-shaper.service <<EOS
[Unit]
Description=nodeforge traffic shaper
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
ExecStart=${SHAPER_BIN}
RemainAfterExit=yes
[Install]
WantedBy=multi-user.target
EOS
  systemctl daemon-reload
  systemctl enable nodeforge-shaper.service >/dev/null 2>&1 || true
}

block_shaper() {
  local mode iface rate perip vpnport proto kb
  iface="$(_default_iface)"
  [ -z "$iface" ] && { err "Не нашёл сетевой интерфейс по умолчанию."; return 1; }
  echo
  info "Шейпер. Сетевой интерфейс: ${iface}"
  warn "Точные лимиты НА ПОЛЬЗОВАТЕЛЯ лучше ставить в ПАНЕЛИ Remnawave (per-user)."
  warn "Здесь — лимиты на уровне ноды. perip = приближение «на клиентский IP»."
  echo
  choose_from_list mode "Режим шейпера:" "" \
    "off"   \
    "fair"  \
    "total" \
    "perip"
  echo
  case "$mode" in
    off)
      printf 'IFACE="%s"\nMODE="off"\n' "$iface" > "$SHAPER_CONF"
      ;;
    fair)
      info "fair — честность между потоками (fq_codel). Никто не сожрёт канал, жёстких лимитов нет."
      printf 'IFACE="%s"\nMODE="fair"\n' "$iface" > "$SHAPER_CONF"
      ;;
    total)
      info "total — общий потолок ВСЕЙ ноды."
      ask rate "Потолок ноды (например 300mbit / 1gbit)" "300mbit"
      printf 'IFACE="%s"\nMODE="total"\nRATE="%s"\n' "$iface" "$rate" > "$SHAPER_CONF"
      ;;
    perip)
      info "perip — лимит на каждый клиентский IP по VPN-порту."
      while true; do
        ask vpnport "VPN-порт (порт трафика клиентов)" "443"
        vpnport="${vpnport%%,*}"
        if is_uint "$vpnport" && [ "$vpnport" -ge 1 ] && [ "$vpnport" -le 65535 ]; then break; fi
        warn "Введите номер порта 1–65535."
      done
      choose_from_list proto "Протокол VPN-порта:" "tcp" "tcp" "udp"
      ask perip "Лимит на ОДИН IP, Мбит/с (число)" "50"
      if ! is_uint "$perip"; then warn "Нужно число."; return 1; fi
      kb=$(( perip * 125 ))   # Мбит/с → kbytes/sec (mbit*1000/8)
      printf 'IFACE="%s"\nMODE="perip"\nVPN_PORT="%s"\nPROTO="%s"\nPERIP_RATE="%s"\n' \
        "$iface" "$vpnport" "$proto" "$kb" > "$SHAPER_CONF"
      ;;
    *) warn "Неизвестный режим."; return 1 ;;
  esac
  chmod 600 "$SHAPER_CONF"
  _shaper_write_runtime
  if "$SHAPER_BIN"; then
    ok "Шейпер применён (режим: ${mode}). Переживёт ребут (systemd: nodeforge-shaper)."
    [ "$mode" = "perip" ] && warn "perip режет лишнее отбрасыванием пакетов — это рабочий потолок на IP, но не плавный QoS."
    [ "$mode" != "off" ] && warn "Снять позже: пункт «Шейпер» → off."
  else
    err "Не удалось применить шейпер — см. вывод выше."
    return 1
  fi
}


# ============================================================================
#  g)  БЛОК РФ-ГОССЕТЕЙ  (отдельная nft-таблица, drop-only — залочить НЕ может)
# ----------------------------------------------------------------------------
#  Дропает входящие соединения с диапазонов госсетей РФ (список shadow-netlab).
#  Сосуществует с na_filter (своя таблица, policy accept, только точечный drop).
#  Сканеры твой «protect» и так банит — это именно про прятки от зондов госсетей.
# ============================================================================
block_govblock() {
  command -v nft >/dev/null 2>&1 || { err "nft не найден — сначала подними фаервол (пункт «protect»)."; return 1; }
  warn "Это спорная мера (можно зацепить лишнее). Сканеры уже режутся в protect."
  confirm "Включить блок РФ-госсетей?" || { warn "Отменено."; return 1; }

  install -d -m 755 /usr/local/sbin
  cat > /usr/local/sbin/nodeforge-govblock-update <<'EOS'
#!/bin/bash
set -e
URL="https://raw.githubusercontent.com/shadow-netlab/traffic-guard-lists/refs/heads/main/public/government_networks.list"
TMP="$(mktemp)"
curl -fsSL "$URL" | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+(/[0-9]+)?$' > "$TMP" || { rm -f "$TMP"; exit 1; }
[ "$(wc -l < "$TMP")" -ge 10 ] || { echo "список подозрительно мал — прерываю"; rm -f "$TMP"; exit 1; }
nft list table inet nodeforge_block >/dev/null 2>&1 || nft add table inet nodeforge_block
nft list chain inet nodeforge_block input >/dev/null 2>&1 || \
  nft add chain inet nodeforge_block input '{ type filter hook input priority -350; policy accept; }'
nft list set inet nodeforge_block gov_v4 >/dev/null 2>&1 || \
  nft add set inet nodeforge_block gov_v4 '{ type ipv4_addr; flags interval; auto-merge; }'
nft list chain inet nodeforge_block input | grep -q '@gov_v4 drop' || \
  nft add rule inet nodeforge_block input ip saddr @gov_v4 drop
ELEMS="$(paste -sd, "$TMP")"
nft flush set inet nodeforge_block gov_v4
[ -n "$ELEMS" ] && nft add element inet nodeforge_block gov_v4 "{ $ELEMS }"
rm -f "$TMP"
echo "gov-block обновлён: $(date)"
EOS
  chmod 755 /usr/local/sbin/nodeforge-govblock-update

  if /usr/local/sbin/nodeforge-govblock-update; then
    ( crontab -l 2>/dev/null | grep -v nodeforge-govblock-update || true
      echo '17 5 * * * /usr/local/sbin/nodeforge-govblock-update >> /var/log/nodeforge-govblock.log 2>&1' ) | crontab -
    ok "РФ-госсети блокируются (таблица inet nodeforge_block, обновление ежедневно 05:17)."
    warn "Снять полностью: nft delete table inet nodeforge_block; crontab -e (убрать строку govblock)."
  else
    err "Не удалось скачать/применить список."
    return 1
  fi
}


# ============================================================================
#  n)  УВЕДОМЛЕНИЯ О SSH-ВХОДЕ В TELEGRAM  (pam_exec)
# ----------------------------------------------------------------------------
#  Шлёт сообщение в Telegram при каждом входе по SSH. Токен/Chat ID — локально.
# ============================================================================
block_ssh_notify() {
  local token chat
  info "Уведомление в Telegram при входе по SSH. Нужен бот (@BotFather) и Chat ID."
  ask_required token "Telegram Bot Token"
  ask_required chat  "Chat ID (твой или группы)"
  install -d -m 755 /etc/nodeforge
  cat > /etc/nodeforge/ssh-notify.sh <<EOS
#!/bin/bash
[ "\$PAM_TYPE" = "open_session" ] || exit 0
HOST="\$(hostname)"
TEXT="🔐 SSH вход: \${PAM_USER}@\${HOST} с \${PAM_RHOST} (\$(date '+%F %T'))"
curl -s --max-time 10 "https://api.telegram.org/bot${token}/sendMessage" \\
  -d "chat_id=${chat}" --data-urlencode "text=\${TEXT}" >/dev/null 2>&1 || true
EOS
  chmod 700 /etc/nodeforge/ssh-notify.sh
  if grep -q 'nodeforge/ssh-notify.sh' /etc/pam.d/sshd 2>/dev/null; then
    log "Строка pam_exec уже есть."
  else
    echo 'session optional pam_exec.so seteuid /etc/nodeforge/ssh-notify.sh' >> /etc/pam.d/sshd
  fi
  ok "Готово. Тест: зайди по SSH в новом окне — должно прийти сообщение."
  warn "Снять: убери строку 'nodeforge/ssh-notify.sh' из /etc/pam.d/sshd."
}


# ============================================================================
#  b)  БЭКАП КОНФИГОВ  (один архив со всеми важными настройками)
# ============================================================================
block_backup() {
  local stamp dst nft_dump cron_dump
  stamp="$(date +%F-%H%M)"
  dst="/root/nodeforge-backup-${stamp}.tar.gz"
  nft_dump="/root/nft-ruleset-${stamp}.conf"
  cron_dump="/root/crontab-${stamp}.txt"

  command -v nft >/dev/null 2>&1 && nft list ruleset > "$nft_dump" 2>/dev/null || true
  ( crontab -l 2>/dev/null || true ) > "$cron_dump"

  tar -czf "$dst" 2>/dev/null \
    /etc/ssh/sshd_config /etc/ssh/sshd_config.d \
    /etc/nodeforge \
    /etc/pam.d/sshd \
    /opt/remnanode/docker-compose.yml /opt/remnanode/nginx.conf \
    /etc/logrotate.d/remnanode \
    /etc/network/interfaces /etc/netplan \
    "$nft_dump" "$cron_dump" || true

  if [ -f "$dst" ]; then
    ok "Бэкап готов: ${dst}"
    log "Внутри: sshd_config(.d), /etc/nodeforge (реестр портов, IP панели, шейпер), pam sshd, compose+nginx ноды, logrotate, сеть (MTU), дамп nft, crontab."
    warn "Скачать к себе: scp root@<IP>:${dst} ."
  else
    err "Не удалось создать архив."
    return 1
  fi
}


# ============================================================================
#  l)  FLEET-SYNC  (ноды флота сами держат IP друг друга в whitelist)
# ----------------------------------------------------------------------------
#  ТРЕБУЕТ файл nodeforge-ports.sh (использует fw_set + apply_firewall + реестр).
#  Это родная фича node-accelerator: ноды читают список нод из API панели
#  Remnawave и держат их IP в whitelist (na_fleet_*). Безопасная замена «Skynet»
#  в части взаимного доверия — без хранения паролей, только токен панели.
# ============================================================================
block_fleet() {
  if ! type fw_set >/dev/null 2>&1 || ! type apply_firewall >/dev/null 2>&1; then
    err "Нужен блок из nodeforge-ports.sh (fw_set/apply_firewall). Сначала вставь его."
    return 1
  fi
  local url token
  fw_load
  info "Fleet-sync: ноды флота whitelist-ят друг друга из API панели Remnawave."
  info "Нужны URL панели и API-токен с правом читать список нод (/api/nodes)."
  ask url   "URL панели (например https://panel.example.com)" "${REMNAWAVE_URL:-}"
  ask token "API-токен панели" "${REMNAWAVE_TOKEN:-}"
  if [ -z "$url" ] || [ -z "$token" ]; then warn "Пусто — отменяю."; return 1; fi
  fw_set REMNAWAVE_URL   "$url"
  fw_set REMNAWAVE_TOKEN "$token"
  ok "Сохранено в реестр. Применяю фаервол — поднимется таймер na-fleet-sync (интервал 5 мин)."
  echo
  apply_firewall
  warn "Проверить потом: journalctl -t na-fleet-sync --no-pager | tail"
}


block_update_lists() {
  local did=0
  echo
  step "Обновление всех списков сетей"

  # 1) RU geoip/geosite для Xray (если настроена RU-блокировка)
  if [ -x /opt/remnanode/update-geo.sh ]; then
    log "RU geoip/geosite (Xray)…"
    if /opt/remnanode/update-geo.sh; then ok "RU-списки обновлены."; else warn "RU-списки: ошибка (см. вывод)."; fi
    did=1
  fi

  # 2) Блоклисты node-accelerator (Spamhaus DROP + FireHOL L1 [+ Tor])
  if [ -x /usr/local/sbin/na-blocklist-update ]; then
    log "Блоклисты node-accelerator (Spamhaus/FireHOL)…"
    if /usr/local/sbin/na-blocklist-update >/dev/null 2>&1; then ok "Блоклисты обновлены."; else warn "Блоклисты: ошибка."; fi
    did=1
  fi

  # 3) РФ-госсети (если включён блок госсетей)
  if [ -x /usr/local/sbin/nodeforge-govblock-update ]; then
    log "РФ-госсети…"
    if /usr/local/sbin/nodeforge-govblock-update; then ok "Госсети обновлены."; else warn "Госсети: ошибка."; fi
    did=1
  fi

  [ "$did" -eq 0 ] && warn "Обновляемых списков не найдено (ничего списочного пока не настроено)."

  # --- самолечение cron: если скрипт есть, а задание пропало — вернуть ---
  if [ -x /opt/remnanode/update-geo.sh ] && ! { crontab -l 2>/dev/null | grep -qF 'update-geo.sh'; }; then
    ( crontab -l 2>/dev/null || true; echo '0 4 * * 0 /opt/remnanode/update-geo.sh >> /var/log/geo-update.log 2>&1' ) | crontab -
    log "Восстановил cron для RU-geo (Вс 04:00)."
  fi
  if [ -x /usr/local/sbin/nodeforge-govblock-update ] && ! { crontab -l 2>/dev/null | grep -qF 'nodeforge-govblock-update'; }; then
    ( crontab -l 2>/dev/null || true; echo '17 5 * * * /usr/local/sbin/nodeforge-govblock-update >> /var/log/nodeforge-govblock.log 2>&1' ) | crontab -
    log "Восстановил cron для РФ-госсетей (ежедневно 05:17)."
  fi

  # --- показать, что всё обновляется само ---
  echo
  info "Автообновление (работает само, по расписанию):"
  echo "   ${GRY}— cron-задания:${RST}"
  crontab -l 2>/dev/null | grep -E 'update-geo|govblock' | sed 's/^/      /' || echo "      (нет)"
  echo "   ${GRY}— systemd-таймеры node-accelerator (блоклисты/fleet):${RST}"
  systemctl list-timers --all 2>/dev/null | grep -E 'na-blocklist|na-fleet' | sed 's/^/      /' || echo "      (нет)"
  echo
  ok "Готово."
}


# ============================================================================
#  k)  СЛУЖЕБНЫЕ ПОРТЫ — ТОЛЬКО ДЛЯ ПАНЕЛИ  (порт ноды + PANEL_PORTS, напр. beszel)
# ----------------------------------------------------------------------------
#  Порт ноды нужен только панели, порт агента beszel — только хабу рядом с ней.
#  Своя nft-таблица + systemd-юнит: не зависит от na_filter (сейфти и rollback
#  node-accelerator её не снимают) и не обходится netbird'ом (см. runtime).
# ============================================================================
PANEL_ONLY_BIN="/usr/local/sbin/nodeforge-panel-only"

_panel_only_write_runtime() {
  cat > "$PANEL_ONLY_BIN" <<'EOS'
#!/bin/bash
# nodeforge panel-only — служебные порты (порт ноды + PANEL_PORTS, напр. beszel)
# принимают соединения только с PANEL_IPS. Читает /etc/nodeforge/firewall.env.
# Хук prerouting, а не input: netbird в nftables-режиме вставляет
# `iifname "wt0" accept` в начало всех input-цепочек и обнулил бы фильтр.
set -eu
ENV=/etc/nodeforge/firewall.env
[ -f "$ENV" ] && . "$ENV"
list() { printf '%s\n' "$@" | tr ', ' '\n\n' | sed '/^$/d' | sort -u | paste -sd, ; }
ports="$(list "${NODE_PORT:-}" "${PANEL_PORTS:-}")"
ips="$(list "${PANEL_IPS:-}")"
if [ -z "$ports" ] || [ -z "$ips" ]; then
  nft delete table inet nodeforge_panel_only 2>/dev/null || true
  echo "panel-only: не заданы PANEL_IPS или порты — фильтр снят"
  exit 0
fi
nft -f - <<NFT
table inet nodeforge_panel_only
delete table inet nodeforge_panel_only
table inet nodeforge_panel_only {
	chain pre {
		type filter hook prerouting priority -150; policy accept;
		tcp dport { ${ports} } fib daddr type local ip saddr { ${ips} } accept
		tcp dport { ${ports} } fib daddr type local iifname != "lo" counter drop
	}
}
NFT
echo "panel-only: порты ${ports} открыты только для ${ips}"
EOS
  chmod 755 "$PANEL_ONLY_BIN"
  cat > /etc/systemd/system/nodeforge-panel-only.service <<'EOS'
[Unit]
Description=nodeforge: service ports reachable only from the panel
After=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/nodeforge-panel-only
ExecStop=/usr/sbin/nft delete table inet nodeforge_panel_only

[Install]
WantedBy=multi-user.target
EOS
  systemctl daemon-reload
}

# "a,b/cidr,…" — только IPv4 и подсети: правило пишется для `ip saddr`.
_valid_ipv4_list() {
  local x
  [ -n "$1" ] || return 1
  for x in ${1//,/ }; do
    [[ "$x" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}(/([0-9]|[12][0-9]|3[0-2]))?$ ]] || return 1
  done
}

# Кто сейчас держит соединение с портом ноды — это и есть панель.
_panel_peers() {
  ss -Htn state established "( sport = :${1} )" 2>/dev/null \
    | awk '{print $4}' | sed -E 's/^\[?(::ffff:)?//; s/\]?:[0-9]+$//' \
    | grep -E '^[0-9.]+$' | sort -u | paste -sd, || true
}

# Спросить IP панели (подсказка — кто сейчас подключён к порту ноды) и сохранить в реестр.
_ask_panel_ips() {
  local node_port="$1" peers ips p
  peers="$(_panel_peers "$node_port")"
  if [ -n "$peers" ]; then info "Сейчас к порту ноды ${node_port} подключены: ${peers} — это панель."; fi
  while true; do
    ask ips "IP панели — только ей можно на порт ноды и beszel (через запятую; «-» — не ограничивать)" "${PANEL_IPS:-$peers}"
    ips="${ips// /}"
    if [ "$ips" = "-" ]; then ips=""; break; fi
    if _valid_ipv4_list "$ips"; then break; fi
    warn "Нужны IPv4-адреса или подсети через запятую, напр. 100.109.8.19 (netbird-IP, если панель ходит по netbird)."
  done
  if [ -z "$ips" ]; then
    warn "Без IP панели порт ноды${PANEL_PORTS:+ и ${PANEL_PORTS}} остаются доступны всем, кого пропускает na_filter."
  fi
  for p in ${peers//,/ }; do
    if [ -n "$ips" ] && [[ ",${ips}," != *",${p},"* ]]; then
      warn "Панель сейчас подключена с ${p}, а его нет в списке — нода уйдёт в offline."
      confirm "Всё равно сохранить?" || return 1
    fi
  done
  fw_set PANEL_IPS "$ips"
}

# Все PANEL_IPS уже в whitelist na_filter? (если na_filter не загружен — да, мешать некому)
_panel_in_na_whitelist() {
  local ip
  nft list table inet na_filter >/dev/null 2>&1 || return 0
  for ip in ${PANEL_IPS//,/ }; do
    nft get element inet na_filter whitelist_v4 "{ ${ip} }" >/dev/null 2>&1 || return 1
  done
}

# Поставить/обновить фильтр по реестру (идемпотентно, переживает ребут).
panel_only_apply() {
  local ports
  fw_load
  ports="$(_merge_ports "${NODE_PORT:-2222}" "${PANEL_PORTS:-}")"
  _panel_only_write_runtime
  systemctl enable --quiet nodeforge-panel-only.service
  systemctl restart nodeforge-panel-only.service
  if [ -z "${PANEL_IPS:-}" ]; then
    warn "PANEL_IPS не задан — порты ${ports} открыты всем, кого пропускает na_filter (пункт «k»)."
    return 0
  fi
  ok "Порты ${ports} принимают соединения только с ${PANEL_IPS}."
  if ! _panel_in_na_whitelist; then
    warn "Панели нет в whitelist na_filter: если она ходит не через netbird, na_filter отбросит её раньше."
    warn "Добавит её туда пункт «f) Починить фаервол»."
  fi
}

block_panel_only() {
  fw_load
  info "Порт ноды ${NODE_PORT} и PANEL_PORTS (${PANEL_PORTS:-пусто}) будут принимать соединения только с адресов панели."
  _ask_panel_ips "${NODE_PORT:-2222}" || { warn "Отменено."; return 1; }
  panel_only_apply
}


# ============================================================================
#  m)  MTU  (путь до интернета уже, чем MTU интерфейса)
# ----------------------------------------------------------------------------
#  У части хостеров трафик идёт через туннель (GRE и т.п.), и путь пропускает
#  меньше 1500 байт, а интерфейс остаётся 1500. Тогда каждый новый поток теряет
#  первый большой пакет и ждёт ICMP «frag needed»; где ICMP режут — висит совсем.
# ============================================================================
MTU_TARGETS="1.1.1.1 8.8.8.8 77.88.8.8 9.9.9.9"

# Пройдёт ли до $1 пакет размером $2 (с заголовками IP+ICMP) без фрагментации.
_df_ping() { ping -Mdo -c2 -i0.3 -W1 -q -s $(( $2 - 28 )) "$1" >/dev/null 2>&1; }

# Путь MTU до $1 в пределах [1280, $2]: бинарный поиск. Код 1 — цель молчит.
_path_mtu() {
  local host="$1" lo=1280 hi="$2" mid
  _df_ping "$host" "$lo" || return 1
  if _df_ping "$host" "$hi"; then echo "$hi"; return 0; fi
  while [ $(( hi - lo )) -gt 1 ]; do
    mid=$(( (lo + hi) / 2 ))
    if _df_ping "$host" "$mid"; then lo=$mid; else hi=$mid; fi
  done
  echo "$lo"
}

# Меряет путь до MTU_TARGETS. Итог — в MTU_IFACE / MTU_CUR / MTU_PATH (минимум по целям).
mtu_probe() {
  local t m
  MTU_IFACE="$(_default_iface)"
  MTU_CUR="" MTU_PATH=""
  [ -n "$MTU_IFACE" ] || return 1
  MTU_CUR="$(cat "/sys/class/net/${MTU_IFACE}/mtu")"
  for t in $MTU_TARGETS; do
    if m="$(_path_mtu "$t" "$MTU_CUR")"; then
      printf '   %-10s путь MTU %s\n' "$t" "$m"
      if [ -z "$MTU_PATH" ] || [ "$m" -lt "$MTU_PATH" ]; then MTU_PATH="$m"; fi
    else
      printf '   %-10s %sне отвечает на ping%s\n' "$t" "$GRY" "$RST"
    fi
  done
  [ -n "$MTU_PATH" ]
}

# Кто поднимает интерфейс — туда MTU и пишем, чтобы пережил ребут.
# Печатает «ifupdown <файл>», «netplan <id>», «networkd <.network>» или «unit».
_net_backend() {
  local ifc="$1" f nf
  if systemctl is-enabled --quiet networking.service 2>/dev/null; then
    for f in /etc/network/interfaces /etc/network/interfaces.d/*; do
      [ -f "$f" ] || continue
      if grep -qE "^[[:space:]]*iface[[:space:]]+${ifc}[[:space:]]" "$f"; then echo "ifupdown $f"; return 0; fi
    done
  fi
  nf="$(networkctl status "$ifc" 2>/dev/null | awk -F': ' '/Network File:/ {print $2; exit}' || true)"
  case "$nf" in
    /run/systemd/network/10-netplan-*.network)
      nf="${nf##*/10-netplan-}"; echo "netplan ${nf%.network}"; return 0 ;;
    /etc/systemd/network/*|/usr/lib/systemd/network/*|/lib/systemd/network/*)
      echo "networkd ${nf}"; return 0 ;;
  esac
  echo "unit"
}

_mtu_persist() {
  local ifc="$1" mtu="$2" kind="$3" where="$4" bak=/root/nodeforge-bak tmp name
  mkdir -p "$bak"
  case "$kind" in
    ifupdown)
      cp -a "$where" "${bak}/$(basename "$where").$(date +%F-%H%M)"
      tmp="$(mktemp)"
      # mtu — первой строкой стансы интерфейса; прежние mtu в ней убираем.
      awk -v ifc="$ifc" -v mtu="$mtu" '
        $1 == "iface" { in_s = ($2 == ifc); print; if (in_s) print "    mtu " mtu; next }
        /^[^[:space:]#]/ { in_s = 0 }
        in_s && $1 == "mtu" { next }
        { print }' "$where" > "$tmp"
      cat "$tmp" > "$where"
      rm -f "$tmp"
      if ! ifquery "$ifc" 2>/dev/null | grep -qx "mtu: ${mtu}"; then
        err "ifquery не видит mtu ${mtu} в ${where} — проверь вручную (бэкап в ${bak})."; return 1
      fi
      ;;
    netplan)
      cp -a /etc/netplan "${bak}/netplan.$(date +%F-%H%M)"
      netplan set "ethernets.${where}.mtu=${mtu}"
      netplan generate
      ;;
    networkd)
      name="$(basename "$where")"
      install -d "/etc/systemd/network/${name}.d"
      printf '[Link]\nMTUBytes=%s\n' "$mtu" > "/etc/systemd/network/${name}.d/nodeforge-mtu.conf"
      ;;
    unit)
      cat > /etc/systemd/system/nodeforge-mtu.service <<EOS
[Unit]
Description=nodeforge: MTU ${mtu} on ${ifc} (path MTU of the provider)
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=$(command -v ip) link set ${ifc} mtu ${mtu}

[Install]
WantedBy=multi-user.target
EOS
      systemctl daemon-reload
      systemctl enable --quiet nodeforge-mtu.service
      ;;
  esac
}

block_mtu() {
  local ifc cur path kind where ipbin
  info "Меряю путь MTU: ping с запретом фрагментации до ${MTU_TARGETS// /, }…"
  mtu_probe || { err "Ни одна контрольная точка не ответила на ping — путь MTU не измерить."; return 1; }
  ifc="$MTU_IFACE"; cur="$MTU_CUR"; path="$MTU_PATH"
  if [ "$path" -ge "$cur" ]; then
    ok "Интерфейс ${ifc}: MTU ${cur}, путь пропускает столько же — менять нечего."
    return 0
  fi
  warn "Путь пропускает ${path} байт, а ${ifc} шлёт по ${cur}: каждое новое направление теряет первый большой пакет."
  read -r kind where <<<"$(_net_backend "$ifc")"
  info "Интерфейс настраивает: ${kind}${where:+ (${where})}"
  confirm "Выставить MTU ${path} на ${ifc} — сейчас и после перезагрузки?" || { warn "Отменено."; return 1; }
  ipbin="$(command -v ip)"
  # Страховка: если связь пропадёт (скрипт умрёт вместе с SSH) — через 3 минуты MTU вернётся.
  systemctl stop nodeforge-mtu-revert.timer 2>/dev/null || true
  systemd-run --quiet --unit=nodeforge-mtu-revert --on-active=180 "$ipbin" link set "$ifc" mtu "$cur"
  "$ipbin" link set "$ifc" mtu "$path"
  sleep 2
  if ! curl -fsS -m 10 -o /dev/null https://www.cloudflare.com/cdn-cgi/trace; then
    err "После смены MTU HTTPS наружу не работает — возвращаю ${cur}."
    "$ipbin" link set "$ifc" mtu "$cur"
    systemctl stop nodeforge-mtu-revert.timer 2>/dev/null || true
    return 1
  fi
  _mtu_persist "$ifc" "$path" "$kind" "$where"
  systemctl stop nodeforge-mtu-revert.timer 2>/dev/null || true
  ok "MTU ${ifc} = ${path} — сейчас и после перезагрузки. Живые соединения не рвутся."
}


# ============================================================================
#  a)  АУДИТ НОДЫ  (проверка — только чтение; в конце — починка по выбору)
# ----------------------------------------------------------------------------
#  Ловит то, что тихо портит ноду и не видно в панели: путь MTU уже интерфейса,
#  фризы ВМ у хостера, «чужая» страна по GeoIP, кривые маршруты, слетевший
#  фаервол (сработал сейфти), открытый всем порт ноды, сломанный logrotate,
#  мёртвые location в nginx, истекающий сертификат. Сама проверка ничего не
#  меняет: найденное, что лечится со стороны сервера, она заносит в список
#  исправлений, и в конце можно выбрать, что починить.
# ============================================================================
_a_ok()   { ok "$*"; }
_a_warn() { AUD_WARN=$(( AUD_WARN + 1 )); warn "$*"; }
_a_fail() { AUD_FAIL=$(( AUD_FAIL + 1 )); err "$*"; }
_a_hint() { printf '    %s→ %s%s\n' "$GRY" "$*" "$RST" >&2; }

# _a_fix "что сделать" <простой: 0 нет | 1 короткий обрыв | 2 перезагрузка> функция [аргумент]
_a_fix() {
  local i
  for i in "${!AUD_FIX_FN[@]}"; do
    if [ "${AUD_FIX_FN[$i]}" = "$3" ] && [ "${AUD_FIX_ARG[$i]}" = "${4:-}" ]; then return 0; fi
  done
  AUD_FIX_DESC+=("$1"); AUD_FIX_COST+=("$2"); AUD_FIX_FN+=("$3"); AUD_FIX_ARG+=("${4:-}"); AUD_FIX_STATE+=("")
}

# ----- Исправления, которые предлагает аудит -----
# (там, где есть пункт меню, аудит зовёт его: apply_firewall, block_panel_only, block_mtu…)

_fix_ufw() {
  fw_neutralize_ufw
  if ufw status 2>/dev/null | grep -qi '^Status: active'; then err "ufw всё ещё включён."; return 1; fi
  ok "ufw выключен — остался один фаервол (na_filter)."
}

_fix_ntp() {
  timedatectl set-ntp true
  sleep 5
  if [ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null)" = yes ]; then ok "Часы синхронизированы."
  else warn "Синхронизация включена, но ещё не прошла — проверь через минуту: timedatectl"; fi
}

# Последние ошибки ротации из журнала: dry-run (logrotate -d) ловит только ошибки конфига.
_logrotate_last_errors() {
  journalctl -u logrotate.service -u na-logrotate.service -n 300 --no-pager -o cat 2>/dev/null \
    | grep -vE '^(Starting|Started|Finished|Failed to start|.*\.service: )' | grep -v '^$' | tail -4 || true
}

# Прогнать ротацию сейчас — так видно, чинится ли она. zstd доставим, если станза его ждёт.
_fix_logrotate_run() {
  local big
  if grep -rqs 'compresscmd /usr/bin/zstd' /etc/logrotate.d/ && [ ! -x /usr/bin/zstd ]; then
    log "Станза сжимает через zstd, а его нет — ставлю."
    wait_for_apt
    apt-get install -y zstd
  fi
  systemctl reset-failed logrotate.service na-logrotate.service 2>/dev/null || true
  big="$(find /var/log/remnanode -maxdepth 1 -name '*.log' -size +500M 2>/dev/null | head -1 || true)"
  if [ -n "$big" ]; then
    # logrotate.service идёт с Nice=19: xray процессор не отдаст, но сжатие гигабайт — надолго.
    warn "$(du -h "$big" | cut -f1) в ${big}: сжатие займёт до получаса. Запускаю в фоне с низким приоритетом."
    systemctl start --no-block logrotate.service
    info "Итог покажет повторный аудит (a) или: systemctl status logrotate"
    return 0
  fi
  if systemctl start logrotate.service; then
    ok "logrotate отработал без ошибок."
  else
    err "logrotate снова упал:"
    _logrotate_last_errors | sed 's/^/   /' >&2
    return 1
  fi
}

_fix_logrotate_dup() {
  _logrotate_release_dir /var/log/remnanode/ /etc/logrotate.d/remnanode
  _fix_logrotate_run
}

# Логи ноды хранятся бессрочно (rotate 9999) — ограничить числом дней.
_fix_log_retention() {
  local days f=/etc/logrotate.d/remnanode
  while true; do
    ask days "Сколько дней хранить логи ноды" "30"
    if is_uint "$days" && [ "$days" -ge 1 ]; then break; fi
    warn "Нужно число дней, например 30."
  done
  cp -a "$f" "/root/logrotate.remnanode.bak-$(date +%F-%H%M)"
  sed -i -E "s/^([[:space:]]*rotate[[:space:]]+)[0-9]+/\1${days}/" "$f"
  if logrotate -d /etc/logrotate.conf 2>&1 | grep -qE '^error'; then
    err "После правки logrotate видит ошибки — бэкап в /root/logrotate.remnanode.bak-*."
    return 1
  fi
  ok "Логи ноды хранятся ${days} дн.; архивы старше logrotate удалит при ближайшей ротации."
}

_fix_node_rename() {
  require_node
  docker rename "$1" "$NODE_CONTAINER"
  ok "Контейнер переименован: $1 → ${NODE_CONTAINER} (без перезапуска)."
}

# Привести контейнер ноды к compose (docker compose up -d): пересоздаётся, только если
# конфиг отличается, — обрыв клиентов ~10 с. Затем сверка имени и SNI_VERIFICATION.
_fix_node_recreate() {
  local ctr sni want
  require_node
  ( cd "$NODE_DIR" && docker compose up -d )
  sleep 3
  ctr="$(docker ps -a --format '{{.Names}}' | grep -E "(^|_)${NODE_CONTAINER}\$" | head -1 || true)"
  if [ -n "$ctr" ] && [ "$ctr" != "$NODE_CONTAINER" ]; then _fix_node_rename "$ctr"; fi
  want="$(grep -oE 'SNI_VERIFICATION=[a-z]+' "${NODE_DIR}/docker-compose.yml" 2>/dev/null | head -1 | cut -d= -f2 || true)"
  sni="$(node_env_value SNI_VERIFICATION || true)"
  if [ -n "$want" ] && [ "$sni" != "$want" ]; then
    err "В контейнере SNI_VERIFICATION=${sni:-<пусто>}, в compose ${want} — проверь вручную."; return 1
  fi
  ok "Контейнер ноды соответствует compose. Проверь в панели, что нода online."
}

# Убрать location, который ведёт в несуществующий сокет $1 (nginx -t + откат).
_fix_dead_location() {
  local sock="$1" f path ngx tmp
  require_node
  f="${NODE_DIR}/nginx.conf"
  path="$(awk -v sock="unix:${sock};" '
    match($0, /location[[:space:]]+\/[^\/[:space:]]+\//) {
      p = substr($0, RSTART, RLENGTH); sub(/^location[[:space:]]+\//, "", p); sub(/\/$/, "", p)
    }
    index($0, sock) && p != "" { print p; exit }' "$f")"
  if [ -z "$path" ]; then err "Не нашёл location с ${sock} в ${f}."; return 1; fi
  ngx="$(_nginx_container)"
  if [ -z "$ngx" ]; then err "Не нашёл nginx-контейнер."; return 1; fi
  cp -a "$f" "${f}.bak"
  tmp="$(mktemp)"
  _nginx_strip_location "$path" "${f}.bak" > "$tmp"
  cat "$tmp" > "$f"   # на месте: файл примонтирован в контейнер по inode
  rm -f "$tmp"
  if docker exec "$ngx" nginx -t; then
    docker restart "$ngx" >/dev/null
    ok "location /${path}/ убран (бэкап: ${f}.bak), nginx перезапущен."
  else
    err "nginx -t не прошёл — возвращаю ${f}."
    cat "${f}.bak" > "$f"
    return 1
  fi
}

# Свой sysctl-файл: сортируется после node-accelerator и /etc/sysctl.conf, переживает ребут.
NF_SYSCTL=/etc/sysctl.d/99-zz-nodeforge.conf

_sysctl_persist() {
  local k="$1" v="$2" re="${1//./\\.}"
  touch "$NF_SYSCTL"
  if grep -qE "^${re}[[:space:]]*=" "$NF_SYSCTL"; then
    sed -i -E "s|^${re}[[:space:]]*=.*|${k} = ${v}|" "$NF_SYSCTL"
  else
    printf '%s = %s\n' "$k" "$v" >> "$NF_SYSCTL"
  fi
  sysctl -q -w "${k}=${v}"
}

_fix_ct_timeout() {
  _sysctl_persist net.netfilter.nf_conntrack_tcp_timeout_established 7440
  ok "conntrack держит простаивающие TCP 2 ч 04 мин (${NF_SYSCTL})."
}

# Потолок conntrack по памяти: запись ~320 байт, таблица растёт по мере надобности.
_ct_max_target() {
  local mb
  mb="$(awk '/^MemTotal:/ { print int($2 / 1024) }' /proc/meminfo)"
  if [ "${mb:-0}" -ge 1500 ]; then echo 262144; else echo 131072; fi
}

_fix_ct_max() {
  local v
  v="$(_ct_max_target)"
  _sysctl_persist net.netfilter.nf_conntrack_max "$v"
  ok "Потолок conntrack: ${v} (${NF_SYSCTL})."
}

_fix_disable_ipv6() {
  _sysctl_persist net.ipv6.conf.all.disable_ipv6 1
  _sysctl_persist net.ipv6.conf.default.disable_ipv6 1
  ok "IPv6 выключен (${NF_SYSCTL}): сайты открываются по IPv4 без ожидания IPv6."
}

# Время резолва домена через системный резолвер (им пользуется Xray), мс; пусто — не резолвится.
_dns_ms() {
  local t0 t1
  t0="${EPOCHREALTIME/,/.}"   # в части локалей разделитель — запятая
  resolvectl query --cache=no "$1" >/dev/null 2>&1 || return 1
  t1="${EPOCHREALTIME/,/.}"
  awk -v a="$t0" -v b="$t1" 'BEGIN { printf "%d", (b - a) * 1000 }'
}

AUD_DNS_NAMES="google.com telegram.org wikipedia.org cloudflare.com"

_fix_dns() {
  local d ms
  install -d /etc/systemd/resolved.conf.d
  cat > /etc/systemd/resolved.conf.d/nodeforge-dns.conf <<'EOS'
# nodeforge: резолвер ноды — Cloudflare/Google, а не DNS хостера.
# Domains=~. — все запросы идут сюда; узкие домены netbird остаются на wt0.
[Resolve]
DNS=1.1.1.1 8.8.8.8
FallbackDNS=9.9.9.9
Domains=~.
EOS
  systemctl restart systemd-resolved
  sleep 1
  for d in $AUD_DNS_NAMES; do
    if ms="$(_dns_ms "$d")"; then printf '   %-16s %s мс\n' "$d" "$ms"; else err "${d}: не резолвится"; return 1; fi
  done
  ok "Резолвер ноды: 1.1.1.1, 8.8.8.8 (/etc/systemd/resolved.conf.d/nodeforge-dns.conf)."
}

_fix_netbird_restart() {
  systemctl restart netbird
  sleep 8
  if netbird status 2>/dev/null | grep -q 'Management: Connected'; then ok "netbird подключён."
  else err "netbird не подключился — проверь: netbird status"; return 1; fi
}

_fix_nginx_restart() {
  local ngx
  ngx="$(_nginx_container)"
  if [ -z "$ngx" ]; then err "Не нашёл nginx-контейнер."; return 1; fi
  docker restart "$ngx" >/dev/null
  sleep 2
  ok "nginx (${ngx}) перезапущен — запусти аудит ещё раз, чтобы проверить маскировку."
}

# Путь к ini с ключами Cloudflare из renewal-конфига certbot.
_cf_ini() { awk -F' *= *' '$1 == "dns_cloudflare_credentials" {print $2}' "$1"; }

# Сертификаты certbot (имена), которые продлеваются через ini $1.
_cf_certs_for_ini() {
  grep -l "^dns_cloudflare_credentials *= *${1}\$" /etc/letsencrypt/renewal/*.conf 2>/dev/null \
    | xargs -r -n1 basename | sed 's/\.conf$//' | paste -sd' ' || true
}

# Что сейчас лежит в ini: токен, глобальный ключ или ничего.
_cf_ini_kind() {
  if [ ! -s "$1" ]; then echo "файла нет"
  elif grep -q '^[[:space:]]*dns_cloudflare_api_token' "$1"; then echo "API-токен"
  else echo "глобальный ключ (email + api_key) — продление с ним падает"; fi
}

# Запрос к API Cloudflare с токеном из $CF_TOKEN; заголовок — через stdin, не в argv.
_cf_api() {
  curl -fsS -m 10 -H @- "https://api.cloudflare.com/client/v4/$1" <<<"Authorization: Bearer ${CF_TOKEN}"
}

# Спросить API-токен (скрытый ввод), проверить в Cloudflare и записать в ini $1 (600).
# До записи: токен активен и видит зоны всех сертификатов этого ini. Старый ключ на диск
# не бэкапим — в нём может быть ключ ко всему аккаунту Cloudflare.
_cf_token_set() {
  local ini="$1" names zones n d uncovered="" CF_TOKEN
  names="$(_cf_certs_for_ini "$ini")"
  info "Токен: Cloudflare → My Profile → API Tokens → Create Token → шаблон «Edit zone DNS»; зоны сертификатов: ${names:-?}."
  info "Если на другой ноде этих зон продление работает — подходящий токен лежит там в ${ini}."
  read -rsp "API-токен Cloudflare (ввод скрыт): " CF_TOKEN; echo
  if [ -z "$CF_TOKEN" ]; then warn "Токен не введён — ничего не менял."; return 1; fi
  if ! _cf_api user/tokens/verify 2>/dev/null | grep -q '"status":"active"'; then
    err "Cloudflare не принимает токен (неверный, отозван или истёк) — ничего не менял."; return 1
  fi
  zones="$(_cf_api 'zones?per_page=50' 2>/dev/null \
    | python3 -c 'import json,sys; print("\n".join(z["name"] for z in json.load(sys.stdin).get("result", [])))' 2>/dev/null || true)"
  for n in $names; do
    for d in $(openssl x509 -noout -ext subjectAltName -in "/etc/letsencrypt/live/${n}/cert.pem" 2>/dev/null \
                 | grep -oE 'DNS:[^, ]+' | sed 's/^DNS://; s/^\*\.//' | sort -u || true); do
      if ! printf '%s\n' "$zones" | awk -v d="$d" 'd == $0 || substr(d, length(d) - length($0)) == "." $0 { f = 1 } END { exit !f }'; then
        uncovered="${uncovered:+${uncovered} }${d}"
      fi
    done
  done
  if [ -n "$uncovered" ]; then
    warn "Токен активен, но не видит зоны для: ${uncovered} — продление этих имён упадёт."
    confirm "Записать токен всё равно?" || { warn "Не записал."; return 1; }
  else
    ok "Токен активен и видит зоны: $(printf '%s\n' "$zones" | paste -sd' ')"
  fi
  install -d -m 700 "$(dirname "$ini")"
  ( umask 077; printf 'dns_cloudflare_api_token = %s\n' "$CF_TOKEN" > "$ini" )
  chmod 600 "$ini"
  ok "Токен записан в ${ini}."
}

# ============================================================================
#  c)  СЕРТИФИКАТ НОДЫ — одно действие на всё
# ----------------------------------------------------------------------------
#  Состояние → токен Cloudflare (обязательно при глобальном ключе, по желанию —
#  сменить) → хук рестарта nginx → таймер certbot → продление (если пора или
#  попросили) либо проверка вхолостую → nginx отдаёт ровно тот сертификат, что
#  на диске. Этим же зовётся исправление из аудита.
# ============================================================================

# Хук-файл certbot: вызывается после каждого продления и, в отличие от строки
# deploy_hook в renewal-конфиге, не теряется, когда certbot этот конфиг переписывает.
NF_CERT_HOOK=/etc/letsencrypt/renewal-hooks/deploy/nodeforge-restart-nginx.sh

_cert_hook_ok() {
  [ -x "$NF_CERT_HOOK" ] || grep -qE '^(deploy_hook|renew_hook)[[:space:]]*=' "$1" 2>/dev/null
}

_cert_hook_ensure() {
  local ngx
  ngx="$(_nginx_container)"
  if [ -z "$ngx" ]; then warn "Не нашёл nginx-контейнер — хук после продления не ставлю."; return 0; fi
  install -d /etc/letsencrypt/renewal-hooks/deploy
  cat > "$NF_CERT_HOOK" <<EOS
#!/bin/sh
# nodeforge: nginx ноды держит сертификат файлом по симлинку live/ и без рестарта
# отдаёт старый. certbot вызывает этот файл после каждого успешного продления.
$(command -v docker) restart ${ngx} >/dev/null 2>&1 || true
EOS
  chmod 755 "$NF_CERT_HOOK"
  ok "После продления certbot перезапустит ${ngx} (${NF_CERT_HOOK})."
}

# Дней до истечения сертификата $1 (отрицательное — уже истёк).
_cert_days() {
  local end
  end="$(openssl x509 -enddate -noout -in "$1" 2>/dev/null | cut -d= -f2 || true)"
  echo $(( ( $(date -d "${end:-now}" +%s) - $(date +%s) ) / 86400 ))
}

# Сертификат на диске и тот, что реально отдаёт nginx, — разные? Тогда рестарт nginx.
_cert_nginx_sync() {
  local cert="$1" ngx live served
  ngx="$(_nginx_container)"
  if [ -z "$ngx" ]; then return 0; fi
  live="$(openssl x509 -noout -fingerprint -sha256 -in "$cert" 2>/dev/null || true)"
  served="$(docker exec "$ngx" sh -c 'cat /etc/nginx/ssl/*/fullchain.pem' 2>/dev/null \
    | openssl x509 -noout -fingerprint -sha256 2>/dev/null || true)"
  if [ "$live" != "$served" ]; then
    docker restart "$ngx" >/dev/null
    ok "nginx (${ngx}) перезапущен — отдаёт сертификат с диска."
  fi
}

# certbot renew; упало — предложить сменить токен и повторить. $3=force — досрочно.
_cert_renew() {
  local name="$1" ini="$2"
  local -a args=(renew --cert-name "$name")
  if [ "${3:-}" = force ]; then args+=(--force-renewal); fi
  log "Продлеваю ${name} (DNS-01 через Cloudflare, 1–2 мин)."
  if ! certbot "${args[@]}"; then
    if [ -z "$ini" ] || ! confirm "Продление упало. Сменить токен Cloudflare и попробовать ещё раз?"; then return 1; fi
    _cf_token_set "$ini"
    certbot "${args[@]}"
  fi
}

cert_maintain() {
  local cert="$1" name conf ini days
  name="$(basename "$(dirname "$cert")")"
  conf="/etc/letsencrypt/renewal/${name}.conf"
  if [ ! -f "$conf" ]; then
    err "Сертификат ${name} здесь не выпускался certbot'ом (нет ${conf}) — положи свежий оттуда, где он продлевается, и перезапусти nginx."
    return 1
  fi
  days="$(_cert_days "$cert")"
  if [ "$days" -lt 0 ]; then info "Сертификат ${name}: истёк $(( -days )) дн. назад."
  else info "Сертификат ${name}: действителен ещё ${days} дн."; fi

  ini="$(_cf_ini "$conf")"
  if [ -n "$ini" ]; then
    info "Ключ Cloudflare (${ini}): $(_cf_ini_kind "$ini")"
    if ! grep -q '^[[:space:]]*dns_cloudflare_api_token' "$ini" 2>/dev/null; then
      _cf_token_set "$ini"
    elif confirm "Сменить токен Cloudflare?"; then
      _cf_token_set "$ini"
    fi
  fi
  if ! _cert_hook_ok "$conf"; then _cert_hook_ensure; fi
  if ! systemctl is-enabled --quiet certbot.timer 2>/dev/null; then
    systemctl enable --now certbot.timer
    ok "Автопродление по таймеру (certbot.timer) включено."
  fi

  if [ "$days" -lt 30 ]; then
    _cert_renew "$name" "$ini"
  elif confirm "Продлевать рано (ещё ${days} дн.) — продлить принудительно сейчас?"; then
    _cert_renew "$name" "$ini" force
  else
    log "Проверяю продление вхолостую (certbot --dry-run, 1–2 мин: ждёт DNS)."
    if certbot renew --cert-name "$name" --dry-run --quiet; then ok "Автопродление работает (проверено вхолостую)."
    else err "Продление вхолостую упало — см. вывод выше; частая причина — токен Cloudflare."; return 1; fi
  fi
  _cert_nginx_sync "$cert"
  days="$(_cert_days "$cert")"
  if [ "$days" -lt 1 ]; then err "Сертификат ${name} так и не обновился — см. вывод certbot выше."; return 1; fi
  ok "Сертификат ${name} действителен ещё ${days} дн.; автопродление настроено."
}

# Сертификат ноды — тот, что монтирует nginx из compose; иначе — выбор из certbot.
block_cert() {
  local cert name
  local -a names
  cert="$(grep -ohE '/etc/letsencrypt/live/[^:]+/fullchain\.pem' /opt/remnanode/docker-compose.yml /opt/remnawave/docker-compose.yml 2>/dev/null | head -1 || true)"
  if [ -z "$cert" ]; then
    mapfile -t names < <(find /etc/letsencrypt/renewal -maxdepth 1 -name '*.conf' -printf '%f\n' 2>/dev/null | sed 's/\.conf$//')
    if [ "${#names[@]}" -eq 0 ]; then err "Сертификатов certbot на этой ноде нет."; return 1; fi
    if [ "${#names[@]}" -eq 1 ]; then name="${names[0]}"
    else choose_from_list name "Какой сертификат?" "" "${names[@]}"; fi
    cert="/etc/letsencrypt/live/${name}/fullchain.pem"
  fi
  cert_maintain "$cert"
}

# Подтянуть свежий образ ноды и пересоздать контейнер (обрыв ~10 с).
_fix_node_update() {
  require_node
  ( cd "$NODE_DIR" && docker compose pull "$NODE_SERVICE" )
  _fix_node_recreate
}

# compressoptions в кавычках → logrotate отдаёт их zstd буквально, сжатие падает.
# Правим станзу и дожимаем уже накопившиеся несжатые логи в фоне.
_fix_logrotate_opts() {
  local f=/etc/logrotate.d/remnanode x n=0
  cp -a "$f" "/root/logrotate.remnanode.bak-$(date +%F-%H%M)"
  sed -i -E '/^[[:space:]]*compressoptions/ { s/"//g; s/[[:space:]]+--rm//g }' "$f"
  for x in /var/log/remnanode/*.log-[0-9]*; do
    case "$x" in *.zst|*.gz) continue ;; esac
    if [ -f "$x" ]; then n=$(( n + 1 )); fi
  done
  if [ "$n" -gt 0 ]; then
    systemctl stop nodeforge-zstd-backlog 2>/dev/null || true
    systemd-run --quiet --unit=nodeforge-zstd-backlog --nice=19 -p IOSchedulingClass=idle \
      /bin/sh -c 'for x in /var/log/remnanode/*.log-[0-9]*; do case "$x" in *.zst|*.gz) continue ;; esac; [ -f "$x" ] && zstd -q -19 --rm "$x"; done'
    info "Дожимаю ${n} несжатых логов в фоне (низкий приоритет): systemctl status nodeforge-zstd-backlog"
  fi
  _fix_logrotate_run
}

# Лимиты na_filter на один IP: за CGNAT мобильного оператора сидят сотни абонентов.
_fix_na_limits() {
  local cur_conn cur_syn nc ns conf=/etc/node-accelerator/protect.conf
  fw_load
  cur_conn="${CONN_LIMIT:-$(grep -oE 'CONN_LIMIT:=[0-9]+' "$conf" 2>/dev/null | cut -d= -f2 || true)}"
  cur_syn="${SYN_RATE:-$(grep -oE 'SYN_RATE:=[0-9]+' "$conf" 2>/dev/null | cut -d= -f2 || true)}"
  cur_conn="${cur_conn:-2048}"; cur_syn="${cur_syn:-200}"
  while true; do
    ask nc "Макс. одновременных соединений с одного IP (сейчас ${cur_conn})" "$(( cur_conn * 4 ))"
    ask ns "Новых соединений в секунду с одного IP (сейчас ${cur_syn})" "$(( cur_syn * 2 ))"
    if is_uint "$nc" && is_uint "$ns" && [ "$nc" -ge 64 ] && [ "$ns" -ge 10 ]; then break; fi
    warn "Нужны числа: соединений ≥ 64, в секунду ≥ 10."
  done
  fw_set CONN_LIMIT "$nc"
  fw_set SYN_RATE "$ns"
  fw_set SYN_BURST "$(( ns * 2 ))"
  apply_firewall
}

# IP клиентов попали в бан: снять, внести в allowlist CrowdSec; автобан за скан — по желанию.
_fix_unban_clients() {
  local ip left=""
  for ip in ${1//,/ }; do
    nft delete element inet na_filter autoban_v4 "{ ${ip} }" 2>/dev/null || true
    nft delete element inet na_filter suspect_v4 "{ ${ip} }" 2>/dev/null || true
    if command -v cscli >/dev/null 2>&1; then
      cscli decisions delete --ip "$ip" >/dev/null 2>&1 || true
      if cscli allowlists list >/dev/null 2>&1; then
        cscli allowlists inspect nodeforge-clients >/dev/null 2>&1 \
          || cscli allowlists create nodeforge-clients -d "nodeforge: IP клиентов VPN" >/dev/null
        cscli allowlists add nodeforge-clients "$ip" >/dev/null 2>&1 || true
      else
        left="${left:+${left},}${ip}"
      fi
    fi
  done
  ok "Баны сняты: ${1}."
  if [ -n "$left" ]; then warn "CrowdSec без allowlists: ${left} может вернуться при синхронизации общего списка."; fi
  fw_load
  if [ "${ENABLE_PORTSCAN_BAN:-1}" != 0 ] \
     && confirm "Выключить автобан за скан портов? Он банит весь общий IP оператора из-за одного абонента"; then
    fw_set ENABLE_PORTSCAN_BAN 0
    apply_firewall
  fi
}

_fix_reboot() {
  warn "Перезагрузка оборвёт всех пользователей этой ноды примерно на минуту."
  if ! confirm "Нода снята с балансировки — перезагрузить сейчас?"; then warn "Перезагрузку отложил."; return 0; fi
  log "Перезагружаю. После — зайди снова и запусти аудит (a)."
  systemctl reboot
}

# Выполнить исправления по порядку простоя: без простоя → обрыв → перезагрузка.
_audit_fix_many() {
  local cost i rc
  for cost in 0 1 2; do
    for i in "$@"; do
      if [ "${AUD_FIX_COST[$i]}" != "$cost" ]; then continue; fi
      echo
      step "${AUD_FIX_DESC[$i]}"
      # Код возврата — отдельной строкой: под if/! bash молча выключает set -e в подоболочке.
      ( set -eo pipefail; "${AUD_FIX_FN[$i]}" ${AUD_FIX_ARG[$i]:+"${AUD_FIX_ARG[$i]}"} )
      rc=$?
      if [ "$rc" -eq 0 ]; then AUD_FIX_STATE[i]=ok
      else AUD_FIX_STATE[i]=fail; err "Не получилось: ${AUD_FIX_DESC[$i]} (код ${rc}, см. вывод выше)."; fi
    done
  done
}

_audit_fix_list() {
  local i label mark
  echo
  if [ "${#AUD_FIX_FN[@]}" -eq 0 ]; then ok "Чинить скриптом нечего."; return 0; fi
  step "Можно починить скриптом"
  for i in "${!AUD_FIX_FN[@]}"; do
    case "${AUD_FIX_COST[$i]}" in
      0) label="${GRN}без простоя${RST}" ;;
      1) label="${YLW}короткий обрыв${RST}" ;;
      *) label="${RED}перезагрузка — сними ноду с балансировки${RST}" ;;
    esac
    case "${AUD_FIX_STATE[$i]}" in
      ok)   mark="${GRN}✓ сделано${RST}  " ;;
      fail) mark="${RED}✗ не вышло${RST}  " ;;
      *)    mark="" ;;
    esac
    printf '   %s%2d)%s %s%s  — %s\n' "$BOLD" "$(( i + 1 ))" "$RST" "$mark" "${AUD_FIX_DESC[$i]}" "$label"
  done
}

# Всё несделанное, кроме исправлений функцией $1 (если задана), — в массив sel.
# Если среди выбранного есть обрыв или перезагрузка — спросить подтверждение.
_audit_pick_pending() {
  local skip="${1:-}" i brief=0 reboot=0
  for i in "${!AUD_FIX_FN[@]}"; do
    if [ -n "${AUD_FIX_STATE[$i]}" ] || [ "${AUD_FIX_FN[$i]}" = "$skip" ]; then continue; fi
    sel+=("$i")
    if [ "${AUD_FIX_COST[$i]}" = 1 ]; then brief=$(( brief + 1 )); fi
    if [ "${AUD_FIX_COST[$i]}" = 2 ]; then reboot=1; fi
  done
  if [ $(( brief + reboot )) -gt 0 ] \
     && ! confirm "Среди выбранного ${brief} исправл. с коротким обрывом$( [ "$reboot" = 1 ] && printf ' и перезагрузка' ) — выполнить?"; then
    sel=()
    return 1
  fi
}

# Есть ли в списке несделанное исправление функцией $1.
_audit_has_pending() {
  local i
  for i in "${!AUD_FIX_FN[@]}"; do
    if [ "${AUD_FIX_FN[$i]}" = "$1" ] && [ -z "${AUD_FIX_STATE[$i]}" ]; then return 0; fi
  done
  return 1
}

# Меню починки: после каждого исправления — обратно к списку, а не в главное меню.
_audit_fix_menu() {
  local i n c choice
  local -a sel
  while true; do
    _audit_fix_list
    n="${#AUD_FIX_FN[@]}"
    if [ ! -t 0 ]; then return 0; fi
    echo
    if [ "$n" -gt 0 ]; then
      echo "   ${BOLD}${GRN} a)${RST} Починить всё, что ещё не сделано"
      # location в nginx без инбаунда часто — заготовка: инбаунд включат в панели,
      # и он подхватится без рестарта nginx. Поэтому «всё, кроме них» — отдельно.
      if _audit_has_pending _fix_dead_location; then
        echo "   ${BOLD}${GRN} n)${RST} Починить всё, кроме location в nginx (заготовки под gRPC/XHTTP)"
      fi
      echo "   ${BOLD}${GRN} s)${RST} Только то, что без простоя"
    fi
    echo "   ${BOLD}${CYN} r)${RST} Провести аудит ещё раз"
    echo "   ${BOLD}${RED} 0)${RST} Выйти в главное меню"
    read -rp "Номера через пробел или буква: " choice
    sel=()
    case "$choice" in
      ""|0) return 0 ;;
      r|R|к|К) _audit_run; continue ;;
      a|A|ф|Ф) _audit_pick_pending || continue ;;
      n|N|т|Т) _audit_pick_pending _fix_dead_location || continue ;;
      s|S|ы|Ы)
        for i in "${!AUD_FIX_FN[@]}"; do
          if [ -z "${AUD_FIX_STATE[$i]}" ] && [ "${AUD_FIX_COST[$i]}" = 0 ]; then sel+=("$i"); fi
        done ;;
      *)
        for c in $choice; do
          if is_uint "$c" && [ "$c" -ge 1 ] && [ "$c" -le "$n" ]; then sel+=("$(( c - 1 ))")
          else warn "Нет пункта ${c} — пропускаю."; fi
        done ;;
    esac
    if [ "${#sel[@]}" -eq 0 ]; then warn "Нечего выполнять."; continue; fi
    _audit_fix_many "${sel[@]}"
    echo
    read -rp "Enter — вернуться к списку исправлений..." _
  done
}

# Признаки того, что ВМ стояла: ядро не получало CPU или сетевая карта не отвечала.
AUD_FREEZE_RE='soft lockup|rcu_(preempt|sched) (self-)?detected stall|rcu.*kthread starved|NETDEV WATCHDOG|TX timeout|Long readout interval|blocked for more than'

_audit_system() {
  local s1 s2 i total steal pct frz span n used ntp failed pkgs mt ma si l1 l5 u
  step "Система"
  info "$(. /etc/os-release && echo "$PRETTY_NAME") · ядро $(uname -r) · vCPU $(nproc) · RAM $(free -m | awk '/^Mem:/ {print $2}') МБ · $(uptime -p)"

  read -r -a s1 < /proc/stat; sleep 3; read -r -a s2 < /proc/stat   # cpu user nice system idle iowait irq softirq steal
  total=0
  for i in 1 2 3 4 5 6 7 8; do total=$(( total + s2[i] - s1[i] )); done
  steal=$(( s2[8] - s1[8] ))
  pct=$(( total > 0 ? steal * 100 / total : 0 ))
  if [ "$pct" -ge 10 ]; then _a_fail "CPU steal ${pct}% — хостер отдаёт процессор соседям"
  elif [ "$pct" -ge 3 ]; then _a_warn "CPU steal ${pct}%"
  else _a_ok "CPU steal ${pct}%"; fi

  # Время берём из dmesg: journald ставит метку, когда ВМ ожила и сбросила буфер,
  # а не когда ядро зависло. Прошлые загрузки видны только в журнале.
  frz="$(dmesg --time-format iso 2>/dev/null | grep -E "$AUD_FREEZE_RE")"; span="с загрузки"
  if [ -z "$frz" ]; then
    frz="$(journalctl -k --since '-7 days' -o short-iso --no-pager 2>/dev/null | grep -E "$AUD_FREEZE_RE")"; span="за 7 дней"
  fi
  if [ -n "$frz" ]; then
    n="$(printf '%s\n' "$frz" | wc -l)"
    _a_fail "ВМ зависала ${span}: ${n} записей ядра (soft lockup / RCU stall / TX timeout), $(printf '%s\n' "$frz" | head -1 | cut -c1-16 | tr T ' ') … $(printf '%s\n' "$frz" | tail -1 | cut -c1-16 | tr T ' ')"
    _a_hint "это сторона хостера: ВМ не получала CPU или сеть. Повторяется — в поддержку с этими временами."
  else
    _a_ok "Зависаний ВМ за 7 дней не было"
  fi

  n="$(journalctl -k --since '-7 days' --no-pager 2>/dev/null | grep -cE 'Out of memory|oom-kill')"
  if [ "${n:-0}" -gt 0 ]; then _a_fail "OOM за 7 дней: ${n} — не хватает памяти"; fi

  # logrotate разбирается в разделе «Логи» — там видна причина и есть починка.
  failed="$(systemctl --failed --no-legend --plain 2>/dev/null | awk '{print $1}' \
    | grep -vxE 'logrotate\.service|na-logrotate\.service' | paste -sd' ')"
  if [ -n "$failed" ]; then
    _a_fail "Упавшие сервисы: ${failed}"
    for u in $failed; do
      _a_hint "${u}: $(journalctl -u "$u" -b -n 30 --no-pager -o cat 2>/dev/null \
        | grep -vE '^(Starting|Stopping|Stopped|Finished|Failed to start|.*\.service: )' | tail -1 | cut -c1-110)"
    done
  else _a_ok "Упавших сервисов нет"; fi

  # Память, swap и нагрузка: при 1 vCPU и 1–2 ГБ это первое, что даёт задержки в пик.
  read -r mt ma < <(awk '/^MemTotal:/ {t = $2} /^MemAvailable:/ {a = $2} END {print t, a}' /proc/meminfo)
  pct=$(( mt > 0 ? ma * 100 / mt : 100 ))
  if [ "$pct" -lt 10 ]; then _a_fail "Свободно памяти ${pct}% ($(( ma / 1024 )) МБ) — на грани OOM"
  elif [ "$pct" -lt 20 ]; then _a_warn "Свободно памяти ${pct}% ($(( ma / 1024 )) МБ)"
  else _a_ok "Свободно памяти ${pct}% ($(( ma / 1024 )) МБ)"; fi
  # Задержки даёт чтение ИЗ swap (si): процесс ждёт, пока страница вернётся с диска.
  # Вытеснение в swap (so) при свободной памяти — ядро убирает простаивающее, это норма.
  si="$(vmstat 1 4 2>/dev/null | tail -3 | awk '{ s += $7 } END { print int(s / 3) }')"
  if [ "${si:-0}" -ge 10 ]; then
    _a_warn "Идёт чтение из swap (${si} стр./с) — процессы ждут диск, отсюда задержки"
    _a_hint "памяти не хватает: меньше сервисов на ноде или больше RAM"
  fi
  read -r l1 l5 _ < /proc/loadavg
  if awk -v l="$l5" -v n="$(nproc)" 'BEGIN { exit !(l > n) }'; then
    _a_warn "Нагрузка ${l5} при $(nproc) vCPU — процессор не успевает"; _a_hint "смотри top: xray, сжатие логов, соседи (CPU steal)"
  else
    _a_ok "Нагрузка ${l1} / ${l5} (1 и 5 мин) при $(nproc) vCPU"
  fi

  used="$(df --output=pcent / 2>/dev/null | tail -1 | tr -dc 0-9)"
  if [ "${used:-0}" -ge 90 ]; then _a_fail "Диск / заполнен на ${used}%"
  elif [ "${used:-0}" -ge 80 ]; then _a_warn "Диск / заполнен на ${used}%"
  else _a_ok "Диск / заполнен на ${used}%"; fi

  ntp="$(timedatectl show -p NTPSynchronized --value 2>/dev/null)"
  if [ "$ntp" = yes ]; then _a_ok "Часы синхронизированы (NTP)"
  else
    _a_warn "Часы НЕ синхронизированы — TLS и Reality чувствительны ко времени"
    _a_fix "Включить синхронизацию времени (NTP)" 0 _fix_ntp
  fi

  if [ -f /var/run/reboot-required ]; then
    pkgs="$(sort -u /var/run/reboot-required.pkgs 2>/dev/null)"
    # Обновилось штатное generic-ядро, а работает XanMod — перезагрузка его не включит.
    case "$(uname -r)" in
      *generic*) ;;
      *) pkgs="$(printf '%s\n' "$pkgs" | grep -vE '^linux-(image|headers|modules)[^ ]*-generic$|^linux-base$')" ;;
    esac
    if [ -n "$pkgs" ]; then
      pkgs="$(printf '%s\n' "$pkgs" | paste -sd' ' | cut -c1-80)"
      _a_warn "Система ждёт перезагрузки: ${pkgs}"
      _a_fix "Перезагрузить сервер (обновились: ${pkgs})" 2 _fix_reboot
    fi
  fi
}

_audit_network() {
  local cc qd probing ct ctmax pct retr outs rp drops d ctt uin urb dns_srv dns_sum dns_n dns_bad ms
  step "Сеть и MTU"
  cc="$(sysctl -n net.ipv4.tcp_congestion_control 2>/dev/null)"
  qd="$(sysctl -n net.core.default_qdisc 2>/dev/null)"
  if [ "$cc" = bbr ]; then _a_ok "TCP: ${cc} + ${qd}"
  else _a_warn "TCP: ${cc} + ${qd} — для VPN-ноды нужен bbr"; _a_hint "пункт 2) optimize"; fi

  if mtu_probe; then
    if [ "$MTU_PATH" -lt "$MTU_CUR" ]; then
      _a_fail "MTU: ${MTU_IFACE}=${MTU_CUR}, а путь пропускает ${MTU_PATH} — первый большой пакет каждого нового потока теряется"
      _a_fix "Выставить MTU ${MTU_PATH} на ${MTU_IFACE} (сейчас и после ребута)" 0 block_mtu
    else
      _a_ok "MTU: ${MTU_IFACE}=${MTU_CUR}, путь пропускает столько же"
    fi
  else
    _a_warn "MTU: ни одна контрольная точка не ответила на ping — путь не измерен"
  fi

  probing="$(sysctl -n net.ipv4.tcp_mtu_probing 2>/dev/null)"
  if [ "${probing:-0}" -ge 1 ]; then _a_ok "tcp_mtu_probing=${probing} (страховка, если ICMP режут)"
  else _a_warn "tcp_mtu_probing=0 — где режут ICMP, большие потоки могут виснуть"; _a_hint "пункт 2) optimize"; fi

  ct="$(cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null)"
  ctmax="$(cat /proc/sys/net/netfilter/nf_conntrack_max 2>/dev/null)"
  if [ -n "$ct" ] && [ "${ctmax:-0}" -gt 0 ]; then
    pct=$(( ct * 100 / ctmax ))
    if [ "$pct" -ge 80 ]; then _a_fail "conntrack заполнен на ${pct}% (${ct}/${ctmax}) — новые соединения теряются"
    elif [ "$pct" -ge 60 ]; then _a_warn "conntrack заполнен на ${pct}% (${ct}/${ctmax})"
    else _a_ok "conntrack ${pct}% (${ct}/${ctmax})"; fi
    # Потолок меньше 64k: каждый клиент держит десятки соединений — при росте нагрузки
    # таблица кончится, и ядро начнёт молча дропать новые соединения.
    if [ "$ctmax" -lt 65536 ]; then
      _a_warn "Потолок conntrack всего ${ctmax} — при росте числа клиентов новые соединения начнут теряться"
      _a_fix "Поднять потолок conntrack до $(_ct_max_target) (sysctl)" 0 _fix_ct_max
    fi
  fi

  read -r retr outs < <(awk '/^Tcp:/ { if (!h) { for (i = 1; i <= NF; i++) c[$i] = i; h = 1 } else print $c["RetransSegs"], $c["OutSegs"] }' /proc/net/snmp)
  if [ "${outs:-0}" -gt 0 ]; then
    rp="$(awk -v r="$retr" -v o="$outs" 'BEGIN { printf "%.1f", r * 100 / o }')"
    if awk -v p="$rp" 'BEGIN { exit !(p >= 5) }'; then _a_warn "Повторные отправки TCP ${rp}% с загрузки — большие потери до клиентов"
    else _a_ok "Повторные отправки TCP ${rp}% с загрузки"; fi
  fi

  drops=0
  while read -r _ d _; do drops=$(( drops + 16#$d )); done < /proc/net/softnet_stat
  if [ "$drops" -gt 0 ]; then _a_warn "Ядро отбросило ${drops} входящих пакетов (очередь softnet)"; _a_hint "netdev_max_backlog / RPS — пункт 2) optimize"
  else _a_ok "Очередь softnet без потерь"; fi

  # conntrack «забывает» TCP, молчавший дольше таймаута; следующий пакет такого
  # соединения na_filter считает invalid и молча дропает — мессенджер висит.
  ctt="$(cat /proc/sys/net/netfilter/nf_conntrack_tcp_timeout_established 2>/dev/null)"
  if [ -n "$ctt" ]; then
    if [ "$ctt" -lt 3600 ]; then
      _a_fail "conntrack забывает простаивающие TCP через $(( ctt / 60 )) мин — молчащие мессенджеры отваливаются"
      _a_fix "Держать простаивающие TCP в conntrack 2 ч (sysctl)" 0 _fix_ct_timeout
    else
      _a_ok "conntrack держит простаивающие TCP $(( ctt / 3600 )) ч"
    fi
  fi

  # UDP: звонки, видео и игры через VPN. Переполнение приёмного буфера = потери голоса.
  read -r uin urb < <(awk '/^Udp:/ { if (!h) { for (i = 1; i <= NF; i++) c[$i] = i; h = 1 } else print $c["InDatagrams"], $c["RcvbufErrors"] }' /proc/net/snmp)
  if [ "${uin:-0}" -gt 0 ]; then
    if [ $(( urb * 1000 / uin )) -ge 1 ]; then
      _a_warn "UDP теряется на приёме: ${urb} пакетов ($(awk -v a="$urb" -v b="$uin" 'BEGIN { printf "%.2f", a * 100 / b }')%) — рвутся звонки и видео"
      _a_hint "буферы сокетов (rmem_default/rmem_max) — пункт 2) optimize"
    else
      _a_ok "UDP без потерь на приёме"
    fi
  fi

  # IPv6: адрес есть, а маршрута нет — соединения на IPv6-адреса сайтов висят.
  if ip -6 addr show scope global 2>/dev/null | grep -q inet6; then
    if curl -6 -fsS -m 5 -o /dev/null https://www.cloudflare.com/cdn-cgi/trace 2>/dev/null; then
      _a_ok "IPv6 работает"
    else
      _a_fail "IPv6-адрес есть, а в интернет по IPv6 не выйти — соединения на IPv6-адреса сайтов висят"
      _a_fix "Выключить IPv6 на ноде (sysctl, сайты пойдут по IPv4)" 0 _fix_disable_ipv6
    fi
  else
    _a_ok "IPv6 не настроен — задержек от него нет"
  fi

  # DNS: Xray резолвит сайты системным резолвером — медленный DNS = каждый сайт открывается с паузой.
  if command -v resolvectl >/dev/null 2>&1; then
    dns_srv="$(resolvectl status 2>/dev/null | awk -F': ' '/Current DNS Server/ {print $2}' | sort -u | paste -sd' ')"
    dns_sum=0 dns_n=0 dns_bad=""
    for d in $AUD_DNS_NAMES; do
      if ms="$(_dns_ms "$d")"; then dns_sum=$(( dns_sum + ms )); dns_n=$(( dns_n + 1 )); else dns_bad="${dns_bad:+${dns_bad} }${d}"; fi
    done
    if [ -n "$dns_bad" ]; then
      _a_fail "DNS ноды (${dns_srv:-?}) не резолвит: ${dns_bad}"
      _a_fix "Резолвер ноды → 1.1.1.1 и 8.8.8.8" 0 _fix_dns
    elif [ "$dns_n" -gt 0 ] && [ $(( dns_sum / dns_n )) -ge 150 ]; then
      _a_warn "DNS ноды (${dns_srv:-?}) медленный: в среднем $(( dns_sum / dns_n )) мс на запрос — каждый новый сайт ждёт"
      _a_fix "Резолвер ноды → 1.1.1.1 и 8.8.8.8" 0 _fix_dns
    elif [ "$dns_n" -gt 0 ]; then
      _a_ok "DNS ноды (${dns_srv:-?}): в среднем $(( dns_sum / dns_n )) мс без кэша"
    fi
  fi
}

# Задержка, джиттер и потери до опорных точек. До Cloudflare (anycast) из дата-центра
# почти всегда меньше 10 мс — если больше 30, трафик уходит кружным маршрутом.
_audit_routes() {
  local line host name lim out loss avg mdev msg
  step "Маршруты"
  for line in "1.1.1.1|Cloudflare (anycast)|30" "8.8.8.8|Google DNS|" "77.88.8.8|Яндекс (Москва)|"; do
    IFS='|' read -r host name lim <<<"$line"
    out="$(ping -c 20 -i 0.2 -W 2 -q "$host" 2>/dev/null)"
    loss="$(printf '%s\n' "$out" | grep -oE '[0-9.]+% packet loss' | cut -d% -f1)"
    read -r avg mdev < <(printf '%s\n' "$out" | awk -F'[/ ]' '/^(rtt|round-trip)/ {print $8, $10}')
    if [ -z "$avg" ]; then _a_warn "${name}: не отвечает на ping"; continue; fi
    msg="${name}: ${avg} мс, джиттер ${mdev} мс, потери ${loss}%"
    # 20 пакетов: один потерянный (5%) — бывает и от лимита ICMP у цели, три и больше — потери.
    if awk -v l="$loss" 'BEGIN { exit !(l >= 15) }'; then
      _a_fail "$msg"
    elif awk -v l="$loss" 'BEGIN { exit !(l > 0) }'; then
      _a_warn "$msg"
    elif [ -n "$lim" ] && awk -v a="$avg" -v m="$lim" 'BEGIN { exit !(a > m) }'; then
      _a_warn "$msg"
      _a_hint "до ближайшего Cloudflare обычно <10 мс — маршрут кружной, вопрос к хостеру"
    elif awk -v d="$mdev" 'BEGIN { exit !(d > 10) }'; then
      _a_warn "${msg} — сильный джиттер"
    else
      _a_ok "$msg"
    fi
  done
}

# Страна по коду точки Cloudflare (IATA) — где трафик физически входит в сеть.
_cf_colo_country() {
  case "$1" in
    FRA|MUC|DUS|HAM|BER|TXL|STR) echo DE ;;   AMS) echo NL ;;   HEL) echo FI ;;
    ARN|GOT) echo SE ;;   CPH) echo DK ;;   OSL) echo NO ;;   WAW) echo PL ;;   PRG) echo CZ ;;
    VIE) echo AT ;;   ZRH|GVA) echo CH ;;   MXP|FCO|PMO) echo IT ;;   MAD|BCN) echo ES ;;
    CDG|MRS) echo FR ;;   LHR|MAN|EDI) echo GB ;;   DUB) echo IE ;;   BRU) echo BE ;;
    LUX) echo LU ;;   RIX) echo LV ;;   TLL) echo EE ;;   VNO) echo LT ;;   KIV) echo MD ;;
    OTP) echo RO ;;   SOF) echo BG ;;   BUD) echo HU ;;   ATH) echo GR ;;   IST) echo TR ;;
    DME|SVO|LED|SVX|KJA) echo RU ;;   ALA|NQZ) echo KZ ;;   TAS) echo UZ ;;   TBS) echo GE ;;
    EVN) echo AM ;;   DXB|FJR) echo AE ;;   TLV) echo IL ;;   NRT|HND|KIX|FUK|OKA) echo JP ;;
    ICN) echo KR ;;   HKG) echo HK ;;   SIN) echo SG ;;   TPE) echo TW ;;   BOM|DEL|MAA|BLR) echo IN ;;
    SYD|MEL) echo AU ;;   YYZ|YUL|YVR) echo CA ;;   GRU) echo BR ;;
    JFK|EWR|IAD|ORD|DFW|LAX|SJC|SEA|MIA|ATL|DEN|PHX|BOS) echo US ;;
  esac
}

# Страна по GeoIP против физического местоположения (точка Cloudflare).
# Расхождение = сайты видят пользователей ноды «не там»: язык, выдача, гео-блоки.
_audit_geo() {
  local a b trace loc colo cc
  step "GeoIP"
  a="$(curl -fsS -m 6 https://ipinfo.io/country 2>/dev/null | tr -dc 'A-Z')"
  b="$(curl -fsS -m 6 https://api.country.is/ 2>/dev/null | grep -oE '"country":"[A-Z]{2}"' | cut -d'"' -f4)"
  trace="$(curl -fsS -m 6 https://www.cloudflare.com/cdn-cgi/trace 2>/dev/null)"
  loc="$(printf '%s\n' "$trace" | awk -F= '$1 == "loc" {print $2}')"
  colo="$(printf '%s\n' "$trace" | awk -F= '$1 == "colo" {print $2}')"
  cc="$(_cf_colo_country "$colo")"
  info "ipinfo: ${a:-?} · country.is: ${b:-?} · Cloudflare: ${loc:-?} (точка ${colo:-?}${cc:+ = ${cc}})"
  if [ -n "$cc" ] && [ -n "$loc" ] && [ "$loc" != "$cc" ]; then
    _a_warn "Сайты видят сервер в ${loc}, а трафик физически входит в сеть в ${colo} (${cc})"
    _a_hint "язык, выдача и гео-блоки будут как в ${loc}; лечит только хостер (исправить геолокацию IP или выдать другой)"
  elif [ -n "$a" ] && [ -n "$b" ] && [ "$a" != "$b" ]; then
    _a_warn "Базы GeoIP расходятся: ipinfo ${a}, country.is ${b}"
  else
    _a_ok "GeoIP согласован: ${loc:-${a:-?}}"
  fi
}

_audit_firewall() {
  local fired ports lst p open known
  step "Фаервол"
  if [ -f "$FW_ENV" ]; then . "$FW_ENV"; fi   # только читаем: fw_load создал бы файл
  if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -qi '^Status: active'; then
    _a_fail "ufw включён — второй фаервол поверх na_filter: пакет должен пройти оба"
    _a_fix "Выключить ufw (na_filter остаётся единственным фаерволом)" 0 _fix_ufw
  fi

  if nft list table inet na_filter >/dev/null 2>&1; then
    _a_ok "na_filter загружен"
  elif [ -d /etc/node-accelerator ]; then
    _a_fail "na_filter НЕ загружен — ноду не защищает ничего, кроме CrowdSec"
    if [ -s /var/lib/node-accelerator/safety-fired.last ]; then
      fired="$(date -d "@$(cat /var/lib/node-accelerator/safety-fired.last)" '+%F %T' 2>/dev/null)"
      _a_hint "причина: ${fired} сработал сейфти-таймер protect — подтверждения не было, защита снялась сама"
    fi
    _a_fix "Поднять na_filter заново по реестру (в конце спросит, работает ли вход)" 0 apply_firewall
  else
    _a_warn "Фаервол (protect) не ставился"
    _a_fix "Поставить фаервол: node-accelerator protect (спросит порты и IP панели)" 0 block_protect
  fi
  if [ -d /etc/node-accelerator ]; then
    if systemctl is-enabled --quiet na-firewall.service 2>/dev/null; then _a_ok "na-firewall в автозагрузке"
    else
      _a_fail "na-firewall не в автозагрузке — после ребута защиты не будет"
      _a_fix "Поднять na_filter заново по реестру (в конце спросит, работает ли вход)" 0 apply_firewall
    fi
  fi
  if na_safety_armed; then
    _a_warn "Сейфти-таймер взведён — если не снять, na_filter удалится сам"
    _a_fix "Снять сейфти-таймер (сначала спросит, работает ли вход)" 0 fw_confirm_safety
  fi
  if nft list chain inet na_filter input 2>/dev/null | grep -qE 'iifname "wt0" (counter packets [0-9]+ bytes [0-9]+ )?accept'; then
    info "Трафик из netbird (wt0) минует na_filter — это правило вставляет сам netbird; служебные порты держит panel-only"
  fi

  ports="$(_merge_ports "${NODE_PORT:-2222}" "${PANEL_PORTS:-}")"
  if nft list table inet nodeforge_panel_only >/dev/null 2>&1; then
    _a_ok "Порты ${ports} открыты только панели (${PANEL_IPS:-?})"
  else
    _a_fail "Порты ${ports} открыты не только панели (через netbird — всем пирам сети)"
    _a_fix "Порты ${ports} — только для IP панели (подскажет, кто сейчас подключён)" 0 block_panel_only
  fi

  if nft list table inet na_filter >/dev/null 2>&1; then
    _audit_cgnat_limits
    _audit_banned_clients
  fi

  # Без na_filter наружу открыто всё, что слушает; показываем то, чего нет в реестре.
  if ! nft list table inet na_filter >/dev/null 2>&1; then
    open=""
    known=",${SSH_PORT:-$(detect_ssh_port)},$(_merge_ports "${TCP_PORTS:-443}" "${EXTRA_TCP:-}"),"
    lst="$(ss -Hltn 2>/dev/null | awk '{print $4}' | grep -vE '^(127\.|\[::1\]|100\.)' | sed -E 's/.*:([0-9]+)$/\1/' | sort -un)"
    for p in $lst; do
      if [[ "$known" == *",${p},"* ]]; then continue; fi
      if nft list table inet nodeforge_panel_only >/dev/null 2>&1 && [[ ",${ports}," == *",${p},"* ]]; then continue; fi
      open="${open:+${open},}${p}"
    done
    if [ -n "$open" ]; then _a_warn "Без na_filter из интернета доступны TCP-порты вне реестра: ${open}"; fi
  fi
}

# За CGNAT мобильного оператора с одного IP сидят сотни абонентов. na_filter режет
# всё сверх CONN_LIMIT одновременных и SYN_RATE новых соединений в секунду с одного IP —
# и у всех абонентов оператора разом начинаются обрывы.
_audit_cgnat_limits() {
  local conf=/etc/node-accelerator/protect.conf limit syn peak peak_ip syn_src
  limit="${CONN_LIMIT:-$(grep -oE 'CONN_LIMIT:=[0-9]+' "$conf" 2>/dev/null | cut -d= -f2)}"; limit="${limit:-2048}"
  syn="${SYN_RATE:-$(grep -oE 'SYN_RATE:=[0-9]+' "$conf" 2>/dev/null | cut -d= -f2)}"; syn="${syn:-200}"
  read -r peak peak_ip < <(ss -Htn state established '( sport = :443 )' 2>/dev/null \
    | awk '{print $4}' | sed -E 's/^\[?(::ffff:)?//; s/\]?:[0-9]+$//' | sort | uniq -c | sort -rn | head -1)
  syn_src="$(journalctl -k --since '-24 hours' --no-pager 2>/dev/null | grep -F '[na synflood]' | grep -oE 'SRC=[0-9.]+' | sort -u | wc -l)"
  if [ "${peak:-0}" -ge $(( limit * 8 / 10 )) ]; then
    _a_fail "С одного IP (${peak_ip}) ${peak} соединений при лимите ${limit} — абоненты этого оператора упираются в лимит"
    _a_fix "Поднять лимиты na_filter на один IP (соединения и SYN/с)" 0 _fix_na_limits
  elif [ "${peak:-0}" -ge $(( limit / 2 )) ]; then
    _a_warn "С одного IP (${peak_ip}) ${peak} соединений — половина лимита ${limit}"
    _a_fix "Поднять лимиты na_filter на один IP (соединения и SYN/с)" 0 _fix_na_limits
  else
    _a_ok "Пик соединений с одного IP: ${peak:-0} из лимита ${limit}"
  fi
  if [ "${syn_src:-0}" -ge 3 ]; then
    _a_warn "SYN-лимит (${syn}/с на IP) сработал за сутки для ${syn_src} адресов — это могут быть CGNAT операторов"
    _a_fix "Поднять лимиты na_filter на один IP (соединения и SYN/с)" 0 _fix_na_limits
  fi
}

# Баны, под которые попали IP, с которых сегодня реально ходили клиенты: автобан
# na_filter (скан портов одним абонентом банит весь общий IP) и CrowdSec.
_audit_banned_clients() {
  local L=/var/log/remnanode/access.log clients banned hit
  [ -f "$L" ] || return 0
  clients="$(mktemp)"; banned="$(mktemp)"
  tail -n 300000 "$L" | grep ' accepted ' | grep -oE 'from (tcp:|udp:)?([0-9]{1,3}\.){3}[0-9]{1,3}:' \
    | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' | sort -u > "$clients"
  { nft list set inet na_filter autoban_v4 2>/dev/null
    nft list set inet na_filter suspect_v4 2>/dev/null
    nft list table ip crowdsec 2>/dev/null
  } | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' | sort -u > "$banned"
  hit="$(comm -12 "$clients" "$banned" | head -20 | paste -sd,)"
  rm -f "$clients" "$banned"
  if [ -n "$hit" ]; then
    _a_fail "В бане IP, с которых сегодня ходили клиенты: ${hit}"
    _a_hint "за общим IP оператора — много абонентов; бан одного = обрыв у всех"
    _a_fix "Снять баны с IP клиентов (и внести в allowlist CrowdSec)" 0 _fix_unban_clients "$hit"
  else
    _a_ok "Среди забаненных нет IP сегодняшних клиентов"
  fi
}

_audit_logs() {
  local errs lerr big dir_mb keep
  step "Логи"
  # 1) конфиг: dry-run ловит дубли станз и синтаксис
  errs="$(logrotate -d /etc/logrotate.conf 2>&1 | grep -E '^error' | sort -u)"
  if [ -n "$errs" ]; then
    _a_fail "Конфиг logrotate с ошибками — ротация падает на каждом прогоне:"
    printf '%s\n' "$errs" | head -5 | sed 's/^/      /' >&2
    if printf '%s\n' "$errs" | grep -q 'duplicate log entry.*/var/log/remnanode/' && [ -f /etc/logrotate.d/remnanode ]; then
      _a_fix "Забрать /var/log/remnanode у чужой станзы logrotate и прогнать ротацию" 0 _fix_logrotate_dup
    fi
  else
    _a_ok "Конфиг logrotate без ошибок"
  fi

  # 2) параметры сжатия в кавычках: logrotate отдаёт их zstd буквально → «Incorrect parameters»
  if grep -qE '^[[:space:]]*compressoptions[[:space:]]+"' /etc/logrotate.d/remnanode 2>/dev/null; then
    _a_fail "compressoptions в станзе ноды в кавычках — zstd их не понимает, логи не сжимаются и копятся"
    _a_fix "Исправить compressoptions и дожать несжатые логи (в фоне, низкий приоритет)" 0 _fix_logrotate_opts
  fi

  # 3) сама ротация: падает и при чистом конфиге (нет zstd, архив уже есть…)
  if systemctl is-failed --quiet logrotate.service || systemctl is-failed --quiet na-logrotate.service; then
    lerr="$(_logrotate_last_errors)"
    _a_fail "Ротация логов падает${lerr:+:}"
    if [ -n "$lerr" ]; then printf '%s\n' "$lerr" | sed 's/^/      /' >&2; fi
    if ! grep -qE '^[[:space:]]*compressoptions[[:space:]]+"' /etc/logrotate.d/remnanode 2>/dev/null; then
      _a_fix "Прогнать ротацию заново (доставит zstd, если его нет) и показать ошибку" 0 _fix_logrotate_run
    fi
  fi

  # 4) размер: гигантский текущий лог = ротация не срабатывает; много архивов = хранятся вечно
  if [ -d /var/log/remnanode ]; then
    dir_mb="$(du -sm /var/log/remnanode 2>/dev/null | cut -f1)"
    big="$(find /var/log/remnanode -maxdepth 1 -name '*.log' -size +500M 2>/dev/null | head -1)"
    keep="$(awk '$1 == "rotate" {print $2; exit}' /etc/logrotate.d/remnanode 2>/dev/null)"
    if [ -n "$big" ]; then
      _a_fail "${big} — $(du -h "$big" | cut -f1): текущий лог не ротируется"
      _a_fix "Прогнать ротацию заново (доставит zstd, если его нет) и показать ошибку" 0 _fix_logrotate_run
    elif [ "${dir_mb:-0}" -ge 1024 ] && [ "${keep:-0}" -ge 365 ]; then
      _a_warn "Логи ноды $(du -sh /var/log/remnanode | cut -f1) и хранятся бессрочно (rotate ${keep})"
      _a_fix "Ограничить хранение логов ноды (спросит, сколько дней)" 0 _fix_log_retention
    else
      info "/var/log/remnanode: $(du -sh /var/log/remnanode 2>/dev/null | cut -f1)"
    fi
  fi
  info "journald: $(journalctl --disk-usage 2>/dev/null | grep -oE '[0-9.]+[KMGT]' | head -1)"
}

# Панель держит соединение с портом ноды: без него новые ключи и продления на ноду
# не доходят (старые ключи работают — поэтому поломку долго не видно).
_audit_panel_link() {
  local np peers
  np="${NODE_PORT:-$(grep -oE 'NODE_PORT=[0-9]+' "${NODE_DIR}/docker-compose.yml" 2>/dev/null | head -1 | cut -d= -f2)}"
  np="${np:-2222}"
  if command -v netbird >/dev/null 2>&1; then
    if netbird status 2>/dev/null | grep -q 'Management: Connected'; then _a_ok "netbird на связи"
    else
      _a_fail "netbird не подключён к управлению — панель по netbird ноду не видит"
      _a_fix "Перезапустить netbird (панель на пару секунд потеряет ноду; клиенты — нет)" 0 _fix_netbird_restart
    fi
  fi
  peers="$(_panel_peers "$np")"
  if [ -n "$peers" ]; then _a_ok "Панель на связи с нодой (${peers} → порт ${np})"
  else
    _a_fail "К порту ноды ${np} никто не подключён — панель не видит ноду: новые ключи и продления сюда не доходят"
    _a_hint "проверь статус ноды в панели и docker logs ${NODE_CONTAINER}"
  fi
}

# Маскировка Reality: чужой клиент (и зонд DPI) на 443 с нашим SNI должен увидеть
# настоящий сайт — валидный сертификат и страницу. Иначе IP быстро вычисляют.
_audit_camouflage() {
  local f="$1" sni code
  sni="$(awk '$1 == "server_name" && $2 != "_;" { sub(/;$/, "", $2); print $2; exit }' "$f")"
  [ -n "$sni" ] || return 0
  code="$(curl -sS -m 8 -o /dev/null -w '%{http_code}' --resolve "${sni}:443:127.0.0.1" "https://${sni}/" 2>/dev/null)"
  case "$code" in
    2??|3??) _a_ok "Маскировка: https://${sni} на этой ноде отвечает ${code}, сертификат валиден" ;;
    000|"")
      # TLS отвечает, но сертификат не проходит проверку — лечится сертификатом (ниже), не рестартом.
      code="$(curl -ksS -m 8 -o /dev/null -w '%{http_code}' --resolve "${sni}:443:127.0.0.1" "https://${sni}/" 2>/dev/null)"
      case "$code" in
        2??|3??)
          _a_fail "Маскировка: https://${sni} отдаёт сертификат, который не проходит проверку (просрочен или не тот домен)"
          _a_hint "зонд DPI видит «сайт» с битым сертификатом; XHTTP/gRPC через TLS не подключатся — см. «Сертификат» ниже" ;;
        *)
          _a_fail "Маскировка: на 443 с SNI ${sni} TLS не отвечает — снаружи нода не похожа на сайт"
          _a_fix "Перезапустить nginx маскировки (~2 с)" 1 _fix_nginx_restart ;;
      esac ;;
    *) _a_warn "Маскировка: https://${sni} отвечает ${code} — живой сайт отдаёт 200"
       _a_hint "положи страницу в /var/www/html (index.html)" ;;
  esac
}

# Сертификат маскировки и XHTTP/gRPC: срок, что именно отдаёт nginx, и живо ли
# продление (certbot + Cloudflare DNS-01). Глобальный ключ Cloudflare ловим заранее:
# продление с ним падает (9103 Unknown X-Auth-Key), а видно это только в день истечения.
_audit_cert() {
  local cert="$1" name conf ini days live served ngx fix_renew fix_setup
  name="$(basename "$(dirname "$cert")")"
  conf="/etc/letsencrypt/renewal/${name}.conf"
  days="$(_cert_days "$cert")"
  # Всё про сертификат чинит одно действие (cert_maintain): из списка исправлений
  # в него ведёт одна строка, с формулировкой под найденное.
  fix_renew="Сертификат ${name}: продлить и наладить автопродление (спросит токен Cloudflare, если нужен; рестарт nginx ~2 с)"
  fix_setup="Сертификат ${name}: наладить автопродление (токен Cloudflare, хук nginx, таймер) и проверить вхолостую"
  if [ "$days" -lt 0 ]; then
    _a_fail "Сертификат ${name} истёк $(( -days )) дн. назад — маскировка отдаёт просроченный, XHTTP/gRPC через TLS не подключатся"
    _a_fix "$fix_renew" 1 cert_maintain "$cert"
  elif [ "$days" -lt 14 ]; then
    _a_fail "Сертификат ${name} истекает через ${days} дн. — автопродление не сработало"
    _a_fix "$fix_renew" 1 cert_maintain "$cert"
  elif [ "$days" -lt 30 ]; then
    _a_warn "Сертификат ${name} истекает через ${days} дн. (certbot продлевает за 30 дн. — должен был начать)"
    _a_fix "$fix_renew" 1 cert_maintain "$cert"
  else
    _a_ok "Сертификат ${name} действителен ещё ${days} дн."
  fi

  # nginx держит сертификат отдельным файлом по симлинку live/ — после продления
  # без рестарта контейнера он продолжает отдавать старый.
  ngx="$(_nginx_container)"
  if [ -n "$ngx" ]; then
    live="$(openssl x509 -noout -fingerprint -sha256 -in "$cert" 2>/dev/null)"
    served="$(docker exec "$ngx" sh -c 'cat /etc/nginx/ssl/*/fullchain.pem' 2>/dev/null | openssl x509 -noout -fingerprint -sha256 2>/dev/null)"
    if [ -n "$served" ] && [ "$live" != "$served" ] && [ "$days" -ge 0 ]; then
      _a_fail "nginx отдаёт не тот сертификат, что лежит на диске — после продления контейнер не перезапускали"
      _a_fix "Перезапустить nginx маскировки (~2 с)" 1 _fix_nginx_restart
    fi
  fi

  if [ ! -f "$conf" ]; then
    _a_warn "Сертификат ${name} не продлевается на этой ноде (нет ${conf}) — его сюда положили вручную"
    _a_hint "продлевать там, откуда он скопирован, и копировать заново — или выпустить certbot'ом здесь"
    return 0
  fi
  if ! systemctl is-enabled --quiet certbot.timer 2>/dev/null && ! systemctl is-active --quiet certbot.timer 2>/dev/null; then
    _a_warn "Таймер certbot выключен — сертификат сам не продлится"
    _a_fix "$fix_setup" 0 cert_maintain "$cert"
  fi
  ini="$(_cf_ini "$conf")"
  if [ -n "$ini" ] && [ -f "$ini" ] && ! grep -q '^[[:space:]]*dns_cloudflare_api_token' "$ini"; then
    _a_fail "Продление через глобальный ключ Cloudflare (${ini}) — оно падает; нужен API-токен зоны"
    _a_fix "$fix_setup" 0 cert_maintain "$cert"
  fi
  if ! _cert_hook_ok "$conf"; then
    _a_warn "После продления nginx не перезапускается — будет отдавать старый сертификат"
    _a_fix "$fix_setup" 0 cert_maintain "$cert"
  fi
}

# Свежесть образа ноды: сравниваем digest запущенного образа с тегом на Docker Hub.
_audit_node_image() {
  local c="$1" ref repo tag img local_d remote remote_d remote_date created
  ref="$(docker inspect -f '{{.Config.Image}}' "$c" 2>/dev/null)"
  img="$(docker inspect -f '{{.Image}}' "$c" 2>/dev/null)"
  [ -n "$ref" ] && [ -n "$img" ] || return 0
  repo="${ref%%:*}"; tag="${ref#*:}"; [ "$tag" = "$ref" ] && tag=latest
  created="$(docker image inspect -f '{{.Created}}' "$img" 2>/dev/null | cut -c1-10)"
  local_d="$(docker image inspect -f '{{join .RepoDigests " "}}' "$img" 2>/dev/null | grep -oE 'sha256:[0-9a-f]+' | head -1)"
  remote="$(curl -fsS -m 8 "https://hub.docker.com/v2/repositories/${repo}/tags/${tag}" 2>/dev/null)"
  remote_d="$(printf '%s' "$remote" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("digest") or "")' 2>/dev/null)"
  remote_date="$(printf '%s' "$remote" | python3 -c 'import json,sys; print((json.load(sys.stdin).get("last_updated") or "")[:10])' 2>/dev/null)"
  if [ -z "$remote_d" ] || [ -z "$local_d" ]; then
    info "Образ ноды ${ref} от ${created:-?} (сверить с Docker Hub не удалось)"
  elif [ "$remote_d" != "$local_d" ]; then
    _a_warn "Есть новая версия ноды: ${ref} от ${remote_date}, у тебя сборка от ${created}"
    _a_fix "Обновить ноду до свежего ${ref} (pull + пересоздание, обрыв ~10 с)" 1 _fix_node_update
  else
    _a_ok "Образ ноды актуален: ${ref} от ${created}"
  fi
}

# Xray за последний час: доля отказов и частые ошибки — где именно рвётся.
_audit_xray_log() {
  local L=/var/log/remnanode/access.log E=/var/log/remnanode/error.log since tmp acc rej top
  [ -f "$L" ] || return 0
  since="$(date -u -d '-1 hour' '+%Y/%m/%d %H:%M')"   # Xray пишет время в UTC
  tmp="$(mktemp)"
  tail -n 400000 "$L" | awk -v t="$since" '($1 " " substr($2, 1, 5)) >= t' > "$tmp"
  acc="$(grep -c ' accepted ' "$tmp")"; rej="$(grep -c ' rejected ' "$tmp")"
  top="$(grep ' rejected ' "$tmp" | sed -E 's/.* rejected +//; s/([0-9]{1,3}\.){3}[0-9]{1,3}(:[0-9]+)?/IP/g; s/[0-9a-f-]{36}/UUID/g' \
    | cut -c1-70 | sort | uniq -c | sort -rn | head -3 | sed -E 's/^ *//')"
  rm -f "$tmp"
  if [ $(( acc + rej )) -eq 0 ]; then info "Xray за час: соединений нет"
  elif [ $(( rej * 100 / (acc + rej) )) -ge 5 ]; then
    _a_warn "Xray за час: принято ${acc}, отклонено ${rej} ($(( rej * 100 / (acc + rej) ))%)"
    printf '%s\n' "$top" | sed 's/^/      /' >&2
    _a_hint "invalid request user id — удалённые/просроченные ключи или сканеры; остальное — смотри текст"
  else
    _a_ok "Xray за час: принято ${acc}, отклонено ${rej}"
  fi
  if [ -s "$E" ]; then
    rej="$(awk -v t="$since" '($1 " " substr($2, 1, 5)) >= t' "$E" | wc -l)"
    if [ "$rej" -ge 50 ]; then
      _a_warn "error.log Xray за час: ${rej} записей, чаще всего:"
      awk -v t="$since" '($1 " " substr($2, 1, 5)) >= t' "$E" | cut -d' ' -f3- \
        | sed -E 's/([0-9]{1,3}\.){3}[0-9]{1,3}(:[0-9]+)?/IP/g; s/[0-9]+/N/g' | cut -c1-90 \
        | sort | uniq -c | sort -rn | head -3 | sed -E 's/^ */      /' >&2
    fi
  fi
}

_audit_node() {
  local ctr c st s rc started age f sock cert img sni want
  step "Нода"
  if ! require_node >/dev/null 2>&1; then info "Нода (remnanode) не установлена — пропускаю."; return 0; fi

  ctr="$(docker ps -a --format '{{.Names}}' 2>/dev/null | grep -E "(^|_)${NODE_CONTAINER}\$" | head -1)"
  if [ -n "$ctr" ] && [ "$ctr" != "$NODE_CONTAINER" ]; then
    _a_warn "Контейнер ноды называется «${ctr}», а не «${NODE_CONTAINER}» — compose не довёл пересоздание до переименования"
    _a_hint "всё, что обращается к ноде по имени (cron update-geo.sh, RU-блокировка, SNI), тут падает"
    _a_fix "Переименовать контейнер ${ctr} → ${NODE_CONTAINER} (без перезапуска)" 0 _fix_node_rename "$ctr"
  fi
  for c in "${ctr:-$NODE_CONTAINER}" remnawave-nginx; do
    st="$(docker inspect -f '{{.State.Status}} {{.RestartCount}} {{.State.StartedAt}}' "$c" 2>/dev/null)"
    if [ -z "$st" ]; then _a_fail "Контейнер ${c} не найден"; continue; fi
    read -r s rc started <<<"$st"
    if [ "$s" != running ]; then _a_fail "Контейнер ${c}: ${s}"
    else _a_ok "Контейнер ${c} работает с $(date -d "$started" '+%F %H:%M' 2>/dev/null) (перезапусков: ${rc})"; fi
  done

  _audit_panel_link
  _audit_node_image "${ctr:-$NODE_CONTAINER}"

  if pgrep -x rw-core >/dev/null; then
    age="$(ps -o etimes= -p "$(pgrep -xo rw-core)" | tr -d ' ')"
    info "Xray (rw-core) работает $(( age / 3600 )) ч — перезапускается и при смене профиля в панели"
    _audit_xray_log
  else
    _a_fail "Xray (rw-core) не запущен — нода не обслуживает клиентов"
    _a_fix "Поднять стек ноды по compose (docker compose up -d)" 1 _fix_node_recreate
  fi

  f="${NODE_DIR}/nginx.conf"
  if [ -f "$f" ]; then
    if grep -q 'nginx.sock' "$f"; then
      if [ -S /dev/shm/nginx.sock ]; then _a_ok "Фолбэк Reality → nginx.sock на месте"
      else _a_fail "Reality отдаёт фолбэк в /dev/shm/nginx.sock, а сокета нет — маскировка сломана"; fi
      _audit_camouflage "$f"
    fi
    while read -r sock; do
      if [ -S "$sock" ]; then _a_ok "nginx → ${sock}: инбаунд слушает"
      else
        # Не предупреждение: location часто оставляют заготовкой — инбаунд включат
        # в панели, и он подхватится без рестарта nginx.
        info "nginx → ${sock}: инбаунда пока нет — заготовка под будущий инбаунд или лишний location"
        _a_fix "Убрать из nginx.conf location, ведущий в ${sock} (рестарт nginx ~2 с)" 1 _fix_dead_location "$sock"
      fi
    done < <(grep -oE 'unix:/dev/shm/[^;[:space:]]+\.socket' "$f" | sed 's/^unix://' | sort -u)
  fi

  cert="$(grep -oE '/etc/letsencrypt/live/[^:]+/fullchain\.pem' "${NODE_DIR}/docker-compose.yml" 2>/dev/null | head -1)"
  if [ -n "$cert" ] && [ -f "$cert" ]; then _audit_cert "$cert"; fi

  # compose и живой контейнер должны совпадать: иначе правка compose не применена.
  sni="$(NODE_CONTAINER="${ctr:-$NODE_CONTAINER}" node_env_value SNI_VERIFICATION || true)"
  want="$(grep -oE 'SNI_VERIFICATION=[a-z]+' "${NODE_DIR}/docker-compose.yml" 2>/dev/null | head -1 | cut -d= -f2)"
  if [ -n "$want" ] && [ "$sni" != "$want" ]; then
    _a_warn "SNI_VERIFICATION: в compose ${want}, в контейнере ${sni:-не задана} — контейнер не пересоздан"
    _a_fix "Пересоздать контейнер ноды по compose (SNI_VERIFICATION=${want}), обрыв ~10 с" 1 _fix_node_recreate
  else
    info "SNI_VERIFICATION: ${sni:-не задана (по умолчанию false)}"
  fi
  img="$(docker inspect -f '{{.Config.Image}}' remnawave-nginx 2>/dev/null)"
  case "$img" in
    nginx:1.28*)
      _a_warn "nginx ${img#nginx:} — в 1.28 есть CVE"
      _a_fix "Обновить nginx ${img#nginx:} → ${NGINX_TARGET} (пересоздание nginx)" 1 block_nginx_upgrade ;;
  esac
}

# Все проверки заново: счётчики и список исправлений собираются с нуля.
_audit_run() {
  AUD_WARN=0 AUD_FAIL=0
  AUD_FIX_DESC=() AUD_FIX_COST=() AUD_FIX_FN=() AUD_FIX_ARG=() AUD_FIX_STATE=()
  echo
  info "Аудит ноды: проверка только читает, 1–2 минуты (замеры MTU, маршрутов, DNS). Починка — в конце, по выбору."
  _audit_system
  _audit_network
  _audit_routes
  _audit_geo
  _audit_firewall
  _audit_logs
  _audit_node
  echo
  hr
  if [ "$AUD_FAIL" -gt 0 ]; then err "Итог: проблем ${AUD_FAIL}, предупреждений ${AUD_WARN}."
  elif [ "$AUD_WARN" -gt 0 ]; then warn "Итог: проблем нет, предупреждений ${AUD_WARN}."
  else ok "Итог: всё в порядке."; fi
}

block_audit() {
  # Только чтение: одна упавшая проверка не должна обрывать весь отчёт.
  set +e
  local AUD_WARN AUD_FAIL
  local -a AUD_FIX_DESC AUD_FIX_COST AUD_FIX_FN AUD_FIX_ARG AUD_FIX_STATE
  _audit_run
  _audit_fix_menu
  return 0
}


# ============================ МЕНЮ ============================
# self_update вызывается НАПРЯМУЮ из меню (не через run_block), чтобы exec
# мог заменить весь процесс на свежую версию.
self_update() {
  echo
  step "Обновление скрипта"
  log "Источник: ${UPDATE_URL}"
 
  local dest="$SELF" tmp
  case "$dest" in
    /dev/fd/*|/proc/*|"") dest="$(pwd)/setup.sh" ;;   # запущено не из файла
  esac
 
  tmp="$(mktemp)"
  if ! curl -fsSL "$UPDATE_URL" -o "$tmp"; then
    err "Не удалось скачать обновление с ${UPDATE_URL}."
    rm -f "$tmp"; return 1
  fi
  if [ ! -s "$tmp" ] || ! head -n1 "$tmp" | grep -q '^#!'; then
    err "Скачанный файл не похож на скрипт (пустой или без shebang) — обновление отменено."
    rm -f "$tmp"; return 1
  fi
  if [ -f "$dest" ] && cmp -s "$tmp" "$dest"; then
    rm -f "$tmp"
    log "У тебя уже последняя версия (${dest})."
    return 0
  fi
 
  cat "$tmp" > "$dest"
  rm -f "$tmp"
  chmod +x "$dest" 2>/dev/null || true
  ok "Скрипт обновлён: ${dest}"
  log "Перезапускаю обновлённую версию..."
  exec bash "$dest"
}
 
# Каждый блок запускается в подоболочке с `set -e`: ошибка останавливает
# только текущий блок, меню продолжает работать.
run_block() {
  local name="$1" fn="$2" rc=0
  echo
  step "$name"
  ( set -eo pipefail; "$fn" )
  rc=$?
  if [ "$rc" -eq 0 ]; then
    ok "${name} — готово."
  else
    err "${name} — прервано (код ${rc}, см. вывод выше)."
  fi
}
 
banner() {
  echo
  printf '%s%s' "$BOLD" "$CYN"
  cat <<'ART'
              _      __
 _ _  ___  __| |___ / _|___ _ _ __ _ ___
| ' \/ _ \/ _` / -_)  _/ _ \ '_/ _` / -_)
|_||_\___/\__,_\___|_| \___/_| \__, \___|
                               |___/
ART
  printf '%s' "$RST"
  printf '   %sharden · configure · remnawave node%s\n' "$GRY" "$RST"
  hr
}
 
print_menu() {
  cat <<EOF
 
${BOLD}${CYN}══════════════════════════════════════════════════════════════${RST}
                     ${BOLD}${WHT}Настройка сервера${RST}
${BOLD}${CYN}══════════════════════════════════════════════════════════════${RST}
 ${BOLD}${MAG}Базовые шаги${RST} ${GRY}(каждый можно запустить отдельно):${RST}
   ${BOLD}${CYN} 1)${RST} SSH-харденинг   ${GRY}— порт + пользователь + sudo + ключи + запрет root${RST}
   ${BOLD}${GRN} 2)${RST} ${WHT}optimize${RST} ${GRN}★${RST}      ${GRY}— node-accelerator: ядро XanMod BBRv3 + тюнинг + swap${RST}
   ${BOLD}${GRN} 3)${RST} ${WHT}protect${RST}         ${GRY}— node-accelerator: nftables + CrowdSec (фаервол)${RST}
   ${BOLD}${CYN} 4)${RST} netbird         ${GRY}— mesh VPN${RST}
   ${BOLD}${CYN} 5)${RST} remnanode       ${GRY}— нода (интерактивный установщик)${RST}
 
 ${BOLD}${MAG}Настройка ноды${RST}${GRY}:${RST}
   ${BOLD}${CYN} 6)${RST} RU-блокировка   ${GRY}— RU geoip/geosite + bind-mount + cron${RST}
   ${BOLD}${CYN} 7)${RST} Логи ноды       ${GRY}— logrotate + zstd${RST}
   ${BOLD}${CYN} 8)${RST} XHTTP           ${GRY}— location в nginx${RST}
   ${BOLD}${GRN} r)${RST} gRPC            ${GRY}— location в nginx (сокет xrgrpc)${RST}
   ${BOLD}${CYN} 9)${RST} nginx 1.28 → ${WHT}${NGINX_TARGET}${RST}  ${GRY}— проверит версию и спросит${RST}
   ${BOLD}${CYN}10)${RST} Перезапуск контейнеров  ${GRY}— стек ноды или все на хосте${RST}
 
 ${BOLD}${MAG}Мониторинг (Beszel)${RST}${GRY}:${RST}
   ${BOLD}${CYN}11)${RST} Подключить агент к хабу  ${GRY}— установка beszel-agent${RST}
   ${BOLD}${CYN}12)${RST} Обновить Beszel  ${GRY}(агент и/или хаб)${RST}
 
 ${BOLD}${MAG}Диагностика / сервис${RST}${GRY}:${RST}
   ${BOLD}${GRN} a)${RST} ${WHT}Аудит ноды${RST} ${GRN}★${RST}   ${GRY}— проверка MTU, фризов ВМ, GeoIP, фаервола, логов + починка по выбору${RST}
   ${BOLD}${CYN}13)${RST} Диагностика     ${GRY}— выбор: аудит / node-diagnostic / node-accelerator${RST}
   ${BOLD}${CYN}14)${RST} Проверки и бенчмарки  ${GRY}(IP/регион/DPI/скорость/CPU…)${RST}
   ${BOLD}${CYN}15)${RST} Обновить скрипт  ${GRY}(свежая версия с GitHub + перезапуск)${RST}
 
 ${BOLD}${MAG}Дополнительно (опционально)${RST}${GRY}:${RST}
   ${BOLD}${GRN} p)${RST} Порты              ${GRY}— показать активные + добавить/убрать/применить${RST}
   ${BOLD}${GRN} f)${RST} Починить фаервол   ${GRY}— открыть все порты из реестра разом${RST}
   ${BOLD}${GRN} k)${RST} Порты для панели   ${GRY}— порт ноды и beszel только с IP панели${RST}
   ${BOLD}${GRN} m)${RST} MTU                ${GRY}— замерить путь и выставить MTU интерфейса${RST}
   ${BOLD}${GRN} c)${RST} Сертификат ноды    ${GRY}— продлить, сменить токен Cloudflare, наладить автопродление${RST}
   ${BOLD}${GRN} s)${RST} Шейпер скорости    ${GRY}— лимиты на уровне ноды${RST}
   ${BOLD}${GRN} g)${RST} Блок РФ-госсетей   ${GRY}— прятать ноду от зондов госсетей${RST}
   ${BOLD}${GRN} n)${RST} SSH-уведомления    ${GRY}— Telegram при входе по SSH${RST}
   ${BOLD}${GRN} b)${RST} Бэкап конфигов     ${GRY}— один архив со всеми настройками${RST}
   ${BOLD}${GRN} u)${RST} Обновить списки    ${GRY}— геолисты/блоклисты/госсети + автообновление${RST}
   ${BOLD}${GRN} w)${RST} netbird: обновить  ${GRY}— apt-обновление демона до последней версии${RST}
   ${BOLD}${GRN} l)${RST} Fleet-sync         ${GRY}— ноды флота whitelist-ят друг друга${RST}
   ${BOLD}${GRN} v)${RST} SNI-проверка ноды  ${GRY}— mTLS панель→нода: SNI_VERIFICATION вкл/выкл (node ≥ 3.4)${RST}
 
 ${BOLD}${MAG}Группы${RST} ${GRY}(несколько шагов сразу, в правильном порядке):${RST}
   ${BOLD}${YLW}16)${RST} ① До ребута       ${GRY}(1 + 2)  → потом reboot${RST}
   ${BOLD}${YLW}17)${RST} ② Поднять ноду    ${GRY}(4 + 5)${RST}
   ${BOLD}${YLW}18)${RST} ③ Настроить ноду  ${GRY}(6 + 7 + 8)${RST}
   ${BOLD}${YLW}19)${RST} ④ Защита + Beszel ${GRY}(3 + 11)${RST}
   ${BOLD}${RED} 0)${RST} ${RED}Выход${RST}
${GRY}──────────────────────────────────────────────────────────────${RST}
 ${DIM}Чистая нода по шагам:  16 → reboot → 17 → 18 → 19 → m → a.  Можно несколько номеров через пробел.${RST}
EOF
}
 
menu() {
  local choice c
  while true; do
    print_menu
    read -rp "Выбор: " choice
    [ -z "$choice" ] && continue
    for c in $choice; do
      case "$c" in
        1) run_block "SSH-харденинг" block_ssh ;;
        2) run_block "Оптимизация (node-accelerator)" block_optimize ;;
        3) run_block "Защита (node-accelerator)" block_protect ;;
        4) run_block "netbird" block_netbird ;;
        5) run_block "remnanode" block_remnanode ;;
        6) run_block "RU-блокировка" block_rublock ;;
        7) run_block "Логи ноды" block_logs ;;
        8) run_block "XHTTP" block_xhttp ;;
        9) run_block "nginx upgrade" block_nginx_upgrade ;;
        10) run_block "Перезапуск контейнеров" block_restart ;;
        11) run_block "Beszel: агент" block_beszel_agent ;;
        12) run_block "Beszel: обновление" block_beszel_update ;;
        13) submenu_diag ;;
        14) submenu_checks ;;
        15) self_update ;;
        a|A) run_block "Аудит ноды" block_audit ;;
        p|P) block_ports ;;
        f|F) run_block "Починить фаервол" apply_firewall ;;
        k|K) run_block "Порты для панели" block_panel_only ;;
        m|M) run_block "MTU" block_mtu ;;
        c|C) run_block "Сертификат ноды" block_cert ;;
        s|S) run_block "Шейпер" block_shaper ;;
        g|G) run_block "Блок РФ-госсетей" block_govblock ;;
        r|R) run_block "gRPC" block_grpc ;;
        n|N) run_block "SSH-уведомления" block_ssh_notify ;;
        b|B) run_block "Бэкап конфигов" block_backup ;;
        u|U) run_block "Обновить списки сетей" block_update_lists ;;
        w|W) run_block "netbird: обновление" netbird_update ;;
        l|L) run_block "Fleet-sync" block_fleet ;;
        v|V) run_block "SNI-проверка ноды" block_sni_verification ;;
        16) run_block "SSH-харденинг" block_ssh
            run_block "Оптимизация (node-accelerator)" block_optimize ;;
        17) run_block "netbird" block_netbird
            run_block "remnanode" block_remnanode ;;
        18) run_block "RU-блокировка" block_rublock
            run_block "Логи ноды" block_logs
            run_block "XHTTP" block_xhttp ;;
        19) run_block "Защита (node-accelerator)" block_protect
            run_block "Beszel: агент" block_beszel_agent ;;
        0) log "Выход."; exit 0 ;;
        *) warn "Неизвестный пункт: ${c}" ;;
      esac
    done
    echo
    read -rp "Нажмите Enter для возврата в меню..." _
  done
}
 
main() {
  banner
  require_root
  ensure_apt_lock_timeout
  menu
}
 
# Запуск только при прямом вызове (позволяет тестировать через source).
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
  main "$@"
fi
