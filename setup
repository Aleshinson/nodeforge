#!/usr/bin/env bash
#
# setup.sh — интерактивная настройка/харденинг сервера (меню по блокам).
#
# Группировка пунктов — по совместимости в одном проходе:
#
# Запуск:  sudo ./setup.sh   (можно вводить несколько номеров: напр. 1 2)
#
set -o pipefail
 
# Откуда брать свежую версию (raw-ссылка на GitHub). Можно переопределить через env.
UPDATE_URL="${UPDATE_URL:-https://raw.githubusercontent.com/Aleshinson/nodeforge/main/setup}"
# Целевая версия nginx для апгрейда (1.30.1 закрывает CVE из 1.28; 1.30.2 — ещё свежее).
NGINX_TARGET="${NGINX_TARGET:-1.30.1}"
# Ветка/тег репозитория node-accelerator (для прода можно зафиксировать тег: NA_REF=v2.1).
NA_REF="${NA_REF:-main}"
# Путь к самому скрипту (для самообновления).
SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
 
# ----------------------------- ЦВЕТА И ВЫВОД -----------------------------
# Цвета автоматически отключаются, если вывод не в терминал или задан NO_COLOR.
setup_colors() {
  if [ -n "${NO_COLOR:-}" ] || [ ! -t 1 ]; then
    BOLD="" DIM="" RST="" RED="" GRN="" YLW="" BLU="" MAG="" CYN="" GRY="" WHT=""
    return
  fi
  BOLD=$'\033[1m'; DIM=$'\033[2m'; RST=$'\033[0m'
  RED=$'\033[38;5;203m'; GRN=$'\033[38;5;78m';  YLW=$'\033[38;5;221m'
  BLU=$'\033[38;5;75m';  MAG=$'\033[38;5;176m'; CYN=$'\033[38;5;81m'
  GRY=$'\033[38;5;245m'; WHT=$'\033[38;5;231m'
}
setup_colors
 
log()  { printf '%s%s•%s %s\n'  "$BOLD" "$GRN" "$RST" "$*"; }
info() { printf '%s%si%s %s\n'  "$BOLD" "$BLU" "$RST" "$*"; }
ok()   { printf '%s%s✓%s %s\n'  "$BOLD" "$GRN" "$RST" "$*"; }
warn() { printf '%s%s▲%s %s\n'  "$BOLD" "$YLW" "$RST" "$*" >&2; }
err()  { printf '%s%s✗%s %s\n'  "$BOLD" "$RED" "$RST" "$*" >&2; }
step() { printf '%s%s▶ %s%s\n'  "$BOLD" "$CYN" "$*" "$RST"; }
hr()   { printf '%s──────────────────────────────────────────────────────────────%s\n' "$GRY" "$RST"; }
 
require_root() {
  if [ "$(id -u)" -ne 0 ]; then
    err "Запустите через sudo или от root."
    exit 1
  fi
}
 
# ----------------------------- ВВОД И ВАЛИДАЦИЯ -----------------------------
is_uint() { [[ "$1" =~ ^[0-9]+$ ]]; }
 
# ask VAR "Текст" "значение_по_умолчанию"
ask() {
  local __var="$1" __prompt="$2" __def="${3:-}" __ans
  if [ -n "$__def" ]; then
    read -rp "${__prompt} [${__def}]: " __ans
    __ans="${__ans:-$__def}"
  else
    read -rp "${__prompt}: " __ans
  fi
  printf -v "$__var" '%s' "$__ans"
}
 
# ask_required VAR "Текст" — не пускает дальше при пустом вводе
ask_required() {
  local __var="$1" __prompt="$2" __ans=""
  while [ -z "$__ans" ]; do
    read -rp "${__prompt}: " __ans
    if [ -z "$__ans" ]; then warn "Значение не может быть пустым."; fi
  done
  printf -v "$__var" '%s' "$__ans"
}
 
# ask_port VAR — обязательный ввод порта (1-65535), без значения по умолчанию
ask_port() {
  local __var="$1" __ans
  while true; do
    read -rp "SSH-порт (1-65535): " __ans
    if is_uint "$__ans" && [ "$__ans" -ge 1 ] && [ "$__ans" -le 65535 ]; then break; fi
    warn "Введите число от 1 до 65535."
  done
  printf -v "$__var" '%s' "$__ans"
}
 
# ask_username VAR
ask_username() {
  local __var="$1" __ans
  while true; do
    read -rp "Имя нового пользователя: " __ans
    if [[ "$__ans" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; then break; fi
    warn "Некорректное имя (строчные буквы/цифры/_/- , начинается с буквы или _)."
  done
  printf -v "$__var" '%s' "$__ans"
}
 
# ask_password VAR — скрытый ввод, дважды, с проверкой совпадения
ask_password() {
  local __var="$1" __p1 __p2
  while true; do
    read -rsp "Пароль для пользователя (ввод скрыт): " __p1; echo
    if [ -z "$__p1" ]; then warn "Пароль не может быть пустым."; continue; fi
    read -rsp "Повторите пароль: " __p2; echo
    if [ "$__p1" != "$__p2" ]; then warn "Пароли не совпадают, попробуйте снова."; continue; fi
    break
  done
  printf -v "$__var" '%s' "$__p1"
}
 
# confirm "Вопрос" -> 0, если да
confirm() {
  local __ans
  read -rp "$1 [y/N]: " __ans
  [[ "$__ans" =~ ^[YyДд] ]]
}
 
# valid_pubkey "строка" -> 0, если похоже на публичный SSH-ключ
valid_pubkey() {
  [[ "$1" =~ ^(ssh-rsa|ssh-ed25519|ssh-dss|ecdsa-sha2-[a-z0-9-]+|sk-ssh-ed25519@openssh\.com|sk-ecdsa-sha2-[a-z0-9-]+@openssh\.com)[[:space:]]+ ]]
}
 
# choose_from_list VAR "Заголовок" "значение_по_умолчанию_или_пусто" пункт1 пункт2 ...
# Печатает нумерованное меню, помечает рекомендуемый пункт, читает выбор.
choose_from_list() {
  local __var="$1" __title="$2" __def="$3"; shift 3
  local __items=("$@") __i __sel __defidx=""
  echo "$__title"
  for __i in "${!__items[@]}"; do
    if [ -n "$__def" ] && [ "${__items[$__i]}" = "$__def" ]; then
      printf "  %d) %s   ← рекомендуется\n" "$((__i + 1))" "${__items[$__i]}"
      __defidx="$((__i + 1))"
    else
      printf "  %d) %s\n" "$((__i + 1))" "${__items[$__i]}"
    fi
  done
  local __prompt="Номер"
  if [ -n "$__defidx" ]; then __prompt="Номер [${__defidx}]"; fi
  while true; do
    read -rp "${__prompt}: " __sel
    if [ -z "$__sel" ] && [ -n "$__defidx" ]; then __sel="$__defidx"; fi
    if is_uint "$__sel" && [ "$__sel" -ge 1 ] && [ "$__sel" -le "${#__items[@]}" ]; then break; fi
    warn "Введите число от 1 до ${#__items[@]}."
  done
  printf -v "$__var" '%s' "${__items[$((__sel - 1))]}"
}
 
# ----------------------------- ОБЩИЕ ХЕЛПЕРЫ -----------------------------
ssh_service() {
  if systemctl list-unit-files 2>/dev/null | grep -q '^ssh\.service'; then echo ssh
  elif systemctl list-unit-files 2>/dev/null | grep -q '^sshd\.service'; then echo sshd
  else echo ssh; fi
}
 
# set_sshd_option Key Value — задаёт/раскомментирует директиву в sshd_config
set_sshd_option() {
  local key="$1" val="$2" file="/etc/ssh/sshd_config"
  if grep -qiE "^[[:space:]]*#?[[:space:]]*${key}\b" "$file"; then
    sed -i -E "s|^[[:space:]]*#?[[:space:]]*${key}\b.*|${key} ${val}|I" "$file"
  else
    printf '%s %s\n' "$key" "$val" >> "$file"
  fi
}
 
# Нейтрализуем конфликтующие настройки в /etc/ssh/sshd_config.d/*.conf
disable_conflicting_dropins() {
  shopt -s nullglob
  local f
  for f in /etc/ssh/sshd_config.d/*.conf; do
    sed -i -E 's@^[[:space:]]*(Port|PermitRootLogin|PasswordAuthentication|PubkeyAuthentication)([[:space:]].*)$@# disabled by setup: &@I' "$f"
  done
  shopt -u nullglob
}
 
apply_sshd() {
  if sshd -t; then
    systemctl restart "$(ssh_service)"
    log "SSH перезапущен."#!/usr/bin/env bash
#
# setup.sh — интерактивная настройка/харденинг сервера (меню по блокам).
#
# Группировка пунктов — по совместимости в одном проходе:
#
# Запуск:  sudo ./setup.sh   (можно вводить несколько номеров: напр. 1 2)
#
set -o pipefail
 
# Откуда брать свежую версию (raw-ссылка на GitHub). Можно переопределить через env.
UPDATE_URL="${UPDATE_URL:-https://raw.githubusercontent.com/Aleshinson/nodeforge/main/setup}"
# Целевая версия nginx для апгрейда (1.30.1 закрывает CVE из 1.28; 1.30.2 — ещё свежее).
NGINX_TARGET="${NGINX_TARGET:-1.30.1}"
# Ветка/тег репозитория node-accelerator (для прода можно зафиксировать тег: NA_REF=v2.1).
NA_REF="${NA_REF:-main}"
# Путь к самому скрипту (для самообновления).
SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
 
# ----------------------------- ЦВЕТА И ВЫВОД -----------------------------
# Цвета автоматически отключаются, если вывод не в терминал или задан NO_COLOR.
setup_colors() {
  if [ -n "${NO_COLOR:-}" ] || [ ! -t 1 ]; then
    BOLD="" DIM="" RST="" RED="" GRN="" YLW="" BLU="" MAG="" CYN="" GRY="" WHT=""
    return
  fi
  BOLD=$'\033[1m'; DIM=$'\033[2m'; RST=$'\033[0m'
  RED=$'\033[38;5;203m'; GRN=$'\033[38;5;78m';  YLW=$'\033[38;5;221m'
  BLU=$'\033[38;5;75m';  MAG=$'\033[38;5;176m'; CYN=$'\033[38;5;81m'
  GRY=$'\033[38;5;245m'; WHT=$'\033[38;5;231m'
}
setup_colors
 
log()  { printf '%s%s•%s %s\n'  "$BOLD" "$GRN" "$RST" "$*"; }
info() { printf '%s%si%s %s\n'  "$BOLD" "$BLU" "$RST" "$*"; }
ok()   { printf '%s%s✓%s %s\n'  "$BOLD" "$GRN" "$RST" "$*"; }
warn() { printf '%s%s▲%s %s\n'  "$BOLD" "$YLW" "$RST" "$*" >&2; }
err()  { printf '%s%s✗%s %s\n'  "$BOLD" "$RED" "$RST" "$*" >&2; }
step() { printf '%s%s▶ %s%s\n'  "$BOLD" "$CYN" "$*" "$RST"; }
hr()   { printf '%s──────────────────────────────────────────────────────────────%s\n' "$GRY" "$RST"; }
 
require_root() {
  if [ "$(id -u)" -ne 0 ]; then
    err "Запустите через sudo или от root."
    exit 1
  fi
}
 
