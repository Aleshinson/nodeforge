#!/usr/bin/env bash
# ============================================================================
#  nodeforge — netbird (умное подключение) + единое обновление списков
# ----------------------------------------------------------------------------
#  ЧТО ВНУТРИ:
#   • block_netbird      — ЗАМЕНА старой функции: если netbird уже стоит, не
#                          переустанавливает, а корректно подключает по setup-key
#                          (с переподключением, если уже в сети).
#   • block_update_lists — НОВЫЙ пункт: обновляет ВСЕ списки сетей разом, чинит
#                          пропавшие cron-задания, показывает расписание автообновления.
#
#  КАК ВСТАВИТЬ:
#   1) В своём `setup` УДАЛИ старую функцию block_netbird и вставь новую отсюда.
#   2) block_update_lists добавь рядом с остальными функциями.
#   3) В print_menu (раздел «Диагностика / сервис») добавь строку:
#        echo -e "   ${BOLD}${GRN} u)${RST} Обновить все списки сетей  ${GRY}— геолисты/блоклисты/госсети + проверка автообновления${RST}"
#   4) В menu() в "case" добавь:
#        u|U) run_block "Обновить списки сетей" block_update_lists ;;
#      (ветка для netbird у тебя уже есть — пункт 4 / группа 17.)
# ============================================================================


# ----- netbird: установка ТОЛЬКО если не стоит, иначе сразу подключение -----
block_netbird() {
  local key

  if command -v netbird >/dev/null 2>&1; then
    ok "netbird уже установлен ($(netbird version 2>/dev/null | head -1)). Установку пропускаю."
  else
    log "netbird не найден — устанавливаю."
    wait_for_apt
    if ! curl -fsSL https://pkgs.netbird.io/install.sh | sh; then
      err "Установка netbird не удалась."
      return 1
    fi
    hash -r 2>/dev/null || true   # обновить кэш путей, чтобы команда netbird нашлась сразу
  fi

  if ! command -v netbird >/dev/null 2>&1; then
    err "Команда netbird всё ещё недоступна — проверь установку вручную."
    return 1
  fi

  # Уже подключён? Покажем и спросим про переподключение.
  if netbird status 2>/dev/null | grep -qiE 'Management:[[:space:]]*Connected|Connected to'; then
    info "netbird сейчас ПОДКЛЮЧЁН:"
    netbird status 2>/dev/null | grep -iE 'NetBird IP|Management|Signal|FQDN' | sed 's/^/   /' || true
    if ! confirm "Переподключить с новым setup-key?"; then
      ok "Оставляю текущее подключение без изменений."
      return 0
    fi
  fi

  echo "setup-key вводится здесь и в файле не хранится."
  ask key "netbird setup-key (Enter — подключить позже)" ""
  if [ -z "$key" ]; then
    warn "Ключ не задан. Позже подключишь командой: netbird up --setup-key <KEY>"
    return 0
  fi

  # Если уже в сети — корректно выходим перед повторным up (иначе netbird ругается).
  if netbird status 2>/dev/null | grep -qiE 'Management:[[:space:]]*Connected|Connected to'; then
    log "Отключаюсь перед переподключением (netbird down)."
    netbird down >/dev/null 2>&1 || true
    sleep 1
  fi

  if netbird up --setup-key "$key"; then
    ok "netbird подключён."
    netbird status 2>/dev/null | grep -iE 'NetBird IP|Management|FQDN' | sed 's/^/   /' || true
  else
    err "netbird up не удался. Проверь setup-key и статус: netbird status"
    return 1
  fi
}


# ----- Единое обновление ВСЕХ списков сетей + самолечение автообновления -----
block_update_lists() {
  local did=0
  echo
  step "Обновление всех списков сетей"

  # 1) RU geoip/geosite для Xray (если настроена RU-блокировка)
  if [ -x /opt/remnanode/update-geo.sh ]; then
    log "RU geoip/geosite (Xray)…"
    if /opt/remnanode/update-geo.sh; then ok "RU-списки обновлены."; else warn "RU-списки: ошибка (см. вывод)."; fi
    did=1
  fi

  # 2) Блоклисты node-accelerator (Spamhaus DROP + FireHOL L1 [+ Tor])
  if [ -x /usr/local/sbin/na-blocklist-update ]; then
    log "Блоклисты node-accelerator (Spamhaus/FireHOL)…"
    if /usr/local/sbin/na-blocklist-update >/dev/null 2>&1; then ok "Блоклисты обновлены."; else warn "Блоклисты: ошибка."; fi
    did=1
  fi

  # 3) РФ-госсети (если включён блок госсетей)
  if [ -x /usr/local/sbin/nodeforge-govblock-update ]; then
    log "РФ-госсети…"
    if /usr/local/sbin/nodeforge-govblock-update; then ok "Госсети обновлены."; else warn "Госсети: ошибка."; fi
    did=1
  fi

  [ "$did" -eq 0 ] && warn "Обновляемых списков не найдено (ничего списочного пока не настроено)."

  # --- самолечение cron: если скрипт есть, а задание пропало — вернуть ---
  if [ -x /opt/remnanode/update-geo.sh ] && ! { crontab -l 2>/dev/null | grep -qF 'update-geo.sh'; }; then
    ( crontab -l 2>/dev/null || true; echo '0 4 * * 0 /opt/remnanode/update-geo.sh >> /var/log/geo-update.log 2>&1' ) | crontab -
    log "Восстановил cron для RU-geo (Вс 04:00)."
  fi
  if [ -x /usr/local/sbin/nodeforge-govblock-update ] && ! { crontab -l 2>/dev/null | grep -qF 'nodeforge-govblock-update'; }; then
    ( crontab -l 2>/dev/null || true; echo '17 5 * * * /usr/local/sbin/nodeforge-govblock-update >> /var/log/nodeforge-govblock.log 2>&1' ) | crontab -
    log "Восстановил cron для РФ-госсетей (ежедневно 05:17)."
  fi

  # --- показать, что всё обновляется само ---
  echo
  info "Автообновление (работает само, по расписанию):"
  echo "   ${GRY}— cron-задания:${RST}"
  crontab -l 2>/dev/null | grep -E 'update-geo|govblock' | sed 's/^/      /' || echo "      (нет)"
  echo "   ${GRY}— systemd-таймеры node-accelerator (блоклисты/fleet):${RST}"
  systemctl list-timers --all 2>/dev/null | grep -E 'na-blocklist|na-fleet' | sed 's/^/      /' || echo "      (нет)"
  echo
  ok "Готово."
}
