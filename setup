#!/usr/bin/env bash
#
# setup.sh — интерактивная настройка/харденинг сервера (меню по блокам).
#
# Группировка пунктов — по совместимости в одном проходе:
#
# Запуск:  sudo ./setup.sh   (можно вводить несколько номеров: напр. 1 2)
#
set -o pipefail
 
log()  { printf '\033[1;32m[+]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[!]\033[0m %s\n' "$*" >&2; }
err()  { printf '\033[1;31m[x]\033[0m %s\n' "$*" >&2; }
 
require_root() {
  if [ "$(id -u)" -ne 0 ]; then
    err "Запустите через sudo или от root."
    exit 1
  fi
}
 
# ----------------------------- ВВОД И ВАЛИДАЦИЯ -----------------------------
is_uint() { [[ "$1" =~ ^[0-9]+$ ]]; }
 
# ask VAR "Текст" "значение_по_умолчанию"
ask() {
  local __var="$1" __prompt="$2" __def="${3:-}" __ans
  if [ -n "$__def" ]; then
    read -rp "${__prompt} [${__def}]: " __ans
    __ans="${__ans:-$__def}"
  else
    read -rp "${__prompt}: " __ans
  fi
  printf -v "$__var" '%s' "$__ans"
}
 
# ask_required VAR "Текст" — не пускает дальше при пустом вводе
ask_required() {
  local __var="$1" __prompt="$2" __ans=""
  while [ -z "$__ans" ]; do
    read -rp "${__prompt}: " __ans
    [ -z "$__ans" ] && warn "Значение не может быть пустым."
  done
  printf -v "$__var" '%s' "$__ans"
}
 
# ask_port VAR — обязательный ввод порта (1-65535), без значения по умолчанию
ask_port() {
  local __var="$1" __ans
  while true; do
    read -rp "SSH-порт (1-65535): " __ans
    if is_uint "$__ans" && [ "$__ans" -ge 1 ] && [ "$__ans" -le 65535 ]; then break; fi
    warn "Введите число от 1 до 65535."
  done
  printf -v "$__var" '%s' "$__ans"
}
 
# ask_username VAR
ask_username() {
  local __var="$1" __ans
  while true; do
    read -rp "Имя нового пользователя: " __ans
    if [[ "$__ans" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; then break; fi
    warn "Некорректное имя (строчные буквы/цифры/_/- , начинается с буквы или _)."
  done
  printf -v "$__var" '%s' "$__ans"
}
 
# ask_password VAR — скрытый ввод, дважды, с проверкой совпадения
ask_password() {
  local __var="$1" __p1 __p2
  while true; do
    read -rsp "Пароль для пользователя (ввод скрыт): " __p1; echo
    if [ -z "$__p1" ]; then warn "Пароль не может быть пустым."; continue; fi
    read -rsp "Повторите пароль: " __p2; echo
    if [ "$__p1" != "$__p2" ]; then warn "Пароли не совпадают, попробуйте снова."; continue; fi
    break
  done
  printf -v "$__var" '%s' "$__p1"
}
 
# confirm "Вопрос" -> 0, если да
confirm() {
  local __ans
  read -rp "$1 [y/N]: " __ans
  [[ "$__ans" =~ ^[YyДд] ]]
}
 
# valid_pubkey "строка" -> 0, если похоже на публичный SSH-ключ
valid_pubkey() {
  [[ "$1" =~ ^(ssh-rsa|ssh-ed25519|ssh-dss|ecdsa-sha2-[a-z0-9-]+|sk-ssh-ed25519@openssh\.com|sk-ecdsa-sha2-[a-z0-9-]+@openssh\.com)[[:space:]]+ ]]
}
 
# ----------------------------- ОБЩИЕ ХЕЛПЕРЫ -----------------------------
ssh_service() {
  if systemctl list-unit-files 2>/dev/null | grep -q '^ssh\.service'; then echo ssh
  elif systemctl list-unit-files 2>/dev/null | grep -q '^sshd\.service'; then echo sshd
  else echo ssh; fi
}
 
# set_sshd_option Key Value — задаёт/раскомментирует директиву в sshd_config
set_sshd_option() {
  local key="$1" val="$2" file="/etc/ssh/sshd_config"
  if grep -qiE "^[[:space:]]*#?[[:space:]]*${key}\b" "$file"; then
    sed -i -E "s|^[[:space:]]*#?[[:space:]]*${key}\b.*|${key} ${val}|I" "$file"
  else
    printf '%s %s\n' "$key" "$val" >> "$file"
  fi
}
 
# Нейтрализуем конфликтующие настройки в /etc/ssh/sshd_config.d/*.conf
disable_conflicting_dropins() {
  shopt -s nullglob
  local f
  for f in /etc/ssh/sshd_config.d/*.conf; do
    sed -i -E 's@^[[:space:]]*(Port|PermitRootLogin|PasswordAuthentication|PubkeyAuthentication)([[:space:]].*)$@# disabled by setup: &@I' "$f"
  done
  shopt -u nullglob
}
 
apply_sshd() {
  if sshd -t; then
    systemctl restart "$(ssh_service)"
    log "SSH перезапущен."
  else
    err "sshd -t нашёл ошибку — SSH НЕ перезапущен. Проверьте /etc/ssh/sshd_config."
    return 1
  fi
}
 
# Определяем активный порт SSH из эффективного конфига
detect_ssh_port() {
  local p
  p="$(sshd -T 2>/dev/null | awk '/^port /{print $2; exit}')"
  if [ -z "$p" ]; then
    p="$(grep -rhiE '^[[:space:]]*Port[[:space:]]+[0-9]+' \
          /etc/ssh/sshd_config /etc/ssh/sshd_config.d/ 2>/dev/null \
          | awk '{print $2; exit}')"
  fi
  echo "${p:-22}"
}
 
# ============================ БЛОКИ ============================
 
# ----- 1) SSH-харденинг: порт + пользователь + sudo + ключи + запрет root -----
block_ssh() {
  local port user pass keyinput pubkey
  ask_port port
  ask_username user
  ask_password pass
 
  echo
  echo "Публичный SSH-ключ (содержимое id_rsa.pub):"
  echo "  • вставьте строку ключа, ИЛИ"
  echo "  • укажите путь к .pub файлу, ИЛИ"
  echo "  • нажмите Enter — тогда парольный вход НЕ отключается."
  read -rp "Ключ/путь: " keyinput
  pubkey=""
  if [ -n "$keyinput" ]; then
    if [ -f "$keyinput" ]; then pubkey="$(cat "$keyinput")"; else pubkey="$keyinput"; fi
    if ! valid_pubkey "$pubkey"; then
      warn "Это не похоже на публичный SSH-ключ (ожидается ssh-ed25519 / ssh-rsa / ...)."
      if confirm "Всё равно использовать это значение?"; then :; else
        pubkey=""; warn "Ключ отброшен — парольный вход останется включённым."
      fi
    fi
  fi
 
  # --- сводка перед применением (пароль НЕ печатается) ---
  echo
  echo "Будет применено:"
  echo "  • SSH-порт:          ${port}"
  echo "  • Пользователь:      ${user}  (sudo NOPASSWD)"
  echo "  • Вход root по SSH:  запрещён"
  if [ -n "$pubkey" ]; then
    echo "  • SSH-ключ:          установлен"
    echo "  • Парольный вход:    будет ОТКЛЮЧЁН"
  else
    echo "  • SSH-ключ:          не задан"
    echo "  • Парольный вход:    останется включённым"
  fi
  confirm "Продолжить?" || { warn "Отменено."; return 1; }
 
  # порт
  log "Ставлю SSH-порт ${port}."
  set_sshd_option Port "$port"
  if command -v ufw >/dev/null 2>&1; then
    ufw allow "${port}/tcp" || warn "Не удалось добавить правило ufw."
  else
    warn "ufw не установлен — откройте порт ${port}/tcp вручную."
  fi
 
  # пользователь + sudo
  log "Создаю/настраиваю пользователя ${user}."
  apt-get update -y
  apt-get install -y sudo
  id "$user" >/dev/null 2>&1 || adduser --disabled-password --gecos "" "$user"
  echo "${user}:${pass}" | chpasswd
  usermod -aG sudo "$user"
  printf '%s ALL=(ALL) NOPASSWD: ALL\n' "$user" > "/etc/sudoers.d/90-${user}"
  chmod 440 "/etc/sudoers.d/90-${user}"
  visudo -cf "/etc/sudoers.d/90-${user}" >/dev/null
 
  # запрет root
  set_sshd_option PermitRootLogin no
 
  # ключи
  set_sshd_option PubkeyAuthentication yes
  if [ -n "$pubkey" ]; then
    install -d -m 700 -o "$user" -g "$user" "/home/${user}/.ssh"
    printf '%s\n' "$pubkey" > "/home/${user}/.ssh/authorized_keys"
    chmod 600 "/home/${user}/.ssh/authorized_keys"
    chown "${user}:${user}" "/home/${user}/.ssh/authorized_keys"
    set_sshd_option PasswordAuthentication no
    log "Ключ установлен, парольный вход будет отключён."
  else
    warn "Ключ не задан — парольный вход оставлен включённым."
  fi
 
  disable_conflicting_dropins
  apply_sshd
  echo
  warn "В НОВОМ окне проверьте вход (НЕ закрывая текущую сессию!):"
  warn "    ssh -p ${port} ${user}@<IP_СЕРВЕРА>"
}
 
# ----- 2) fail2ban -----
block_fail2ban() {
  local port bantime
  port="$(detect_ssh_port)"
  ask port "Порт SSH для джейла" "$port"
  ask bantime "bantime (срок бана)" "1w"
 
  log "Устанавливаю fail2ban."
  apt-get update -y
  apt-get install -y fail2ban
  systemctl enable --now fail2ban
  [ -f /etc/fail2ban/jail.local ] || cp /etc/fail2ban/jail.conf /etc/fail2ban/jail.local
  if grep -qE '^[[:space:]]*#?[[:space:]]*bantime[[:space:]]*=' /etc/fail2ban/jail.local; then
    sed -i -E "s|^[[:space:]]*#?[[:space:]]*bantime[[:space:]]*=.*|bantime = ${bantime}|" /etc/fail2ban/jail.local
  else
    printf '\n[DEFAULT]\nbantime = %s\n' "$bantime" >> /etc/fail2ban/jail.local
  fi
  cat > /etc/fail2ban/jail.d/sshd.local <<EOF
[sshd]
enabled = true
port = ${port}
EOF
  systemctl restart fail2ban
  fail2ban-client status sshd || true
  log "fail2ban настроен (порт ${port}, bantime ${bantime})."
}
 
# ----- 3) Ядро XanMod (точка перезагрузки) -----
block_kernel() {
  log "Устанавливаю ядро XanMod."
  apt-get update -y
  apt-get install -y wget gnupg lsb-release gawk
  mkdir -p /etc/apt/keyrings
  wget -qO - https://dl.xanmod.org/archive.key \
    | gpg --batch --yes --dearmor -o /etc/apt/keyrings/xanmod-archive-keyring.gpg
  echo "deb [signed-by=/etc/apt/keyrings/xanmod-archive-keyring.gpg] http://deb.xanmod.org $(lsb_release -sc) main" \
    > /etc/apt/sources.list.d/xanmod-release.list
  apt-get update -y
 
  local level pkg
  level="$(wget -qO - https://dl.xanmod.org/check_x86-64_psabi.sh | awk -f -)"
  log "Поддержка CPU: ${level}"
  if   echo "$level" | grep -q 'x86-64-v4'; then pkg=linux-xanmod-x64v4
  elif echo "$level" | grep -q 'x86-64-v3'; then pkg=linux-xanmod-x64v3
  elif echo "$level" | grep -q 'x86-64-v2'; then pkg=linux-xanmod-x64v2
  else                                           pkg=linux-xanmod-x64v1; fi
  log "Ставлю пакет: ${pkg}"
  apt-get install -y "$pkg"
  echo
  warn "Ядро установлено. ВЫПОЛНИТЕ:  sudo reboot"
  warn "После загрузки проверьте: uname -r — и вернитесь в меню (пункт 4 — BBR)."
}
 
# ----- 4) BBR -----
block_bbr() {
  log "Включаю BBR."
  cat > /etc/sysctl.d/99-bbr.conf <<EOF
net.core.default_qdisc=fq
net.ipv4.tcp_congestion_control=bbr
EOF
  sysctl --system >/dev/null
  local cc
  cc="$(sysctl -n net.ipv4.tcp_congestion_control)"
  if [ "$cc" = "bbr" ]; then
    log "BBR активен."
  else
    warn "Сейчас: ${cc} (ожидался bbr). Нужна перезагрузка на ядре XanMod — проверьте uname -r."
  fi
}
 
# ----- 5) netbird -----
block_netbird() {
  local key
  log "Устанавливаю netbird."
  curl -fsSL https://pkgs.netbird.io/install.sh | sh
  echo "setup-key вводится здесь и в файле не хранится."
  ask key "netbird setup-key (Enter — подключить позже)" ""
  if [ -n "$key" ]; then
    netbird up --setup-key "$key"
    log "netbird подключён."
  else
    warn "Позже подключите: netbird up --setup-key <KEY>"
  fi
}
 
# ----- 6) remnanode -----
block_remnanode() {
  log "Запускаю установщик remnanode (интерактивный — следуйте подсказкам)."
  bash <(curl -Ls https://raw.githubusercontent.com/eGamesAPI/remnawave-reverse-proxy/refs/heads/main/install_remnawave.sh)
 
  mkdir -p /var/log/remnanode
  local f=/opt/remnanode/docker-compose.yml
  if [ ! -f "$f" ]; then
    warn "${f} не найден — пропускаю правку volumes."
    return
  fi
  if grep -qF '/var/log/remnanode:/var/log/remnanode' "$f"; then
    log "Том логов уже прописан."
  elif grep -qE '^[[:space:]]*volumes:' "$f"; then
    sed -i -E '0,/^[[:space:]]*volumes:.*/s##&\n      - "/var/log/remnanode:/var/log/remnanode"#' "$f"
    warn "Добавил том логов в ${f} — ПРОВЕРЬТЕ отступы YAML."
  else
    warn "В ${f} нет секции volumes — добавьте вручную:"
    warn '      volumes:'
    warn '        - "/var/log/remnanode:/var/log/remnanode"'
  fi
  if confirm "Перезапустить remnanode (docker compose down && up -d)?"; then
    ( cd /opt/remnanode && docker compose down && docker compose up -d )
  fi
}
 
# ============================ МЕНЮ ============================
# Каждый блок запускается в подоболочке с `set -e`: ошибка останавливает
# только текущий блок, меню продолжает работать.
run_block() {
  local name="$1" fn="$2"
  echo
  log "▶ ${name}"
  if ( set -eo pipefail; "$fn" ); then
    log "✔ ${name} — готово."
  else
    err "✘ ${name} — прервано (см. вывод выше)."
  fi
}
 
print_menu() {
  cat <<'EOF'
 
══════════════════════════════════════════════════════════════
                     Настройка сервера
══════════════════════════════════════════════════════════════
 ДО перезагрузки (совместимы в одном проходе):
   1) SSH-харденинг  — порт + пользователь + sudo + ключи + запрет root
   2) fail2ban       — защита от брутфорса (берёт текущий порт SSH)
 
 Ядро (точка перезагрузки):
   3) Ядро XanMod    — после установки нужен reboot
 
 ПОСЛЕ перезагрузки:
   4) BBR            — ускорение TCP
   5) netbird        — mesh VPN
   6) remnanode      — нода (интерактивный установщик)
 
 Группы:
   7) Всё ДО ядра      (= 1 + 2)
   8) Всё ПОСЛЕ ребута (= 4 + 5 + 6)
   0) Выход
──────────────────────────────────────────────────────────────
 Можно ввести несколько номеров через пробел, напр.:  1 2
EOF
}
 
menu() {
  local choice c
  while true; do
    print_menu
    read -rp "Выбор: " choice
    [ -z "$choice" ] && continue
    for c in $choice; do
      case "$c" in
        1) run_block "SSH-харденинг" block_ssh ;;
        2) run_block "fail2ban" block_fail2ban ;;
        3) run_block "Ядро XanMod" block_kernel ;;
        4) run_block "BBR" block_bbr ;;
        5) run_block "netbird" block_netbird ;;
        6) run_block "remnanode" block_remnanode ;;
        7) run_block "SSH-харденинг" block_ssh
           run_block "fail2ban" block_fail2ban ;;
        8) run_block "BBR" block_bbr
           run_block "netbird" block_netbird
           run_block "remnanode" block_remnanode ;;
        0) log "Выход."; exit 0 ;;
        *) warn "Неизвестный пункт: ${c}" ;;
      esac
    done
    echo
    read -rp "Нажмите Enter для возврата в меню..." _
  done
}
 
main() {
  require_root
  menu
}
 
# Запуск только при прямом вызове (позволяет тестировать через source).
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
  main "$@"
fi
